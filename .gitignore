# Dependencies
node_modules/

# Script cache (extraction test results)
.cache/

# Build output
dist/
.astro/

# Environment
.env
.env.*
!.env.production
.dev.vars

# Cloudflare
.wrangler/

# Secrets
.infisical.json

# OS
.DS_Store

# User-local MCP config
.mcp.json

# Testing
coverage/

# Performance
.lighthouseci/

# Ephemeral agent worktrees (created by EnterWorktree tool)
.claude/worktrees/

# Claude Code harness session-tracking artifacts
.claude/parallel-isolation-log/
# Per-session markers written by the user-global parallel-isolation SessionStart
# hook and deleted once a worktree is provisioned. Nothing reaps the ones left
# by sessions that ended before provisioning, so they accumulate; three had been
# committed by 2026-07-31, and the untracked one showed in every session's
# gitStatus snapshot as permanent noise.
.claude/parallel-isolation-required-*

# Playwright MCP output (screenshots, console dumps, snapshots)
.playwright-mcp/

# UI drift audit artifacts (regenerated per run, surfaced via CI)
.design/audits/

# Enterprise skill triplet synced from crane-console on every `crane ss` launch
# (see syncVentureSkills in crane-console/packages/crane-mcp/src/cli/launch-lib.ts).
# Source of truth lives in crane-console; tracking here would produce a
# large dirty tree on every canon update.
.claude/commands/
.gemini/commands/
.agents/skills/

# D1 production backups taken before risky migrations. Keep local; do NOT
# commit (contains tenant data). See migrations/rollbacks/README.md.
backups/

# Operator per-customer rendered output (fly.toml etc. with customer slugs
# substituted in). The templates and customer.yaml configs are tracked; the
# rendered artifacts are per-deploy and gitignored.
operator/.rendered/
operator/safety-substrate/logs/

# Python build artifacts (setuptools generates these inside each connector
# package on `pip install -e .`). Track pyproject.toml, never the egg-info.
**/*.egg-info/
__pycache__/
*.py[cod]

# Generated projection SQL (scripts/project-customer-config.ts)
scripts/.generated/
node_modules
.claude/read-log/
.stitch/shadow-firm/

# Sprint-worker completion signal. Each worker writes result.json to its
# worktree root and the orchestrator reads it for success/failure/crash
# detection (.claude/agents/sprint-worker.md, .claude/commands/orchestrate.md).
# It is per-run state, never repo content: while it was tracked, every parallel
# worker's write registered as a dirty tracked file, which tripped the
# worktree-doctor safety gate and blocked automatic orphan cleanup.
/result.json

# A seat's audit_log is SQLite on the Machine's volume, not D1, and the
# connector opens it by the path in CUSTOMER_DB. Run any of that code with the
# variable unset and the literal string becomes the filename, so an empty
# database lands in whatever directory the process started in. One got
# committed that way (ss#2239): a single `audit_log` table, zero rows, nothing
# in the repo referencing it. Ignored so the next unset run leaves a stray file
# rather than a tracked one.
/CUSTOMER_DB

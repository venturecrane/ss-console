#!/bin/bash
# claude (ops shim, first on PATH on smd-ops and every client workspace): Claude
# itself always runs on the Captain's Max login, never on an API key.
#
# smd-ops: the /ss secrets that crane and ss-env inject include a generic
# ANTHROPIC_API_KEY, which Claude Code would otherwise use instead of the login
# (and which disables the claude.ai connectors).
#
# A client workspace: ~/.ops-secrets carries that client's own Anthropic key as
# ANTHROPIC_API_KEY for the chronology and drafting tools. It is removed from
# Claude's own environment and handed back to every command Claude's Bash tool
# runs via CLAUDE_ENV_FILE (probed 2026-10-17: sourced before each command), so
# tools bill the client's key and Claude bills the Max plan.
#
# DISABLE_AUTOUPDATER: the version is pinned by the image (CLAUDE_CODE_VERSION).
# The updater installs into the ops user's npm prefix (~/.npm-global), and that
# copy, first on PATH, ran a session past this shim on 2026-10-19.
envfile=()
[ -f "$HOME/.ops-secrets" ] && envfile=(CLAUDE_ENV_FILE="$HOME/.ops-secrets")
exec env -u ANTHROPIC_API_KEY DISABLE_AUTOUPDATER=1 "${envfile[@]}" /usr/local/bin/claude "$@"

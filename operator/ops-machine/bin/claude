#!/bin/bash
# claude (smd-ops shim, first on PATH): every Claude Code run on the ops machine
# uses the Captain's Max login. The /ss secrets that crane and ss-env inject
# include a generic ANTHROPIC_API_KEY, which Claude Code would otherwise use
# instead of the login (and which disables the claude.ai connectors). Only that
# one variable is removed; the per-seat keys (ANTHROPIC_API_KEY__<SLUG>) that
# Operator scripts read stay in place.
exec env -u ANTHROPIC_API_KEY /usr/local/bin/claude "$@"

#!/bin/bash
# ops-start (client workspace, inside tmux): get the Captain into a working
# Claude session. First time on a new workspace it walks him through the two
# logins that are his (GitHub, then Claude's own /login on first launch) and
# runs ops-bootstrap. A task handed over from a laptop opens with it in hand.
# When Claude exits it leaves a shell, so the tmux window survives.
set -uo pipefail
. "$HOME/.bashrc" 2>/dev/null || true
slug=$(cat /etc/smd-ops-workspace 2>/dev/null || echo "?")
echo "== ops workspace $slug (client documents live here, nowhere else)"

if ! gh auth status >/dev/null 2>&1; then
  echo "First time here: sign in to GitHub (choose GitHub.com, HTTPS, browser)."
  gh auth login -s read:packages,read:org || { echo "GitHub sign-in did not finish; run ops-start again"; exec bash -l; }
fi
if [ ! -d "$HOME/dev/engagements/.git" ] || [ ! -x "$HOME/.venvs/tools/bin/python" ]; then
  echo "Setting up the repos and tools (a few minutes, once)..."
  /opt/ops/bin/ops-bootstrap || { echo "setup failed; see ~/logs/bootstrap.log"; exec bash -l; }
  . "$HOME/.bashrc" 2>/dev/null || true
fi
git -C "$HOME/dev/ss-console" pull -q --ff-only 2>/dev/null || true
git -C "$HOME/dev/engagements" pull -q --ff-only 2>/dev/null || true
cd "$HOME/dev/ss-console" || exit 1

# Remote Control makes this session a peer the laptop sessions can message and
# hear back from (SendMessage), so a handed-over task is not driven by the
# Captain copying text between windows (2026-10-21). The channel carries
# instructions and verdicts; documents stay here (the rule is in the prompt
# below and in the handoff's own contract). --name is what a peer addresses:
# ops-<slug> for a plain session, ops-<slug>-<id> for a handed-over task, so two
# tasks at once never share an address. The laptop opens the conversation (it
# knows the name: ops-handoff prints it); this session replies to the sender.
# The reverse fails: a laptop session's ListAgents name exists only on that
# laptop, and over Remote Control this side sees it under an auto-title
# (proven 2026-10-22).
name="ops-$slug"
# 2026-10-27: SendMessage from a laptop never reached a workspace session (two
# sends to ops-ashton-price-61703 bounced while it ran), so the laptop now types
# into this session's window with `ops-handoff <client> --say`, and the outbox
# file is this side's only way back.
channel="Laptop sessions message you by typing into this session; their messages start with [from the laptop, msg ...]. Act on them like the Captain's own words. You cannot message a laptop session: anything for it goes in your outbox file, appended, never overwritten. Write verdicts, codes and verify IDs only, never record text, names or amounts from client files."

# One handoff, one file, one session. ops-handoff writes each task to its own
# ~/inbox/pending-<stamp>-<id>.md and names it when it opens a window, so two
# laptops handing over at once get two sessions. Until 2026-10-22 every handoff
# appended to one pending.md and the next session took all of them: the Curtis
# chronology hold and an already-finished facilities write arrived together.
# With no argument (a plain `ops` attach), take the oldest waiting task;
# pending.md is still read so a handoff from an older laptop install is not lost.
task="${1:-}"
if [ -z "$task" ]; then
  task=$(ls -tr "$HOME"/inbox/pending*.md 2>/dev/null | head -1)
fi
if [ -n "$task" ] && [ -s "$task" ]; then
  taken="$HOME/inbox/task-$(date -u +%Y%m%dT%H%M%S)-$$.md"
  # mv is the claim: if another window took this file first, there is no task.
  mv "$task" "$taken" 2>/dev/null || { echo "that task was already taken"; exec bash -l; }
  # The laptop that handed the task over reads the outcome back with
  # `ops-handoff <client> --results`. The outbox carries the outcome, never
  # document content: that stays here under ~/work.
  out="$HOME/outbox/$(basename "$taken")"
  mkdir -p "$HOME/outbox"
  # The id ops-handoff put in the file name (pending-<stamp>-<id>.md) names this
  # session, which is the address ops-handoff printed on the laptop.
  id=$(basename "$task" .md | sed -n 's/^pending-[0-9T]*-\([0-9A-Za-z]*\)$/\1/p')
  name="ops-$slug-${id:-$$}"
  contact=" Your session name is $name; the laptop session that handed this over can type messages into this session. When you finish (or stop), the outbox file is how it hears back."
  /opt/ops/bin/claude --name "$name" --remote-control "$name" "A task was handed to this workspace from a laptop session; it is in $taken. Read it, then do it here. Client documents for this work stay on this workspace (under ~/work); only finished deliverables leave, through the seat. When you finish (or stop), write the outcome to $out for the laptop session that handed it over: what you did, what you found (the verdict, not the documents: no quoted record text, no medical detail), and anything still open. A laptop reads that file.$contact $channel"
else
  /opt/ops/bin/claude --name "$name" --remote-control "$name"
fi
exec bash -l

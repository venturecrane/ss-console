#!/bin/bash
# ops-start (client workspace, inside tmux): get the Captain into a working
# Claude session. First time on a new workspace it walks him through the two
# logins that are his (GitHub, then Claude's own /login on first launch) and
# runs ops-bootstrap. A task handed over from a laptop opens with it in hand.
# When Claude exits it leaves a shell, so the tmux window survives.
set -uo pipefail
. "$HOME/.bashrc" 2>/dev/null || true
slug=$(cat /etc/smd-ops-workspace 2>/dev/null || echo "?")
echo "== ops workspace $slug (client documents live here, nowhere else)"

if ! gh auth status >/dev/null 2>&1; then
  echo "First time here: sign in to GitHub (choose GitHub.com, HTTPS, browser)."
  gh auth login -s read:packages,read:org || { echo "GitHub sign-in did not finish; run ops-start again"; exec bash -l; }
fi
if [ ! -d "$HOME/dev/engagements/.git" ] || [ ! -x "$HOME/.venvs/tools/bin/python" ]; then
  echo "Setting up the repos and tools (a few minutes, once)..."
  /opt/ops/bin/ops-bootstrap || { echo "setup failed; see ~/logs/bootstrap.log"; exec bash -l; }
  . "$HOME/.bashrc" 2>/dev/null || true
fi
git -C "$HOME/dev/ss-console" pull -q --ff-only 2>/dev/null || true
git -C "$HOME/dev/engagements" pull -q --ff-only 2>/dev/null || true
cd "$HOME/dev/ss-console" || exit 1

# Remote Control, named ops-<slug>, makes this session a peer the laptop
# sessions can message and hear back from (SendMessage), so a handed-over task
# is not driven by the Captain copying text between windows (2026-10-21). The
# channel carries instructions and verdicts; documents stay here (the rule is
# in the prompt below and in the handoff's own contract).
# --name is what a peer addresses (the docs do not promise the --remote-control
# argument sets it); both carry the same name.
rc=(--name "ops-$slug" --remote-control "ops-$slug")
channel="Laptop sessions can message you over Remote Control and you can reply with SendMessage to the sender's address; send verdicts, codes and verify IDs only, never record text, names or amounts from client files."

task="$HOME/inbox/pending.md"
if [ -s "$task" ]; then
  taken="$HOME/inbox/task-$(date -u +%Y%m%dT%H%M%S).md"
  mv "$task" "$taken"
  # The laptop that handed the task over reads the outcome back with
  # `ops-handoff <client> --results`. The outbox carries the outcome, never
  # document content: that stays here under ~/work.
  out="$HOME/outbox/$(basename "$taken")"
  mkdir -p "$HOME/outbox"
  # The laptop session that handed the task over names itself (ops-handoff
  # --reply-to). This session contacts it, rather than the laptop finding this
  # one: a session started with a task is renamed to an auto-title, so the
  # ops-<slug> name above is not an address a laptop can rely on (2026-10-22).
  reply_to=$(sed -n 's/^Reply-to: \(.*\)$/\1/p' "$taken" | sort -u | paste -sd, -)
  contact=""
  if [ -n "$reply_to" ]; then
    contact=" Before starting, send one SendMessage to each laptop session named in its Reply-to lines ($reply_to): that you have the task, and your own session name from ListAgents. When you finish (or stop), send each of them the verdict and any verify IDs too. If a send fails, carry on; the outbox file is the record."
  fi
  /opt/ops/bin/claude "${rc[@]}" "A task was handed to this workspace from a laptop session; it is in $taken. Read it, then do it here. Client documents for this work stay on this workspace (under ~/work); only finished deliverables leave, through the seat. When you finish (or stop), write the outcome to $out for the laptop session that handed it over: what you did, what you found (the verdict, not the documents: no quoted record text, no medical detail), and anything still open. A laptop reads that file.$contact $channel"
else
  /opt/ops/bin/claude "${rc[@]}"
fi
exec bash -l

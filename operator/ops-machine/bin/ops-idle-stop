#!/bin/bash
# ops-idle-stop (cron, every 10 min, client workspaces only): stop the Machine
# when it has been idle for IDLE_MINUTES, so a workspace costs nothing between
# uses. The volume and everything on it stay; `ops <client>` starts it again.
#
# Busy means ANY of, checked every run:
#   * a tmux client is attached (the Captain is connected);
#   * ANY process runs as ops that is not on the short idle list below (shells,
#     sleep, tmux, cron, this script and its helpers, and Claude Code with its
#     MCP servers waiting at a prompt). An allowlist of IDLE, never a list of
#     busy: the first version listed busy programs and stopped the Machine
#     mid-migration (2026-10-17 20:40Z), because a 546,000-file sha256sum ran
#     for 55 minutes after its tar finished and sha256sum was not on the list.
#     Anything not known to be idle is work;
#   * a lock in ~/locks/ whose pid is alive (ops-job holds one for any command);
#   * the Machine has been up less than IDLE_MINUTES.
# Idle for IDLE_MINUTES straight (state/last-busy older than that) -> write
# state/stop-requested, which the entrypoint turns into a clean exit.
#
# A detached Claude session with nothing running is idle on purpose: the
# conversation survives (claude --resume), the Machine does not keep billing.
set -uo pipefail
IDLE_MINUTES="${IDLE_MINUTES:-60}"
S="$HOME/state"; mkdir -p "$S"
now=$(date +%s)

reason=""
if tmux list-clients 2>/dev/null | grep -q .; then reason="tmux client attached"; fi
if [ -z "$reason" ]; then
  me=$$
  job=$(ps -u "$(id -u)" -o pid=,ppid=,comm=,args= | awk -v me="$me" '
    $1 == me || $2 == me {next}
    $3 ~ /^(bash|sh|dash|sleep|tmux|tmux:|cron|ps|awk|grep|cut|date|cat|tail|tee|less)$/ {next}
    $3 ~ /^(claude|node)$/ && $0 ~ /claude|crane|mcp/ {next}
    {print $1, $3; exit}')
  [ -n "$job" ] && reason="job running: ${job:0:80}"
fi
if [ -z "$reason" ]; then
  for l in "$HOME"/locks/*.lock; do
    [ -f "$l" ] || continue
    pid=$(cat "$l" 2>/dev/null)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then reason="lock $(basename "$l")"; break; fi
    rm -f "$l"
  done
fi
up=$(cut -d. -f1 /proc/uptime 2>/dev/null || echo 0)
[ -z "$reason" ] && [ "$up" -lt $((IDLE_MINUTES * 60)) ] && reason="up ${up}s"

if [ -n "$reason" ]; then
  echo "$now" > "$S/last-busy"
  echo "$(date -u +%FT%TZ) busy: $reason"
  exit 0
fi
last=$(cat "$S/last-busy" 2>/dev/null || echo "$now")
idle=$(( (now - last) / 60 ))
if [ "$idle" -ge "$IDLE_MINUTES" ]; then
  echo "$(date -u +%FT%TZ) idle ${idle}m; requesting stop"
  : > "$S/stop-requested"
else
  echo "$(date -u +%FT%TZ) idle ${idle}m of ${IDLE_MINUTES}"
fi

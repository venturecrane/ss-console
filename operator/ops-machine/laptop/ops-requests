#!/bin/bash
# ops-requests <client> [YYYY-MM-DD]: what a client asked its Operator on one
# day (default today, Phoenix time), in one command and about a minute.
#   ops-requests ap
#   ops-requests ap 2026-11-09
#
# It prints each request the seat received that day (who, subject, what was
# asked, what the Operator replied), every job created or updated that day with
# its state, and a READ CHECK line (total rows, newest row of any date, the day
# before's count) so an empty day cannot be confused with a read that failed.
#
# Why (2026-11-10): this is asked every day, and until now it was a free-text
# task handed to a workspace Claude session that rewrote the query each time.
# It took minutes when everything worked and 20 when the session never
# started. The same question every day is a script, not a session.
#
# The read happens in the client's ops workspace, not here: the workspace holds
# the seat login (~/.ops-secrets), and the laptop holds none for request text.
# The digest script (requests_digest.py, installed beside this file) travels
# with each call, so nothing has to be deployed to the workspace or the seat
# and there is no second copy to go stale. On the seat it runs as the hermes
# user, read-only (fly ssh lands as root; a root-owned file beside a live
# database is the 2026-07-16 incident).
#
# Exit: 0 the read worked (the digest's READ CHECK line came back); 1 anything
# else, with REQUEST CHECK FAILED on the last line. Never 0 without the read.
set -uo pipefail
usage='usage: ops-requests <client> [YYYY-MM-DD]'
[ -n "${1:-}" ] && [ $# -le 2 ] || { echo "$usage"; exit 2; }
client="$1" day="${2:-}"
[ -z "$day" ] || [[ "$day" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || { echo "$usage"; exit 2; }
reg="$HOME/.claude/smd-ops-workspaces.json"
app=$(jq -r --arg a "$client" '.workspaces | to_entries[] | select(.key==$a or (.value.aliases // [] | index($a))) | .value.app' "$reg" 2>/dev/null | head -1)
[ -n "$app" ] || { echo "no workspace called $client"; exit 1; }
here="$(cd "$(dirname "$0")" && pwd)"
digest="$here/requests_digest.py"
[ -s "$digest" ] || { echo "REQUEST CHECK FAILED: $digest is missing (run operator/ops-machine/laptop/install.sh)"; exit 1; }
OPS_WAKE_ONLY=1 "$here/ops" "$client" >/dev/null || { echo "REQUEST CHECK FAILED: could not start or reach $app. Nothing about that day is known."; exit 1; }

py=$(base64 < "$digest" | tr -d '\n')
out=$(printf '%s\n' \
  'set -u; set -a; . "$HOME/.ops-secrets"; set +a' \
  '[ -n "${OPS_SEAT_APP:-}" ] || { echo "REQUEST CHECK FAILED: this workspace names no seat (OPS_SEAT_APP)"; exit 1; }' \
  "printf %s '$py' | base64 -d | fly ssh console -a \"\$OPS_SEAT_APP\" --pty=false -C \"runuser -u hermes -- python3 - $day\" 2>&1" \
  'echo "ops-requests-exit=${PIPESTATUS[2]}"' |
  fly ssh console -a "$app" -u ops --pty=false -C "bash -s" 2>/dev/null | tr -d '\r')
code=$(printf '%s\n' "$out" | sed -n 's/^ops-requests-exit=\([0-9]*\)$/\1/p' | tail -1)
printf '%s\n' "$out" | grep -v -e '^ops-requests-exit=' -e '^Connecting to '
# The digest's own READ CHECK line is the proof the read reached the index. A
# run that ends without one (ssh dropped, python missing, the seat down) is a
# failure whatever exit code came back, and says so.
if [ "${code:-}" = 0 ] && printf '%s\n' "$out" | grep -q '^READ CHECK: '; then
  exit 0
fi
echo "REQUEST CHECK FAILED: the read did not finish on the seat (exit ${code:-none}). This is NOT zero requests."
exit 1

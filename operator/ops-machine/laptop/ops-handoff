#!/bin/bash
# ops-handoff <client> "<task>": hand a task from a laptop session to a client's
# ops workspace, without doing it here. What a laptop agent runs when the
# client-data guard stops it. The task text goes to its own file in the
# workspace's ~/inbox (pending-<stamp>-<id>.md), one per handoff; nothing is
# kept on the laptop.
#
# The workspace session that takes the task is named ops-<slug>-<id> (ops-start
# reads the id off the file name), and this prints that name. The laptop session
# talks to it with `ops-handoff <client> --say <session> "<message>"`, which
# types into that session's window, and reads what it did with --results.
# SendMessage over Remote Control does not reach workspace sessions (two sends
# bounced 2026-10-27), and the workspace cannot address a laptop session at all,
# so the outbox file is its only way back.
#
# The task opens at once in a tmux window on the workspace (a new window of
# "main", or a new "main" after a restart), and this script then reads the
# workspace's process list for the session. It exits 0 only when that session
# is running; otherwise it exits 1 and says nothing is working on the task.
#
# ops-handoff <client> --results: print the outcomes the workspace wrote back
# (~/outbox, newest last), so a laptop session sees what happened without the
# Captain copying it across. Outcomes only; documents never leave ~/work.
# Below the outcomes it prints the newest progress line of each task still
# running (each task is told to write them, see PROGRESS_PREFIX).
set -uo pipefail
usage='usage: ops-handoff <client> "<task>" | ops-handoff <client> --results | ops-handoff <client> --say <session> "<message>"'
# Every task this starts asks its session for progress lines with this prefix,
# and --results reads them back by the same prefix: one constant for both.
PROGRESS_PREFIX='PROGRESS:'
# An argument that looks like a flag is never a task. On 2026-11-19
# `ops-handoff <client> --help` started a real workspace task whose text was
# "--help". So --help/-h print the usage and start nothing, and any other flag
# this script does not know is refused before anything is touched.
case "${1:-}" in
  --help|-h) echo "$usage"; exit 0 ;;
  -*) { echo "unknown flag $1; nothing was started"; echo "$usage"; } >&2; exit 2 ;;
esac
case "${2:-}" in
  --help|-h) echo "$usage"; exit 0 ;;
  --say|--results) ;;
  -*) { echo "unknown flag $2; nothing was started"; echo "$usage"; } >&2; exit 2 ;;
esac
say_to='' say_text=''
if [ "${2:-}" = "--say" ]; then
  [ $# -eq 4 ] && [ -n "$4" ] && [[ "$3" =~ ^ops-[a-z0-9-]+$ ]] || { echo "$usage"; exit 2; }
  say_to="$3" say_text="$4"
else
  [ -n "${1:-}" ] && [ -n "${2:-}" ] && [ $# -eq 2 ] || { echo "$usage"; exit 2; }
fi
client="$1" task="$2"
reg="$HOME/.claude/smd-ops-workspaces.json"
app=$(jq -r --arg a "$client" '.workspaces | to_entries[] | select(.key==$a or (.value.aliases // [] | index($a))) | .value.app' "$reg" | head -1)
[ -n "$app" ] || { echo "no workspace called $client"; exit 1; }
if [ "$task" = "--results" ]; then
  OPS_WAKE_ONLY=1 "$(dirname "$0")/ops" "$client" >/dev/null || exit 1
  # Outcomes first (each task's ~/outbox/*.md, oldest first), then, for each
  # task still going, its newest progress line: a task's progress file is
  # newer than its outcome file, or it has no outcome file yet. Progress goes to
  # its own .progress file, never the .md, because ops-reap-tasks reads an
  # outbox .md as "this task has reported" and may close its window.
  printf '%s\n' \
    "P='$PROGRESS_PREFIX'" \
    'for f in $(ls -tr ~/outbox/*.md 2>/dev/null); do echo "== $(basename "$f")"; cat "$f"; echo; done' \
    'for p in $(ls -tr ~/outbox/*.progress 2>/dev/null); do' \
    '  o="${p%.progress}.md"' \
    '  [ -f "$o" ] && [ ! "$p" -nt "$o" ] && continue' \
    '  l=$(grep -F "$P" "$p" | tail -1)' \
    '  [ -n "$l" ] && echo "== still running $(basename "${p%.progress}"): $l"' \
    'done' |
    fly ssh console -a "$app" -u ops --pty=false -C "sh -s" 2>/dev/null
  exit 0
fi
if [ "$task" = "--say" ]; then
  # ops-handoff <client> --say <session> "<message>": type a message into a
  # running workspace session, as if the Captain had typed it there. This is the
  # laptop-to-workspace channel. SendMessage over Remote Control never reached a
  # workspace session (2026-10-27: ops-ashton-price-61703 was live with
  # --remote-control and absent from the laptop's ListAgents, so two sends
  # bounced and the Captain was handed the job of relaying). The session is
  # found by the --name ops-start gave it, the text is typed literally (newlines
  # flattened, since Enter submits), and delivery is read back from the pane by
  # its id, so "sent" means it is on that session's screen. Only the id count
  # comes back here; the pane can show client text and none of it leaves.
  OPS_WAKE_ONLY=1 "$(dirname "$0")/ops" "$client" >/dev/null || exit 1
  # Read-back matches the short id alone, with all whitespace stripped from the
  # captured screen. On 2026-11-19 sends that HAD arrived were reported as not
  # delivered: Claude Code word-wraps the echoed prompt itself, so the full tag
  # was split across two screen lines, and capture-pane -J joins only tmux's
  # own wraps. The screen is looked at up to OPS_HANDOFF_SAY_TRIES times,
  # OPS_HANDOFF_SAY_PAUSE seconds apart. Three answers, three exit codes: 0 seen
  # (delivered), 1 typed but nowhere in the last 400 lines (lost: send again),
  # 3 no screen came back (delivery unknown: look before resending).
  id="$(date -u +%H%M%S)-$$"
  tag="[from the laptop, msg $id]"
  tries="${OPS_HANDOFF_SAY_TRIES:-3}" pause="${OPS_HANDOFF_SAY_PAUSE:-2}"
  [[ "$tries" =~ ^[1-9][0-9]?$ ]] || tries=3
  [[ "$pause" =~ ^[0-9]+$ ]] || pause=2
  msg=$(printf '%s %s' "$tag" "$say_text" | tr '\r\n' '  ' | base64 | tr -d '\n')
  got=$(printf '%s\n' \
    "s='$say_to'; m=\$(printf %s '$msg' | base64 -d); id='$id'; w=" \
    'for p in $(tmux list-panes -s -t main -F "#{window_index}:#{pane_pid}" 2>/dev/null); do' \
    '  ps -o args= -p "${p#*:}" --ppid "${p#*:}" 2>/dev/null | grep -q -- "--name $s " && w=${p%%:*}' \
    'done' \
    '[ -n "$w" ] || { echo none; exit 0; }' \
    'tmux send-keys -t "main:$w" -l "$m" && sleep 1 && tmux send-keys -t "main:$w" Enter' \
    "n=; for _ in \$(seq 1 $tries); do sleep $pause" \
    '  n=$({ tmux capture-pane -p -J -t "main:$w" -S -400 2>/dev/null | tr -d "[:space:]"; echo; } | grep -cF "$id")' \
    '  [ "${n:-0}" -gt 0 ] 2>/dev/null && break' \
    'done' \
    'echo "$n"' |
    fly ssh console -a "$app" -u ops --pty=false -C "sh -s" 2>/dev/null | tr -d '\r' | tail -1)
  case "$got" in
    none) echo "no running workspace session named $say_to on $app; nothing was sent" >&2; exit 1 ;;
    0) echo "not delivered: typed into $say_to, but message $id is nowhere in the last 400 lines of its screen after $tries looks; it was lost, send it again" >&2; exit 1 ;;
    [1-9]*) echo "delivered to $say_to (message $id read back on its screen). Its outcome lands in its outbox: ops-handoff $client --results"; exit 0 ;;
    *) echo "typed into $say_to but no screen came back from $app to read message $id on; delivery unknown, check its screen before sending again" >&2; exit 3 ;;
  esac
fi
OPS_WAKE_ONLY=1 "$(dirname "$0")/ops" "$client" || exit 1
# Each handoff is its own file, so two handed over at once become two sessions.
# Until 2026-10-22 they appended to one pending.md and the next session took both.
# The id names the workspace session too (ops-start: ops-<slug>-<id>), so the
# laptop knows its address before it opens. ops-<slug> alone is ambiguous once
# two tasks run at once.
id=$$
file="pending-$(date -u +%Y%m%dT%H%M%S)-$id.md"
session="$app-$id"
{
  printf '## Handed over %s from %s\n\n' "$(date -u +%FT%TZ)" "$(hostname -s)"
  printf '%s\n\n' "$task"
  printf '%s\n' "## Progress (standing instruction from ops-handoff)" "" \
    "At each stage of this task, append one line to the file beside your outbox file with the same name ending in .progress instead of .md (your outbox file is named in the prompt you were started with). Each line starts with $PROGRESS_PREFIX and gives the stage name, items done of total where they can be counted, and a finish estimate labelled as an estimate, for example: $PROGRESS_PREFIX reading files, 12 of 40 done, estimate 25 minutes to finish. Counts and stage names only, never record text, names or amounts from client files. The laptop reads the newest line with --results while the task runs."
} | fly ssh console -a "$app" -u ops --pty=false -C "sh -c 'mkdir -p ~/inbox && cat > ~/inbox/$file'" >/dev/null 2>&1
n=$(fly ssh console -a "$app" -u ops -C "sh -c 'wc -c < ~/inbox/$file'" </dev/null 2>/dev/null | tail -1 | tr -d ' \r')
[ "${n:-0}" -gt 0 ] || { echo "handoff did not arrive on $app"; exit 1; }
# A running workspace session never rereads the inbox, so open this task beside
# it now, on this file only. ops-start claims the file by moving it, so this
# window and a later `ops` attach can never both take it. After a restart there
# is no session "main" at all, and until 2026-11-09 a handoff then ran nothing
# (twice: 11-06 and 11-09); it now starts "main" on this task. TERM is set
# because tmux refuses a terminal the image has no terminfo for (ops-attach).
start="/opt/ops/bin/ops-start \$HOME/inbox/$file"
opened=$(fly ssh console -a "$app" -u ops --pty=false \
  -C "sh -c 'export TERM=xterm-256color; if tmux has-session -t main 2>/dev/null; then tmux new-window -t main -n task \"$start\"; else tmux new-session -d -s main -n task \"$start\"; fi && echo opened'" </dev/null 2>/dev/null | tr -d '\r' | tail -1)
# "Handed over" is a claim; a running session is the fact. Until 2026-11-10 this
# script exited 0 with "Tell the Captain: type `ops`" when nothing had started,
# and a laptop session read "Handed over" and waited 16 minutes on a task no one
# was doing. So read the workspace's process list for the session by the name
# ops-start gives it, and fail loudly when it is not there.
running=0
if [ "$opened" = "opened" ]; then
  for _ in $(seq 1 "${OPS_HANDOFF_WAIT:-10}"); do
    running=$(fly ssh console -a "$app" -u ops --pty=false \
      -C "sh -c 'ps -eo args | grep -c \"[c]laude --name $session \"'" </dev/null 2>/dev/null | tr -d '\r' | tail -1)
    [[ "${running:-}" =~ ^[1-9][0-9]*$ ]] && break
    running=0
    sleep "${OPS_HANDOFF_SLEEP:-3}"
  done
fi
if [ "$running" = 0 ]; then
  {
    echo "HANDOFF NOT RUNNING on $app: the task file arrived (~/inbox/$file) but no session named $session started."
    echo "Nothing is working on it. Do not wait for a result."
    echo "It opens when the Captain types \`ops $client\`; before asking him, look at why: fly ssh console -a $app -u ops -C 'tmux ls'."
  } >&2
  exit 1
fi
echo "Handed over to $app and running there (seen in its process list, tmux window \"task\")."
echo "It runs on its own there; the Captain has nothing to do in that terminal unless it stops on a permission."
echo "Its session is $session. Talk to it yourself, never through the Captain: ops-handoff $client --say $session \"<message>\". Its outcome lands in its outbox: ops-handoff $client --results."
exit 0

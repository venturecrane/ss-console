---
import ObligationRow from './ObligationRow.astro'
import type { ObligationRow as Row } from '../../lib/admin/obligations-view'

/**
 * "What we owe" on the admin client page (ADR 0088).
 *
 * Read-only by design. An obligation reaches `verified` only when a recorded
 * reconcile run probed the real surface, so a "mark done" control here would be
 * precisely the self-certified closure the register exists to prevent.
 *
 * `customerSlug` is null for a client with no Operator seat: the register hangs
 * off customer_configs, so such a client has no obligations surface yet and the
 * panel says so plainly rather than implying an empty one means nothing is owed.
 */
interface Props {
  rows: Row[]
  customerSlug: string | null
  sectionLabelClass: string
  linkClass: string
}

const { rows, customerSlug, sectionLabelClass, linkClass } = Astro.props
---

<section class="border-t border-[color:var(--ss-color-text-primary)] pt-4 pb-6">
  <div class="mb-4 flex items-baseline justify-between gap-4">
    <h2 class={sectionLabelClass}>What we owe</h2>
    {
      customerSlug && rows.length > 0 && (
        <a class={linkClass} href={`/admin/obligations?customer=${customerSlug}`}>
          View all
        </a>
      )
    }
  </div>

  {
    !customerSlug ? (
      <p class="text-sm text-[color:var(--ss-color-text-secondary)]">
        The register tracks obligations per Operator seat. This client has no seat.
      </p>
    ) : rows.length === 0 ? (
      <p class="text-sm text-[color:var(--ss-color-text-secondary)]">
        Nothing outstanding for this client.
      </p>
    ) : (
      <ul class="divide-y divide-[color:var(--ss-color-border-subtle)]">
        {rows.map((row) => (
          <ObligationRow row={row} />
        ))}
      </ul>
    )
  }
</section>

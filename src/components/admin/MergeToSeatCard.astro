---
/**
 * The admin Fleet page's "Merge to seat" card: for every merged change, how
 * long it took to reach the last client seat, split into pipeline, held and
 * busy minutes. The numbers come from src/lib/admin/lead-time-summary.ts; this
 * file only renders them. A missing number is said in words, never invented.
 */
import {
  describeArrival,
  type KindSummary,
  type LeadTimeSummary,
  type WeekStats,
} from '../../lib/admin/lead-time-summary'
import { REVIEW_THRESHOLD_PIPELINE_MINUTES } from '../../lib/admin/lead-time'
import type { HoldHistory } from '../../lib/admin/hold-history'
import { phoenixTime, weekLabel, type SeatGroups } from '../../lib/admin/merge-to-seat'

interface Props {
  summary: LeadTimeSummary
  groups: SeatGroups
  holdHistory: HoldHistory
  error: string | null
}

const { summary, groups, holdHistory, error } = Astro.props

const KIND_LABEL: Record<KindSummary['kind'], string> = {
  image: 'Image',
  bundle: 'Jobs bundle',
  skills: 'Skills',
}

function minutes(value: number | null): string {
  return value === null ? 'none measured' : `${value} min`
}

function busyCount(value: number | null): string {
  return value === null ? 'not recorded' : String(value)
}

const holdsSince = holdHistory.since === null ? null : phoenixTime(Date.parse(holdHistory.since))

function weekRows(pick: (k: KindSummary) => WeekStats[]) {
  return summary.kinds.flatMap((k) => pick(k).map((w) => ({ kind: KIND_LABEL[k.kind], w })))
}

const headlineRows = weekRows((k) => k.headlineWeeks)
const untwinnedRows = weekRows((k) => k.untwinnedWeeks)
const seatList = (seats: string[]) => (seats.length === 0 ? 'none' : seats.join(', '))
---

<div
  class="bg-white rounded-[var(--ss-radius-card)] border border-[color:var(--ss-color-border)] p-card"
>
  <h3 class="text-base font-semibold text-[color:var(--ss-color-text-primary)]">Merge to seat</h3>
  <p class="text-sm text-[color:var(--ss-color-text-secondary)] mt-1">
    Minutes from a merged change to the last client seat running it, split into time on hold and
    pipeline time, including any wait on a client job.
  </p>
  {
    error ? (
      <p class="mt-4 text-sm text-[color:var(--ss-color-error)]">
        Could not read the release history, so no merge to seat times are shown. {error}
      </p>
    ) : (
      <>
        <h4 class="mt-4 text-sm font-semibold text-[color:var(--ss-color-text-primary)]">
          Client seats with a release twin ({seatList(groups.twinned)})
        </h4>
        {headlineRows.length === 0 ? (
          <p class="mt-2 text-sm text-[color:var(--ss-color-text-secondary)]">
            No merge recorded in the last 8 weeks.
          </p>
        ) : (
          <div class="overflow-x-auto mt-2">
            <table class="w-full text-sm">
              <thead>
                <tr class="text-left text-xs text-[color:var(--ss-color-text-secondary)] border-b border-[color:var(--ss-color-border)]">
                  <th class="pb-2 font-medium">Week of</th>
                  <th class="pb-2 font-medium">Kind</th>
                  <th class="pb-2 font-medium text-right">Merges</th>
                  <th class="pb-2 font-medium text-right">Median pipeline</th>
                  <th class="pb-2 font-medium text-right">Slow case (p90)</th>
                  <th class="pb-2 font-medium text-right">On hold</th>
                  <th class="pb-2 font-medium text-right">Busy</th>
                  <th class="pb-2 font-medium text-right">
                    Waited on the seat (minutes not recorded)
                  </th>
                  <th class="pb-2 font-medium text-right">Clear</th>
                  <th class="pb-2 font-medium text-right">Not recorded</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[color:var(--ss-color-border-subtle)]">
                {headlineRows.map(({ kind, w }) => (
                  <tr class="text-[color:var(--ss-color-text-secondary)]">
                    <td class="py-2 pr-4">{weekLabel(w.weekStart)}</td>
                    <td class="py-2 pr-4">{kind}</td>
                    <td class="py-2 pr-4 text-right">{w.merges}</td>
                    <td class="py-2 pr-4 text-right text-[color:var(--ss-color-text-primary)]">
                      {minutes(w.medianPipeline)}
                    </td>
                    <td class="py-2 pr-4 text-right">{minutes(w.p90Pipeline)}</td>
                    <td class="py-2 pr-4 text-right">{w.held}</td>
                    <td class="py-2 pr-4 text-right">{busyCount(w.busy)}</td>
                    <td class="py-2 pr-4 text-right">{w.waited}</td>
                    <td class="py-2 pr-4 text-right">{w.clear}</td>
                    <td class="py-2 text-right">{w.unrecorded}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        <h4 class="mt-4 text-sm font-semibold text-[color:var(--ss-color-text-primary)]">
          Client seats without a release twin ({seatList(groups.untwinned)})
        </h4>
        {untwinnedRows.length === 0 ? (
          <p class="mt-2 text-sm text-[color:var(--ss-color-text-secondary)]">
            No merge recorded in the last 8 weeks.
          </p>
        ) : (
          <ul class="mt-2 space-y-1 text-sm text-[color:var(--ss-color-text-secondary)]">
            {untwinnedRows.map(({ kind, w }) => (
              <li>
                Week of {weekLabel(w.weekStart)}, {kind}: median {minutes(w.medianPipeline)}, slow
                case {minutes(w.p90Pipeline)}, {w.held} on hold, busy {busyCount(w.busy)},{' '}
                {w.waited} waited on the seat (minutes not recorded), {w.clear} clear,{' '}
                {w.unrecorded} not recorded
              </li>
            ))}
          </ul>
        )}

        <h4 class="mt-4 text-sm font-semibold text-[color:var(--ss-color-text-primary)]">
          Recent merges
        </h4>
        {summary.recent.length === 0 ? (
          <p class="mt-2 text-sm text-[color:var(--ss-color-text-secondary)]">
            No merge recorded yet.
          </p>
        ) : (
          <div class="overflow-x-auto mt-2">
            <table class="w-full text-sm">
              <thead>
                <tr class="text-left text-xs text-[color:var(--ss-color-text-secondary)] border-b border-[color:var(--ss-color-border)]">
                  <th class="pb-2 font-medium">Merge</th>
                  <th class="pb-2 font-medium">Clock start</th>
                  <th class="pb-2 font-medium">Image</th>
                  <th class="pb-2 font-medium">Jobs bundle</th>
                  <th class="pb-2 font-medium">Skills</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[color:var(--ss-color-border-subtle)]">
                {summary.recent.map((m) => (
                  <tr class="align-top text-[color:var(--ss-color-text-secondary)]">
                    <td class="py-2 pr-4 font-mono text-xs text-[color:var(--ss-color-text-primary)]">
                      {m.shortSha}
                    </td>
                    <td class="py-2 pr-4">
                      {phoenixTime(m.startMs)}
                      {` (from ${m.clockFrom})`}
                    </td>
                    {(['image', 'bundle', 'skills'] as const).map((kind) => {
                      const cell = describeArrival(m.byKind[kind])
                      return (
                        <td class="py-2 pr-4">
                          {cell.text}
                          {cell.marked ? (
                            <span class="block text-xs font-semibold text-[color:var(--ss-color-error)]">
                              Over {REVIEW_THRESHOLD_PIPELINE_MINUTES} min of pipeline (may include
                              a wait on a client job): review
                            </span>
                          ) : null}
                        </td>
                      )
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </>
    )
  }

  <div
    class="mt-4 pt-4 border-t border-[color:var(--ss-color-border-subtle)] space-y-2 text-xs text-[color:var(--ss-color-text-muted)]"
  >
    <p>
      <strong>Measured</strong> per change merged to main and built by CI, to the first finished rollout,
      on the last client seat, of any release that contains it. A release overtaken before a seat took
      it counts nothing there; the newer release that carried the change does. A hand-built or hotfix
      release never counts. A client seat counts for a change only if it had taken a release of that kind
      before the change merged. Image, jobs bundle and skills are measured separately. Weeks are the week
      the change merged, Monday to Sunday, over the last 8 weeks. Times are Phoenix time.
    </p>
    <p>
      <strong>Clock start.</strong> "From queued" is when the merge queue built the merge commit, several
      minutes before the change reached main; the fleet does not record when it reached main yet. "From
      merged" is when it reached main. "From published" is when a bundle or skills change with no image
      of the same commit was published.
    </p>
    {
      holdsSince === null ? (
        <p>
          <strong>Hold time not recorded.</strong> The hold history cannot be trusted right now:{' '}
          {holdHistory.why}. Each change shows its total minutes only, counts as not recorded, and
          is left out of the median and the slow case. On hold counts only changes waiting on a hold
          right now.
        </p>
      ) : (
        <p>
          <strong>Hold time</strong> is recorded from {holdsSince}: every hold placed and lifted
          since then is counted exactly. A change that merged before then shows its total minutes
          only, counts as not recorded, and is left out of the median and the slow case.
        </p>
      )
    }
    <p>
      <strong>Busy.</strong> The fleet does not yet record how long a rollout waited for a client job
      to finish, so busy shows as not recorded and that wait stays inside the pipeline minutes. The review
      mark at {REVIEW_THRESHOLD_PIPELINE_MINUTES} minutes of pipeline time may therefore include a wait
      on a client job. A change whose rollout records show the seat made it wait is counted as "waited
      on the seat", never as clear, and is left out of the clear-case figures. Any hold, even one under
      a minute, makes a change "on hold".
    </p>
    <p>A change whose build was skipped is not listed: it rides the next release built.</p>
  </div>
</div>

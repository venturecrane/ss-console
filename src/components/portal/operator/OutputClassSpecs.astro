---
import OutputClassRules from './OutputClassRules.astro'
import { SPEC_PROPERTIES, type SpecDocument } from '../../../lib/operator/output-class-specs'
import type { Assertions } from '../../../lib/operator/format-assertions'
import type { OutputClasses } from '../../../lib/operator/customer-yaml/types'

/**
 * Output shape — a WINDOW on what has been established, not a door (ADR 0085 §7).
 *
 * WHAT CHANGED, AND WHY. This component used to be the authoring entry: a form
 * of textareas that POSTed to `/api/portal/operator/settings/output-class-specs`.
 * ADR 0085 found that inverted the model it was built to serve. ADR 0083 §4
 * defines authoring as plain speech — a customer authors a property by saying
 * it — and an employee whose firm-level standards can only be shaped through an
 * administrative web form is not the remote worker the client was sold. So
 * establishment moves to the Operator itself, through the channels the firm
 * already uses with it, and this surface contracts to visibility and audit.
 *
 * THE PLUMBING BELOW IT DID NOT MOVE. Server-side hashing, merge-preserve, and
 * read-back verification remain the write seam the mediated establishment path
 * lands on; the vault object this reads is the same object that path writes.
 * The form demoted, the storage stayed (ADR 0085, Consequences).
 *
 * WHAT IS SHOWN. Per declared class, per property: the established body as
 * prose, and — for the format property, where the seat's gate binds — the
 * stored shape rules rendered back in plain English by `describeAssertions`.
 * The prose is preformatted-with-wrapping rather than reflowed, because it was
 * authored conversationally and its line breaks are the author's.
 *
 * NO PROVENANCE IS SHOWN. A stored `SpecBody` is a body, a digest, (for format)
 * rules, and the fields another writer owns, carried opaquely (`carried`: the
 * overlay's `adjustments` and `provenance`, OY-3). This view reads none of the
 * carried fields, so it states no by-whom and no when. Rendering either would
 * mean deriving a client-facing fact from a field never authored as one, which
 * is the Pattern B
 * fabrication this repo treats as P0. The provenance trail lives in D1
 * (`voice-corrections`) and gets its own surface with the corrections queue;
 * absent is the honest display of absent.
 *
 * WHAT IS STILL NOT SHOWN HERE. Which classes exist, and whether each EXPECTS a
 * spec. That declaration is a commitment, so it lives in `customer.yaml` behind
 * a pull request, and this component only ever reads it. An undeclared class has
 * no row, because nothing here iterates the vault's own keys.
 *
 * NO CLASSES DECLARED is an explicit empty state, per
 * docs/style/empty-state-pattern.md. It is a real and ordinary condition (a
 * seat whose engagement has not reached the point of declaring output classes)
 * and it must not be papered over with a specimen class list.
 *
 * UNREADABLE IS NOT ABSENT. A vault object that exists but will not parse holds
 * prose someone authored and we could not display. It gets its own state and its
 * own sentence rather than rendering as a firm that has established nothing.
 */

interface Props {
  /** The `output_classes:` block from the client's own config. */
  declared: OutputClasses
  /** What is currently in the vault, or null when nothing is established yet. */
  current: SpecDocument | null
  /** True when the vault object exists but could not be parsed. */
  unreadable: boolean
}

const { declared, current, unreadable } = Astro.props

const cardClass = 'border-[3px] border-[color:var(--ss-color-text-primary)] p-6 md:p-8'
const eyebrowClass =
  'font-mono text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-secondary)]'
const mutedNoteClass =
  'font-mono text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-muted)]'

/** `work_product` → `Work product`. Mechanical, so no label is invented. */
function classLabel(slug: string): string {
  const spaced = slug.replace(/[_-]+/g, ' ')
  return spaced.charAt(0).toUpperCase() + spaced.slice(1)
}

const PROPERTY_LABEL: Record<(typeof SPEC_PROPERTIES)[number], string> = {
  voice: 'How it should sound',
  format: 'How it should be shaped',
}

/**
 * The rules currently stored for a class's format property, if any.
 *
 * SHOWN ONLY WHERE THEY BIND. The seat's gate reads shape rules only for a
 * class declaring `format_spec: expected`; under any other declaration a stored
 * rule sits in the vault unchecked. Showing it as enforced there would tell a
 * client something is checked while nothing checks it — the failure this whole
 * surface exists to remove — so the reason is said out loud instead.
 */
function storedRules(slug: string): Assertions | null {
  return current?.classes?.[slug]?.format?.assertions ?? null
}

const rows = Object.entries(declared)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([slug, entry]) => {
    const rules = storedRules(slug)
    return {
      slug,
      label: classLabel(slug),
      rulesBind: entry.format_spec === 'expected',
      rules,
      properties: SPEC_PROPERTIES.map((property) => ({
        property,
        label: PROPERTY_LABEL[property],
        expected: entry[`${property}_spec`] === 'expected',
        body: current?.classes?.[slug]?.[property]?.body ?? '',
      })),
    }
  })
---

<section class="mt-10" aria-labelledby="output-shape-heading">
  <h2 id="output-shape-heading" class={`${eyebrowClass} mb-4`}>Output shape</h2>

  {
    unreadable ? (
      <div class="border-[3px] border-[color:var(--ss-color-error)] p-6 md:p-8">
        <p class="m-0 font-body text-body text-[color:var(--ss-color-error)]">
          Your saved output shape could not be read, so it is not shown here. Nothing has changed on
          your Operator.
        </p>
        <p class={`mt-3 mb-0 ${eyebrowClass}`}>Contact SMD</p>
      </div>
    ) : rows.length === 0 ? (
      <div class={cardClass}>
        <p class="m-0 font-body text-body text-[color:var(--ss-color-text-secondary)]">
          No output classes are set up for this Operator yet. When they are, each one appears here.
        </p>
      </div>
    ) : (
      <div class={cardClass}>
        <p class="m-0 font-body text-body text-[color:var(--ss-color-text-secondary)]">
          This page shows what your Operator has been told about how to produce each kind of work.
          To change any of it, tell your Operator. Team access under Settings lists who can see and
          manage it.
        </p>

        {rows.map((row) => (
          <div class="mt-8 border-t-[3px] border-[color:var(--ss-color-text-primary)] pt-6 first-of-type:mt-6">
            <h3 class="m-0 font-body text-section-h font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]">
              {row.label}
            </h3>
            {row.properties.map((prop) => (
              <div class="mt-5">
                <h4 class={eyebrowClass}>{prop.label}</h4>
                {prop.body.length > 0 ? (
                  <p class="mt-1 mb-0 whitespace-pre-wrap break-words font-body text-body text-[color:var(--ss-color-text-primary)]">
                    {prop.body}
                  </p>
                ) : (
                  <p class="mt-1 mb-0 font-body text-body text-[color:var(--ss-color-text-muted)]">
                    Nothing established.
                  </p>
                )}
                <p class={`mt-1 mb-0 ${mutedNoteClass}`}>
                  {prop.expected ? 'Spec expected' : 'No spec expected'}
                </p>
              </div>
            ))}

            <OutputClassRules binds={row.rulesBind} rules={row.rules} />
          </div>
        ))}
      </div>
    )
  }
</section>

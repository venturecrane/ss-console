---
import PortalShell from '../../../../../layouts/PortalShell.astro'
import { getPortalClient } from '../../../../../lib/portal/session'
import {
  getOperatorSubscriptionByInstance,
  listProductRoles,
  type ProductAccess,
} from '../../../../../lib/portal/product-access'
import OperatorHero from '../../../../../components/portal/operator/facets/OperatorHero.astro'
import {
  personaLines,
  resolveOperatorHero,
} from '../../../../../lib/portal/operator/facets/identity/hero'
import {
  resolveAlivenessSignal,
  type AlivenessSignal,
} from '../../../../../lib/portal/operator/aliveness'
import {
  getCustomerConfigBySlug,
  listCustomerConfigsForEntity,
  personaSendAsAddress,
} from '../../../../../lib/portal/customer-config'
import DomainSurface from '../../../../../components/portal/operator/DomainSurface.astro'
import OperatorAuthorityRows from '../../../../../components/portal/operator/facets/OperatorAuthorityRows.astro'
import OperatorWork from '../../../../../components/portal/operator/facets/OperatorWork.astro'
import OperatorPeople from '../../../../../components/portal/operator/facets/OperatorPeople.astro'
import ConnectionRowCard from '../../../../../components/portal/operator/ConnectionRowCard.astro'
import OperatorLimits from '../../../../../components/portal/operator/OperatorLimits.astro'
import OperatorPersonaCard from '../../../../../components/portal/operator/facets/OperatorPersonaCard.astro'
import {
  jobLines,
  resolveOperatorOverview,
} from '../../../../../lib/portal/operator/facets/overview/overview'
import { resolveOperatorWork } from '../../../../../lib/portal/operator/facets/work/work'
import { resolveOperatorPeople } from '../../../../../lib/portal/operator/facets/people/people'
import { resolveOperatorScope } from '../../../../../lib/portal/operator/facets/scope/scope'
import { buildConnectionRows } from '../../../../../lib/portal/operator/connections'
import { parseBusinessHours } from '../../../../../lib/portal/operator/configure'
import { loadTeamRoster, type TeamMember } from '../../../../../lib/portal/operator/team-read'
import { readChangeRequestFlash } from '../../../../../lib/portal/operator/change-request-flash'
import { getOperatorServiceForEntity } from '../../../../../lib/db/services'
import {
  canStartOperatorSubscription,
  operatorMonthlyPriceCents,
  operatorSubscriptionHref,
  type OperatorStartDoor,
} from '../../../../../lib/portal/billing'
import { env } from 'cloudflare:workers'

/**
 * Operator landing — the ONE-PAGER (console blueprint
 * docs/design/operator/05-console-blueprint.md §5, amended 2026-07-15).
 *
 * The landing IS the manual: everything the operator is renders inline, in
 * full, on one page — the complete duties grid, access, people, persona —
 * with a sticky anchor rail for in-page navigation. There are no chapter
 * routes behind it (the old work/ and people/ routes 301 to anchors here).
 * One read page, one act page: learning what the operator is happens here;
 * changing it happens in Settings (plan & billing, user management, and each
 * config domain as it becomes self-serve). Nothing billing-shaped renders on
 * this page.
 *
 * This console is about the OPERATOR itself, not the work it produces (ADR
 * 0052). Every section mounts the same shared facet resolvers/viewers the
 * chapters mounted (Lock 4 — one viewer per facet), so this page can never
 * disagree with the admin mount; the empty-section rule means a section with
 * no authored data is absent, never a hollow door. Each section keeps its
 * inline request-a-change path (§5b).
 */

const PRODUCT_SLUG = 'operator'

const instance = Astro.params.instance
if (!instance) return Astro.redirect('/portal/products/operator')
const operatorBase = `/portal/products/operator/${instance}`

const portalData = await getPortalClient(env.DB, Astro.locals)
if (!portalData) {
  return Astro.redirect('/auth/sign-in')
}
if (!portalData.client) {
  return Astro.redirect('/auth/sign-in?status=no_subscription')
}

const { user, client } = portalData

// Breadcrumb parent (list → detail hierarchy): step back to the OPERATORS list
// only when the client owns more than one operator. With a single operator the
// list forwards straight here, making this page the nav tab's destination — a
// "← Home" crumb would duplicate the Home tab one inch above it (Captain
// finding, 2026-07-15: top-level nav destinations carry no crumb).
const operatorCount = (await listCustomerConfigsForEntity(env.DB, client.id)).length
const showCrumb = operatorCount > 1

type SurfaceState = 'no_subscription' | 'paused' | 'no_role' | 'active'
let surfaceState: SurfaceState
let access: ProductAccess | null = null

// A provisioning subscription no longer blanks the console (console blueprint
// 05-console-blueprint.md §7b): the configuration below is the projected current
// state — exactly what a negotiation-phase client needs to read — so it renders
// in full, with a status line saying setup is still in progress. This matches
// resolveOperatorAccess, which already admits provisioning on every subpage.
const subscription = await getOperatorSubscriptionByInstance(env.DB, client.id, instance)
if (!subscription) {
  surfaceState = 'no_subscription'
} else if (subscription.status === 'paused') {
  surfaceState = 'paused'
} else {
  const roles = await listProductRoles(env.DB, user.id, client.id, PRODUCT_SLUG)
  if (roles.length === 0) {
    surfaceState = 'no_role'
  } else {
    surfaceState = 'active'
    access = { subscription, roles }
  }
}
const isProvisioning = subscription?.status === 'provisioning'

// The start door (the same gate Home and Billing read): a priced, still-
// provisioning row with no Stripe subscription offers Start here, where the
// client lands, not only on the Billing ledger. The route re-checks the facts.
let startDoor: OperatorStartDoor | null = null
if (subscription && isProvisioning) {
  const service = await getOperatorServiceForEntity(env.DB, user.org_id, client.id)
  const priceCents = operatorMonthlyPriceCents(service?.recurring_price)
  if (canStartOperatorSubscription(subscription, priceCents) && priceCents !== null) {
    startDoor = { href: operatorSubscriptionHref(instance), priceCents }
  }
}

let customerConfig = null
if (access) {
  const cfg = await getCustomerConfigBySlug(env.DB, instance)
  // Ownership guard: the addressed instance's config must belong to THIS
  // client's entity. A missing or foreign config redirects to the client's own
  // operator list (never leaks that the slug exists elsewhere).
  if (!cfg || cfg.entity_id !== client.id) {
    return Astro.redirect('/portal/products/operator')
  }
  customerConfig = cfg
}

// STATUS — persona identity + the real aliveness signal. Both are real from
// the config projection / fleet_status; the block is honest-empty when the
// runtime bridge has no data (never a fabricated "healthy").
let alivenessSignal: AlivenessSignal | null = null
if (access) {
  alivenessSignal = await resolveAlivenessSignal(env.DB, access.subscription)
}
const heroModel = resolveOperatorHero(customerConfig, alivenessSignal)

// THE SECTIONS. Every model comes from the SAME shared facet resolvers the
// chapter routes mounted, so nothing here can disagree with the admin mount.
const overview = resolveOperatorOverview(customerConfig)
const job = jobLines(overview.job)

// DUTIES — the full routine grid (or the gridless skills inventory), inline.
const workModel = access ? resolveOperatorWork(customerConfig) : null

// Business-hours header line (Lock 2): ONLY the timezone materializes on the
// seat today, so only the timezone renders. The display name is a
// deterministic Intl translation of the authored IANA zone (never invented).
const hours = parseBusinessHours(customerConfig?.business_hours)
let timezoneLine: string | null = null
if (hours?.timezone) {
  try {
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: hours.timezone,
      timeZoneName: 'longGeneric',
    }).formatToParts(new Date(0))
    const tzName = parts.find((p) => p.type === 'timeZoneName')?.value ?? null
    timezoneLine = tzName ? `Works on ${tzName}` : null
  } catch {
    timezoneLine = null
  }
}

// ACCESS — connected systems + the mailbox visibility block (the seeing-half
// of the retired Scope page, attached to the email system it describes).
const connectionRows = buildConnectionRows(
  customerConfig?.connectors,
  customerConfig?.credential_custody_default ?? 'delegated'
)
const scopeView = resolveOperatorScope(customerConfig).scope
const sendAs = personaSendAsAddress(
  customerConfig?.personas.find((p) => p.status === 'active')?.send_as
)
const emailAccess =
  scopeView && (scopeView.sees.length > 0 || scopeView.neverSees.length > 0 || sendAs)
    ? { sees: scopeView.sees, neverSees: scopeView.neverSees, sendAs }
    : null

// PEOPLE — the roster inline (who it responds to, standing recipients) plus
// who is on the account. Escalation renders in Settings (system setting);
// the block lists render in the Duties section (boundaries on work, not
// people) — both moves Captain, 2026-07-15.
const peopleModel = resolveOperatorPeople(customerConfig)
const blocks = peopleModel.people
  ? {
      topics: peopleModel.people.blockedTopics,
      senders: peopleModel.people.blockedSenders,
      work: peopleModel.people.blockedWork,
    }
  : null
let teamMembers: TeamMember[] = []
if (access) {
  teamMembers = (await loadTeamRoster(env.DB, client.id, client.org_id)).members
}

// PERSONA — the operator's own authored identity detail. Labeled Persona, not
// Voice (Captain vocabulary call, 2026-07-15): "voice" is reserved for the
// CLIENT's voice (ADR 0028 voice_library), which joins this section when the
// voice-establishment work lands (#1938).
const persona = personaLines(heroModel)
const hasPersona = Boolean(
  persona.name || persona.tone || persona.writesFrom || persona.alsoOperatesAs
)

// Empty-section rule: a section renders only when its plane has authored or
// derivable data; otherwise it is absent entirely. The rail lists only what
// renders.
const showDuties = Boolean(access && job)
const showAccess = Boolean(access && connectionRows.length > 0)
const showPeople = Boolean(access && (peopleModel.people !== null || teamMembers.length > 0))
const showPersona = Boolean(access && hasPersona)

interface RailSection {
  id: string
  label: string
}
// Persona leads (Captain, 2026-07-15: tucked at the bottom it read as a stray
// footer; the manual opens with who the operator is, then what it does).
const railSections: RailSection[] = []
if (showPersona) railSections.push({ id: 'persona', label: 'Persona' })
if (showDuties) railSections.push({ id: 'duties', label: 'Duties' })
if (showAccess) railSections.push({ id: 'access', label: 'Access' })
if (showPeople) railSections.push({ id: 'people', label: 'People' })

const RETURN_TO = operatorBase

// Change-request filing outcome: show-once flash (read + consumed here).
const crStatus = readChangeRequestFlash(Astro.cookies)
const crMessage =
  crStatus === 'filed'
    ? 'Your request was sent.'
    : crStatus === 'invalid'
      ? "That request couldn't be filed. Please add a short description and try again."
      : crStatus === 'error'
        ? 'Something went wrong filing your request. Please try again.'
        : null
const crTone = crStatus === 'filed' ? 'complete' : 'error'

// Section headings use the design system's section-h register (Archivo 900,
// 36px — the Plainspoken "§ block heading"), NOT the mono metadata label:
// structural headings draw the eye, mono is reserved for metadata (Captain,
// 2026-07-15 round 4).
const sectionHeadClass = 'font-body text-section-h uppercase text-[color:var(--color-text-primary)]'

// Honest non-active states (empty-state pattern).
const EMPTY: Record<Exclude<SurfaceState, 'active'>, { title: string; body: string }> = {
  no_subscription: {
    title: 'Not subscribed',
    body: "Your account doesn't include the Operator product. Contact us if you'd like to talk about adding it.",
  },
  paused: {
    title: 'Paused',
    body: 'Your Operator subscription is paused. Audit history remains accessible; new drafts are suspended until the subscription resumes.',
  },
  no_role: {
    title: 'Access pending',
    body: "The Operator is set up for your firm, but you haven't been granted a role yet. Contact your firm's principal to be added.",
  },
}
const empty = surfaceState !== 'active' ? EMPTY[surfaceState] : null
---

<PortalShell
  title="Operator"
  clientName={client.name}
  orgId={client.org_id}
  entityId={client.id}
  pathname={Astro.url.pathname}
>
  {
    showCrumb && (
      <a
        href="/portal/products/operator"
        class="mt-6 -mx-1 inline-flex min-h-11 items-center gap-2 px-1 font-mono text-label font-semibold uppercase tracking-[0.18em] text-[color:var(--color-text-secondary)] hover:text-[color:var(--color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-action)] focus-visible:ring-offset-2"
      >
        <span aria-hidden="true" class="font-body font-black text-[color:var(--color-primary)]">
          ←
        </span>
        Operators
      </a>
    )
  }

  {
    crMessage && (
      <div
        role="status"
        class={`mt-6 border-[3px] px-5 py-3 font-mono text-label font-bold uppercase tracking-[0.14em] ${
          crTone === 'complete'
            ? 'border-[color:var(--color-complete)] text-[color:var(--color-complete)]'
            : 'border-[color:var(--color-error)] text-[color:var(--color-error)]'
        }`}
      >
        {crMessage}
      </div>
    )
  }

  {
    empty && (
      <div class="mt-10 border-[3px] border-[color:var(--color-text-primary)] p-8 text-center md:p-12">
        <p class="font-body text-2xl font-black uppercase tracking-[-0.02em] text-[color:var(--color-text-primary)] md:text-3xl">
          {empty.title}
        </p>
        <p class="mt-3 font-mono text-label uppercase tracking-[0.14em] text-[color:var(--color-text-secondary)]">
          {empty.body}
        </p>
      </div>
    )
  }

  {
    surfaceState === 'active' && (
      <>
        {/* Header row: status label left, the two standing entries right —
            Activity (the read surface: every action the operator took, the
            audit record §4.5 promises is viewable here) and Settings (the act
            surface). Neither appears in the reading flow below. Activity was
            orphaned from all navigation until #2176 — the 2026-08-02 dress
            rehearsal found the principal role could not reach the audit
            record by clicking; tests/portal-operator-nav.test.ts now guards
            both links. */}
        <div class="mt-8 flex items-center justify-end gap-6">
          <a
            href={`${operatorBase}/activity`}
            class="inline-flex min-h-11 items-center gap-2 px-1 font-mono text-label font-semibold uppercase tracking-[0.18em] text-[color:var(--color-text-secondary)] hover:text-[color:var(--color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-action)] focus-visible:ring-offset-2"
          >
            Activity & Audit
            <span aria-hidden="true" class="font-body font-black text-[color:var(--color-primary)]">
              →
            </span>
          </a>
          <a
            href={`${operatorBase}/settings`}
            class="inline-flex min-h-11 items-center gap-2 px-1 font-mono text-label font-semibold uppercase tracking-[0.18em] text-[color:var(--color-text-secondary)] hover:text-[color:var(--color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-action)] focus-visible:ring-offset-2"
          >
            Settings
            <span aria-hidden="true" class="font-body font-black text-[color:var(--color-primary)]">
              →
            </span>
          </a>
        </div>
        <div class="mt-3">
          {/* One status signal: while provisioning, the hero itself states the
              setup posture (no aliveness alarm, no separate banner). */}
          <OperatorHero model={heroModel} provisioning={isProvisioning} start={startDoor} />
        </div>
        {overview.publishedOn && (
          <p class="mt-2 font-mono text-label uppercase tracking-[0.14em] text-[color:var(--color-text-secondary)]">
            Configuration as published {overview.publishedOn}
          </p>
        )}
        <p class="mt-3 font-body text-sm leading-snug text-[color:var(--color-text-secondary)]">
          This page is how your operator is set up today. Any of it can be changed. Each section
          below has a change request link.
        </p>

        {/* Sticky anchor rail — in-page navigation over the one-pager's
            sections. Deep-linkable (#duties); lists only sections that render. */}
        {railSections.length > 1 && (
          <nav
            aria-label="On this page"
            class="sticky top-0 z-10 mt-8 -mx-1 flex gap-6 border-b-[2px] border-[color:var(--color-text-primary)] bg-[color:var(--color-background)] px-1 py-3"
          >
            {railSections.map((s) => (
              <a
                href={`#${s.id}`}
                class="font-mono text-label font-bold uppercase tracking-[0.18em] text-[color:var(--ss-color-primary)] hover:text-[color:var(--ss-color-primary-hover)] hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-action)] focus-visible:ring-offset-2"
              >
                {s.label}
              </a>
            ))}
          </nav>
        )}

        <div class="mt-10 flex flex-col gap-12">
          {showPersona && (
            <section id="persona" aria-label="Persona" class="scroll-mt-16">
              <h2 class={sectionHeadClass}>Persona</h2>
              <p class="mt-2 font-body text-sm leading-snug text-[color:var(--color-text-secondary)]">
                Who your operator is and how it communicates.
              </p>
              <div class="mt-4">
                <DomainSurface
                  authority={customerConfig?.authority ?? null}
                  domain="configuration"
                  roles={access?.roles ?? []}
                  returnTo={RETURN_TO}
                  domainLabel="persona"
                >
                  <div slot="read">
                    <OperatorPersonaCard persona={persona} />
                  </div>
                </DomainSurface>
              </div>
            </section>
          )}

          {showDuties && workModel && (
            <section id="duties" aria-label="Duties" class="scroll-mt-16">
              <h2 class={sectionHeadClass}>Duties</h2>
              <p class="mt-2 font-body text-sm leading-snug text-[color:var(--color-text-secondary)]">
                Everything your operator does, and how much it does on its own.
              </p>
              {job && (
                <p class="mt-3 font-body text-base font-semibold text-[color:var(--color-text-primary)]">
                  {job.headline}
                </p>
              )}
              {job?.detail && (
                <p class="mt-1 font-mono text-label uppercase tracking-[0.14em] text-[color:var(--color-text-secondary)]">
                  {job.detail}
                </p>
              )}
              {timezoneLine && (
                <p class="mt-1 font-mono text-label uppercase tracking-[0.14em] text-[color:var(--color-text-secondary)]">
                  {timezoneLine}
                </p>
              )}
              {/* Gridless seats have no tier counts, so the global authority
                  rows are the only autonomy signal and render here. Grid seats
                  carry autonomy per-row inside the grid itself. */}
              {overview.job.kind !== 'grid' && overview.authority.length > 0 && (
                <div class="mt-4">
                  <OperatorAuthorityRows rows={overview.authority} />
                </div>
              )}
              <div class="mt-4">
                <DomainSurface
                  authority={customerConfig?.authority ?? null}
                  domain="configuration"
                  roles={access?.roles ?? []}
                  returnTo={RETURN_TO}
                  domainLabel="duties"
                >
                  <div slot="read">
                    <OperatorWork model={workModel} />
                  </div>
                </DomainSurface>
              </div>
              {(blocks || (workModel && workModel.standingCaps.length > 0)) && (
                <OperatorLimits standingCaps={workModel?.standingCaps ?? []} blocks={blocks} />
              )}
            </section>
          )}

          {showAccess && (
            <section id="access" aria-label="Access" class="scroll-mt-16">
              <h2 class={sectionHeadClass}>Access</h2>
              <p class="mt-2 font-body text-sm leading-snug text-[color:var(--color-text-secondary)]">
                The systems your operator works in, and what it can see there.
              </p>
              {connectionRows.length > 0 && (
                <div class="mt-4">
                  {/* Read-only on the one-pager: acting on a connection (OAuth
                      re-authorize, secret entry) lives in Settings → Connections.
                      Mailbox visibility renders inside the email connection's
                      own row (it describes that mailbox, nothing separate). */}
                  <DomainSurface
                    authority={customerConfig?.authority ?? null}
                    domain="connectors"
                    roles={access?.roles ?? []}
                    returnTo={RETURN_TO}
                    domainLabel="connections"
                  >
                    <ul
                      slot="read"
                      role="list"
                      class="m-0 list-none border-[3px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-background)] p-0"
                    >
                      {connectionRows.map((row) => (
                        <ConnectionRowCard
                          row={row}
                          operable={false}
                          returnTo={RETURN_TO}
                          instance={instance}
                          emailAccess={row.capabilityName === 'Email' ? emailAccess : null}
                        />
                      ))}
                    </ul>
                  </DomainSurface>
                </div>
              )}
            </section>
          )}

          {showPeople && (
            <section id="people" aria-label="People" class="scroll-mt-16">
              <h2 class={sectionHeadClass}>People</h2>
              <p class="mt-2 font-body text-sm leading-snug text-[color:var(--color-text-secondary)]">
                Who your operator works with, and on what terms.
              </p>
              <div class="mt-4">
                <DomainSurface
                  authority={customerConfig?.authority ?? null}
                  domain="configuration"
                  roles={access?.roles ?? []}
                  returnTo={RETURN_TO}
                  domainLabel="people"
                >
                  <div slot="read">
                    <OperatorPeople model={peopleModel} team={teamMembers} />
                  </div>
                </DomainSurface>
              </div>
            </section>
          )}
        </div>
      </>
    )
  }
</PortalShell>

---
import PortalShell from '../../../../../../layouts/PortalShell.astro'
import { resolveOperatorAccess } from '../../../../../../lib/portal/operator-access'
import { getStripeCustomerIdForSubscription } from '../../../../../../lib/portal/billing'
import {
  loadAccountState,
  subscriptionStatusLabel,
  subscriptionStatusProse,
} from '../../../../../../lib/portal/operator/account-read'
import PortalPageHead from '../../../../../../components/portal/PortalPageHead.astro'
import DomainSurface from '../../../../../../components/portal/operator/DomainSurface.astro'
import { hasPortalVisibleInvoices } from '../../../../../../lib/portal/offerings'
import { env } from 'cloudflare:workers'
import { readPausePosture } from '../../../../../../lib/portal/operator/pause-control'
import { readLiveOverrides } from '../../../../../../lib/portal/operator/entitlement-change'
import {
  resolveLiveTier,
  selectableTiers,
} from '../../../../../../lib/operator/entitlement-compiler'
import Field from '../../../../../../components/portal/form/Field.astro'
import TextInput from '../../../../../../components/portal/form/TextInput.astro'
import SelectField from '../../../../../../components/portal/form/SelectField.astro'
import SubmitButton from '../../../../../../components/portal/form/SubmitButton.astro'

/**
 * Operator — Settings, the ACT surface (console blueprint §5, amended
 * 2026-07-15). One read page, one act page: the one-pager is where a client
 * learns what the operator is; Settings is where they change something. It
 * holds Plan & billing (the commercial plane, moved off the read page
 * entirely) and the entries to the operable sub-surfaces (Connections, Team
 * access). Future config domains grow sections here as each becomes
 * self-serve (ADR 0041 authority switches); until then a domain's only
 * affordance is the read page's request-a-change.
 *
 * URL: portal.smd.services/portal/products/operator/<instance>/settings
 *
 * Also the redirect target for the customer-facing OAuth connect flow
 * (oauth/[connector]/callback.ts → `?status=connected` on success,
 * `?status=failed&reason=<short>` on failure) plus the initiate-failure path.
 *
 * Read access is all three client roles (matching the retired Account page);
 * each operable sub-surface enforces its own principal/operable gate.
 * Subscription is the `provisioning` domain — SMD-only, non-switchable —
 * rendered read-only with NO request form.
 */

const instance = Astro.params.instance
if (!instance) return Astro.redirect('/portal/products/operator')
const operatorBase = `/portal/products/operator/${instance}`

const access = await resolveOperatorAccess(env.DB, Astro.locals, {
  allowedRoles: ['principal', 'staff', 'compliance'],
  customerSlug: instance,
})
if (access.kind === 'redirect') {
  return Astro.redirect(access.to)
}
const { client, roles } = access
const config = access.config

const account = await loadAccountState(env.DB, client.id)
// Manage-Billing door renders only when a Stripe customer exists on the
// subscription (no fabricated door).
const stripeCustomerId = await getStripeCustomerIdForSubscription(env.DB, client.id, 'operator')

// Plan & billing renders only once a billing relationship EXISTS: invoice
// history on the entity, or this subscription past provisioning. Same ONE
// predicate as the nav tab and home card (empty-section rule applied to the
// commercial plane — Captain, 2026-07-15): a pre-go-live client easing into
// the portal reads no billing anywhere; the go-live flip or the first invoice
// reveals it everywhere at once.
const subscriptionLive = Boolean(
  account.subscription && account.subscription.status !== 'provisioning'
)
const showPlanBilling = subscriptionLive || (await hasPortalVisibleInvoices(env.DB, client.id))

const RETURN_TO = `${operatorBase}/settings`

import {
  TIER_LABELS,
  resolveSettingsBanner,
  settingsLinks,
} from '../../../../../../lib/portal/operator/settings-page'

// Connect-status banner — set by the OAuth callback / initiate on redirect.
const status = Astro.url.searchParams.get('status')
const reason = Astro.url.searchParams.get('reason')

// Pause posture (#2003): the Machine-reported sticky-stop level, read from
// this customer's own fleet_status row (display mirror; enforcement is the
// Machine-side ladder). 'HARD_STOP' renders the resume control; anything
// else renders pause. NULL/missing row reads as unknown -> control still
// renders (the gate call is the truth; a stale mirror must not hide the
// switch).
const pausedNow = await readPausePosture(env.DB, instance ?? '')

// Entitlement dial (#2003 Q7): the seat's routine grid, each row with the
// tiers it may legally be set to (compiler-derived, so the control can never
// offer a choice the route would reject). The tier DISPLAYED is the tier
// ENFORCED: the Machine's live override store is overlaid onto the projected
// authored exposure (a portal-set change is runtime posture the projection
// never carries).
//
// ss#2314: neither half of that is asserted blindly any more. `liveConfirmed`
// is false whenever the seat did not answer with this persona's rows, so the
// page says the levels are the authored ones rather than presenting them as
// what is running. And a row whose grid key names an action class the Operator
// cannot enforce is marked `configDefect`: it stays fail-closed AND is called
// out, instead of rendering as the surface-only level a working routine shows.
const gridPersona = config?.routine_grid?.persona ?? ''
const authoredExposure = (config?.personas.find((p) => p.slug === gridPersona)?.entitlements
  .exposure ?? {}) as Record<string, string>
const liveRead =
  instance && gridPersona
    ? await readLiveOverrides(
        {
          OPERATOR_RUNTIME_READ_SECRET: env.OPERATOR_RUNTIME_READ_SECRET,
          OPERATOR_RUNTIME_READ_URL: env.OPERATOR_RUNTIME_READ_URL,
        },
        instance,
        gridPersona
      )
    : ({ status: 'unconfigured' } as const)
const liveOverrides = liveRead.status === 'ok' ? liveRead.overrides : {}
const liveConfirmed = liveRead.status === 'ok'
const routineRows = (config?.routine_grid?.rows ?? []).map((row) => {
  const resolved = resolveLiveTier(row, {
    personaSlug: gridPersona,
    exposure: { ...authoredExposure, ...liveOverrides },
  })
  return {
    routine: row.routine,
    liveTier: resolved.tier,
    configDefect: resolved.unknownActionClass !== null,
    ceiling: row.ceiling_tier,
    options: selectableTiers(row),
  }
})

const banner = resolveSettingsBanner(status, reason)

const subStatus = account.subscription?.status ?? null
const statusToneClass =
  subStatus === 'active'
    ? 'border-[color:var(--ss-color-complete)] text-[color:var(--ss-color-complete)]'
    : subStatus === 'paused'
      ? 'border-[color:var(--ss-color-warning)] text-[color:var(--ss-color-warning)]'
      : 'border-[color:var(--ss-color-text-primary)] text-[color:var(--ss-color-text-primary)]'

const cardClass = 'border-[3px] border-[color:var(--ss-color-text-primary)] p-6 md:p-8'
const sectionLabelClass =
  'mb-4 font-body text-section-h uppercase text-[color:var(--ss-color-text-primary)]'
const emptyNoteClass =
  'font-mono text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-secondary)]'

const SETTINGS_LINKS = settingsLinks(operatorBase)
---

<PortalShell
  title="Operator · Settings"
  clientName={client.name}
  orgId={client.org_id}
  entityId={client.id}
  pathname={Astro.url.pathname}
>
  <PortalPageHead crumbHref={operatorBase} crumbLabel="Operator" h1="Settings" meta={null} />

  {
    banner && (
      <div
        role="status"
        class:list={[
          'mt-6 px-4 py-3 border-[3px] text-sm',
          banner.tone === 'success'
            ? 'border-[color:var(--ss-color-complete)] bg-[color:var(--ss-color-complete)]/10 text-[color:var(--ss-color-complete)]'
            : banner.tone === 'error'
              ? 'border-[color:var(--ss-color-error)] bg-[color:var(--ss-color-error)]/10 text-[color:var(--ss-color-error)]'
              : 'border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-border-subtle)] text-[color:var(--ss-color-text-primary)]',
        ]}
      >
        {banner.text}
      </div>
    )
  }

  <!-- Pause control — the kill switch (#2003, runtime domain). Operable only
       when the seat authors authority.runtime: client AND the acting user's
       role permits runtime (principal). Q6: stops all activity immediately,
       stays off until resumed, client-usable without SMD, every change
       logged. -->
  <section class="mt-8" aria-label="Pause control">
    <p class={sectionLabelClass}>Pause control</p>
    <DomainSurface
      authority={config?.authority ?? null}
      domain="runtime"
      roles={roles}
      returnTo={RETURN_TO}
      domainLabel="pausing and resuming the Operator"
    >
      <div slot="operable" class={cardClass}>
        <p class="m-0 font-body text-sm leading-snug text-[color:var(--ss-color-text-secondary)]">
          {
            pausedNow
              ? 'The Operator is paused: nothing runs, nothing sends, nothing is scheduled until an admin resumes it. Resuming restarts all configured activity.'
              : 'Pausing stops all Operator activity immediately and keeps it off until an admin resumes it. Every pause and resume is logged with who made it and when.'
          }
        </p>
        <form
          method="POST"
          action={`/api/portal/products/operator/${instance}/pause`}
          class="mt-4 flex flex-col gap-3 md:grid md:grid-cols-[minmax(0,1fr)_auto] md:items-end"
        >
          <input type="hidden" name="action" value={pausedNow ? 'resume' : 'pause'} />
          <Field label="Reason (required, kept in the log)">
            <TextInput name="reason" required maxlength={300} />
          </Field>
          <SubmitButton
            label={pausedNow ? 'Resume the Operator' : 'Pause the Operator'}
            tone={pausedNow ? 'success' : 'danger'}
          />
        </form>
      </div>
      <div slot="read" class={cardClass}>
        <p class="m-0 font-body text-sm leading-snug text-[color:var(--ss-color-text-secondary)]">
          {
            pausedNow
              ? 'The Operator is currently paused.'
              : 'The Operator is running. Pausing stops all activity immediately; it stays off until resumed, and every change is logged.'
          }
        </p>
      </div>
    </DomainSurface>
  </section>

  <!-- Autonomy per routine — the entitlement control (#2003, trust domain).
       Operable only when the seat authors authority.trust: client AND the
       role matrix permits. A within-ceiling change is applied to the running
       Machine on submit (runtime posture, Captain ruling 2026-07-28); the
       authored ceiling in git stays non-raisable from this path. -->
  {
    routineRows.length > 0 && (
      <section class="mt-10" aria-label="Autonomy per routine">
        <p class={sectionLabelClass}>Autonomy per routine</p>
        <DomainSurface
          authority={config?.authority ?? null}
          domain="trust"
          roles={roles}
          returnTo={RETURN_TO}
          domainLabel="how much each routine does on its own"
        >
          <div slot="operable" class={cardClass}>
            <p class="m-0 font-body text-sm leading-snug text-[color:var(--ss-color-text-secondary)]">
              Each routine runs at one of three levels: it can surface work, prepare it for someone
              to send, or handle it end to end. A change takes effect right away and stays in place
              until someone changes it again. Every change is logged with who made it and when.
            </p>
            {!liveConfirmed && (
              <p class={`mt-3 ${emptyNoteClass}`}>
                We could not reach the Operator to confirm its current levels. The levels below are
                the ones on file. Try again shortly, or contact us if this persists.
              </p>
            )}
            <ul class="mt-4 flex flex-col gap-4 list-none p-0">
              {routineRows.map((row) => (
                <li class="border-t-[2px] border-[color:var(--ss-color-border-subtle)] pt-4">
                  <p class="m-0 font-body font-bold text-[color:var(--ss-color-text-primary)]">
                    {row.routine}
                  </p>
                  {row.configDefect ? (
                    <p class={`mt-2 ${emptyNoteClass}`}>
                      This routine is set up in a way the Operator cannot act on, so its level
                      cannot be shown or changed here. It stays limited to surfacing work until we
                      correct it. We have been notified.
                    </p>
                  ) : (
                    <form
                      method="POST"
                      action={`/api/portal/products/operator/${instance}/entitlement`}
                      class="mt-3 flex flex-col gap-3 md:grid md:grid-cols-[minmax(0,19rem)_minmax(0,1fr)_auto] md:items-end"
                    >
                      <input type="hidden" name="routine" value={row.routine} />
                      <Field label="Level">
                        <SelectField
                          name="targetTier"
                          options={row.options.map((tier) => ({
                            value: tier,
                            label: TIER_LABELS[tier],
                            selected: tier === row.liveTier,
                          }))}
                        />
                      </Field>
                      <Field label="Reason (required, kept in the log)">
                        <TextInput name="reason" required maxlength={300} />
                      </Field>
                      <SubmitButton label="Submit" />
                    </form>
                  )}
                </li>
              ))}
            </ul>
          </div>
          <div slot="read" class={cardClass}>
            <p class="m-0 font-body text-sm leading-snug text-[color:var(--ss-color-text-secondary)]">
              Each routine runs at one of three levels: it can surface work, prepare it for someone
              to send, or handle it end to end.
            </p>
            {!liveConfirmed && (
              <p class={`mt-3 ${emptyNoteClass}`}>
                We could not reach the Operator to confirm its current levels. The levels below are
                the ones on file.
              </p>
            )}
            <ul class="mt-4 flex flex-col gap-2 list-none p-0">
              {routineRows.map((row) => (
                <li class="flex flex-wrap items-baseline justify-between gap-2 border-t-[2px] border-[color:var(--ss-color-border-subtle)] pt-2">
                  <span class="font-body text-sm text-[color:var(--ss-color-text-primary)]">
                    {row.routine}
                  </span>
                  <span class={emptyNoteClass}>
                    {row.configDefect ? 'Needs our attention' : TIER_LABELS[row.liveTier]}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </DomainSurface>
      </section>
    )
  }

  <!-- Plan & billing — provisioning domain: SMD-only, read-only, no request
       form. Absent entirely pre-go-live (billing-relationship gate above). -->
  {
    showPlanBilling && (
      <section class="mt-8" aria-label="Plan and billing">
        <p class={sectionLabelClass}>Plan & billing</p>
        <DomainSurface
          authority={config?.authority ?? null}
          domain="provisioning"
          roles={roles}
          returnTo={RETURN_TO}
          domainLabel="your subscription"
        >
          <div slot="read" class={cardClass}>
            {account.subscription ? (
              <div class="flex flex-col gap-3">
                <span
                  class={`inline-flex w-fit items-center px-3 py-1.5 text-caption font-mono uppercase tracking-[0.12em] font-bold border-[2px] ${statusToneClass}`}
                >
                  {subscriptionStatusLabel(account.subscription.status)}
                </span>
                {/* The chip states the status; the prose only adds value when the
                  status needs explaining (paused, etc.), so skip it for active. */}
                {account.subscription.status !== 'active' && (
                  <p class="m-0 font-body text-[color:var(--ss-color-text-primary)]">
                    {subscriptionStatusProse(account.subscription.status)}
                  </p>
                )}
                {stripeCustomerId && (
                  <form method="POST" action="/api/portal/billing/manage" class="mt-2">
                    <input type="hidden" name="product_slug" value="operator" />
                    <input type="hidden" name="instance" value={instance} />
                    <button
                      type="submit"
                      class="px-5 py-2.5 border-[3px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-background)] font-bold uppercase tracking-[0.08em] font-body hover:bg-[color:var(--ss-color-text-primary)] hover:text-[color:var(--ss-color-background)] transition-colors"
                    >
                      Manage Billing
                    </button>
                  </form>
                )}
              </div>
            ) : (
              <div class="flex flex-col gap-2">
                <p class="m-0 font-body text-xl font-black uppercase tracking-[-0.01em] text-[color:var(--ss-color-text-primary)]">
                  Not provisioned yet
                </p>
                <p class={`m-0 ${emptyNoteClass}`}>
                  Your operator subscription has not been set up yet.
                </p>
              </div>
            )}
          </div>
        </DomainSurface>
      </section>
    )
  }

  <!-- Operational alerts — a system setting, not a person the operator works
       with (Captain, 2026-07-15: escalation read as plumbing on the People
       section). Authored config under the configuration domain: read + request. -->
  <section class="mt-10" aria-label="Operational alerts">
    <p class={sectionLabelClass}>Operational alerts</p>
    <DomainSurface
      authority={config?.authority ?? null}
      domain="configuration"
      roles={roles}
      returnTo={RETURN_TO}
      domainLabel="who is alerted about the operator itself"
    >
      <div slot="read" class={cardClass}>
        <p class="m-0 font-body text-sm leading-snug text-[color:var(--ss-color-text-secondary)]">
          When the operator spots something urgent or hits a problem in its own operation, these
          people are alerted. While SMD manages your operator they go to SMD; your own people can be
          added.
        </p>
        {
          account.escalation.caseAlertRouting?.mode === 'matter_staff' && (
            <div class="mt-4">
              <p class="m-0 font-mono text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-secondary)]">
                Case alerts
              </p>
              <p class="mt-1 m-0 font-body text-sm leading-snug text-[color:var(--ss-color-text-primary)]">
                Routed to the people assigned to each record in your system of record.
                {account.escalation.caseAlertRouting.fallbackRecipients.length > 0
                  ? ` If a record has no usable assignment: ${account.escalation.caseAlertRouting.fallbackRecipients.join(', ')}.`
                  : ' If a record has no usable assignment, the alert holds and the record is flagged until a fallback contact is set.'}
              </p>
            </div>
          )
        }
        {
          account.escalation.redFlagRecipients.length > 0 && (
            <div class="mt-4">
              <p class="m-0 font-mono text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-secondary)]">
                Urgent flags
              </p>
              <p class="mt-1 m-0 font-body text-sm leading-snug text-[color:var(--ss-color-text-primary)]">
                {account.escalation.redFlagRecipients.join(', ')}
              </p>
            </div>
          )
        }
        {
          account.escalation.failureRecipients.length > 0 && (
            <div class="mt-4">
              <p class="m-0 font-mono text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-secondary)]">
                Failures
              </p>
              <p class="mt-1 m-0 font-body text-sm leading-snug text-[color:var(--ss-color-text-primary)]">
                {account.escalation.failureRecipients.join(', ')}
              </p>
            </div>
          )
        }
        {
          account.escalation.redFlagRecipients.length === 0 &&
            account.escalation.failureRecipients.length === 0 && (
              <p class={`mt-4 m-0 ${emptyNoteClass}`}>No alert recipients are configured yet.</p>
            )
        }
      </div>
    </DomainSurface>
  </section>

  <section class="mt-10" aria-label="Configuration">
    <p class={sectionLabelClass}>Configuration</p>
    <div class="border-[3px] border-[color:var(--ss-color-text-primary)]">
      {
        SETTINGS_LINKS.map((link, idx) => (
          <a
            href={link.href}
            class:list={[
              'block px-5 py-5 md:px-6 md:py-6 group hover:bg-[color:var(--ss-color-border-subtle)] transition-colors',
              'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2',
              idx > 0 ? 'border-t-[2px] border-[color:var(--ss-color-text-primary)]' : '',
            ]}
          >
            <div class="flex items-center justify-between gap-4">
              <div class="flex flex-col gap-1 min-w-0">
                <span class="font-body text-lg font-black uppercase tracking-[-0.01em] text-[color:var(--ss-color-text-primary)]">
                  {link.label}
                </span>
                <span class="text-sm text-[color:var(--ss-color-text-secondary)]">
                  {link.description}
                </span>
              </div>
              <span
                aria-hidden="true"
                class="font-body text-2xl text-[color:var(--ss-color-text-muted)] group-hover:text-[color:var(--ss-color-text-primary)] transition-colors"
              >
                →
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</PortalShell>

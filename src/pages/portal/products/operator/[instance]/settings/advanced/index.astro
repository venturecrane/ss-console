---
import PortalShell from '../../../../../../../layouts/PortalShell.astro'
import { getPortalClient } from '../../../../../../../lib/portal/session'
import {
  getOperatorSubscriptionByInstance,
  listProductRoles,
} from '../../../../../../../lib/portal/product-access'
import { getCustomerConfigBySlug } from '../../../../../../../lib/portal/customer-config'
import { resolveEditableConfigFromRow } from '../../../../../../../lib/portal/operator/customer-yaml-editor'
import PortalPageHead from '../../../../../../../components/portal/PortalPageHead.astro'
import PersonaFields from '../../../../../../../components/portal/operator/customer-yaml-editor/PersonaFields.astro'
import EscalationFields from '../../../../../../../components/portal/operator/customer-yaml-editor/EscalationFields.astro'
import BusinessHoursFields from '../../../../../../../components/portal/operator/customer-yaml-editor/BusinessHoursFields.astro'
import ConnectorsFields from '../../../../../../../components/portal/operator/customer-yaml-editor/ConnectorsFields.astro'
import ScopeFields from '../../../../../../../components/portal/operator/customer-yaml-editor/ScopeFields.astro'
import OutputClassSpecs from '../../../../../../../components/portal/operator/OutputClassSpecs.astro'
import SubmitButton from '../../../../../../../components/portal/form/SubmitButton.astro'
import { checkOutputClasses } from '../../../../../../../lib/operator/customer-yaml/sections-output-classes'
import type {
  OutputClasses,
  ValidationError,
} from '../../../../../../../lib/operator/customer-yaml/types'
import {
  readSpecDocument,
  type SpecDocument,
} from '../../../../../../../lib/operator/output-class-specs'
import { env } from 'cloudflare:workers'

/**
 * Operator — advanced settings (customer.yaml editor).
 *
 * URL: portal.smd.services/portal/products/operator/settings/advanced
 *
 * Form-based editor for the customer.yaml configuration that previously
 * required Captain intervention. NOT a raw YAML textarea — every field
 * is a typed input with structured validation.
 *
 * ONE WINDOW AND ONE FORM, AND NEITHER OF THEM WRITES FROM HERE.
 *
 *   Output shape (ADR 0083) is the client's established voice and format
 *   specs, read from their vault object. It is READ-ONLY as of ADR 0085 §7:
 *   establishment is a conversational act performed against the Operator
 *   itself, and the portal's role is visibility and audit. It is placed FIRST
 *   because it is the part of this page a client actually came to see.
 *
 *   The customer.yaml editor below it validates and records a change request
 *   and writes nothing: per ADR 0012 §4 git is the authoritative source for
 *   customer.yaml, and it is auto-published to the seat on merge, so a portal
 *   write would be clobbered by the next unrelated merge. It used to redirect
 *   with `?status=applied` regardless (#2089); it now says `submitted`, which
 *   is what happened. Its button stays the bordered secondary treatment for
 *   that reason: a filled primary would promise an effect the submission does
 *   not have.
 *
 * Access gate (per the issue acceptance criteria):
 *   - Clerk session (middleware enforces)
 *   - Active Operator subscription on this customer
 *   - Caller holds the 'principal' role on (entity, 'operator')
 *
 * Operators and compliance users are redirected back to the AI
 * Employee landing — the page does not render a half-locked view.
 *
 * SMD-only fields (`connector token_ref`, `safety.sticky_stop.*`,
 * `personas` length, schema/identity/runtime/memory fields) display
 * as read-only. The server-side validator rejects any attempt to
 * mutate them even if the form is bypassed.
 *
 * Identity fields the PROJECTION does not carry (the machine size, the
 * model, the region) are not rendered at all. The resolver used to
 * invent them — `model: 'unknown'`, `vertical: 'mixed'` for a law firm, a
 * fabricated version pin — and only avoided showing a client those values by
 * failing to render entirely (#1965). Absent is the honest display of absent.
 *
 * Mutations are HTML-form POSTs to
 * /api/portal/operator/settings/customer-yaml-update. On
 * validation failure the endpoint redirects back here with
 * `?status=invalid` and the page surfaces a generic invalid banner;
 * the per-field errors are persisted in a flash table that the next
 * iteration plumbs through.
 */

const PRODUCT_SLUG = 'operator'

const instance = Astro.params.instance
if (!instance) return Astro.redirect('/portal/products/operator')
const operatorBase = `/portal/products/operator/${instance}`
const SETTINGS_LANDING_URL = `${operatorBase}/settings`

const portalData = await getPortalClient(env.DB, Astro.locals)
if (!portalData) {
  return Astro.redirect('/auth/sign-in')
}
if (!portalData.client) {
  return Astro.redirect('/auth/sign-in?status=no_subscription')
}

const { user, client } = portalData

const subscription = await getOperatorSubscriptionByInstance(env.DB, client.id, instance)
if (!subscription) {
  return Astro.redirect('/portal/products/operator')
}

const callerRoles = await listProductRoles(env.DB, user.id, client.id, PRODUCT_SLUG)
if (!callerRoles.includes('principal')) {
  return Astro.redirect(SETTINGS_LANDING_URL)
}

// Ownership guard: the addressed instance's config must belong to THIS client's
// entity before rendering the editor. A missing or foreign config redirects to
// the client's own operator list.
const configRow = await getCustomerConfigBySlug(env.DB, instance)
if (!configRow || configRow.entity_id !== client.id) {
  return Astro.redirect('/portal/products/operator')
}

// The failing paths go to the Worker log, not to the page: they name internal
// schema fields, which tell a client nothing and tell an attacker something.
let resolved: ReturnType<typeof resolveEditableConfigFromRow> | null = null
let projectionError = false
if (configRow !== null) {
  resolved = resolveEditableConfigFromRow(configRow)
  if ('error' in resolved) {
    console.error(
      'advanced-settings: projection failed validation for',
      instance,
      resolved.errors.map((e) => e.path).join(', ')
    )
    projectionError = true
    resolved = null
  }
}

// Output shape (ADR 0083) — the client's established specs, read from their
// vault object. `absent` is the ordinary state of a client who has established
// nothing; `unreadable` is not, and the component says so rather than
// rendering prose it could not read as a firm that established nothing.
const declaredErrors: ValidationError[] = []
const declaredClasses: OutputClasses =
  checkOutputClasses({ output_classes: configRow?.output_classes }, declaredErrors) ?? {}
let specDocument: SpecDocument | null = null
let specUnreadable = false
if (configRow !== null) {
  try {
    const read = await readSpecDocument(env.CUSTOMER_CONFIG, instance)
    if (read.kind === 'document') specDocument = read.doc
    if (read.kind === 'unreadable') specUnreadable = true
  } catch (err) {
    // A key-space refusal (a slug outside the charset) or an R2 fault. Either
    // way we could not read what is there, so the page must not show an
    // absence in its place.
    console.error('advanced-settings: could not read the spec object for', instance, err)
    specUnreadable = true
  }
}

const status = Astro.url.searchParams.get('status')
type BannerStatus = { text: string; tone: 'success' | 'error' | 'info' }
const STATUS_BANNERS: Record<string, BannerStatus> = {
  // The customer.yaml form records a request and writes nothing; the banner
  // says exactly that. It used to say "Settings saved." (#2089).
  submitted: {
    text: 'Change request recorded. Your Operator has not changed.',
    tone: 'info',
  },
  invalid: {
    text: 'Some fields failed validation. Correct the highlighted errors and resubmit.',
    tone: 'error',
  },
  forbidden: {
    text: 'You do not have permission to make this change.',
    tone: 'error',
  },
  no_config: {
    text: 'No configuration is currently available for this Operator. Contact SMD.',
    tone: 'error',
  },
  internal_error: {
    text: 'A server error occurred while saving. Try again or contact SMD.',
    tone: 'error',
  },
  // Output-shape statuses. Only `spec_saved` follows a write that was made and
  // read back byte-identical.
  //
  // THEY STAY, THOUGH NO FORM ON THIS PAGE POSTS ANY MORE. ADR 0085 §7 demoted
  // the authoring form, not the endpoint: `output-class-specs.ts` still writes
  // the vault object and still redirects here with each of these statuses, and
  // it is the seam the mediated establishment path lands on. A status whose
  // banner had been deleted would render as no message at all — the person
  // returned to the page, nothing said. `tests/output-class-specs.test.ts`
  // pins the parity in both directions.
  spec_saved: { text: 'Output shape saved to your Operator.', tone: 'success' },
  // One refusal, one sentence. The endpoint maps each build failure to its own
  // status precisely so that a person who wrote too much is told to shorten it
  // rather than being handed a catch-all and left to resubmit the same text.
  spec_too_long: {
    text: 'The output shape was not saved. One of your descriptions is longer than your Operator accepts. Shorten it and resubmit.',
    tone: 'error',
  },
  spec_empty: {
    text: 'The output shape was not saved, because every description was empty. Removing the last one is not something this page can do. Contact SMD.',
    tone: 'error',
  },
  spec_invalid: {
    text: 'The output shape was not saved and nothing changed on your Operator. Contact SMD.',
    tone: 'error',
  },
  // A rule the client CAN fix, so it gets its own sentence rather than the
  // catch-all: the specific problem is listed under the rule on the form.
  spec_invalid_rule: {
    text: 'The output shape was not saved. One of your shape rules cannot be applied as written. Check the rules below and resubmit.',
    tone: 'error',
  },
  spec_no_classes: {
    text: 'No output classes are set up for this Operator, so there is nothing to save.',
    tone: 'error',
  },
  spec_unreadable: {
    text: 'Your saved output shape could not be read, so it was not replaced. Contact SMD.',
    tone: 'error',
  },
  spec_write_failed: {
    text: 'The output shape could not be saved to your Operator. Nothing changed. Try again or contact SMD.',
    tone: 'error',
  },
}
const banner = status ? (STATUS_BANNERS[status] ?? null) : null

const editable = resolved && !('error' in resolved) ? resolved.editable : null
const locked = resolved && !('error' in resolved) ? resolved.locked : null
---

<PortalShell
  title="Operator · Advanced settings"
  clientName={client.name}
  orgId={client.org_id}
  entityId={client.id}
  pathname={Astro.url.pathname}
>
  <PortalPageHead
    crumbHref={SETTINGS_LANDING_URL}
    crumbLabel="Settings"
    tag="Section"
    h1="Advanced"
    meta={null}
  />

  {
    banner && (
      <div
        role="status"
        class:list={[
          'mt-6 px-4 py-3 border-[3px] text-sm',
          banner.tone === 'success'
            ? 'border-[color:var(--ss-color-complete)] bg-[color:var(--ss-color-complete)]/10 text-[color:var(--ss-color-complete)]'
            : banner.tone === 'error'
              ? 'border-[color:var(--ss-color-error)] bg-[color:var(--ss-color-error)]/10 text-[color:var(--ss-color-error)]'
              : 'border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-border-subtle)] text-[color:var(--ss-color-text-primary)]',
        ]}
      >
        {banner.text}
      </div>
    )
  }

  {
    configRow === null ? (
      <section class="mt-10">
        <div class="border-[3px] border-[color:var(--ss-color-text-primary)] p-8 md:p-12 text-center">
          <p class="font-body text-2xl md:text-3xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]">
            No configuration found
          </p>
          <p class="mt-3 font-mono text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-secondary)]">
            This Operator's configuration is not available yet. Contact SMD.
          </p>
        </div>
      </section>
    ) : projectionError ? (
      <section class="mt-10">
        <div class="border-[3px] border-[color:var(--ss-color-error)] p-8 md:p-12 text-center">
          <p class="font-body text-2xl md:text-3xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-error)]">
            Configuration error
          </p>
          <p class="mt-3 font-mono text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-secondary)]">
            The current configuration could not be read. Contact SMD.
          </p>
        </div>
      </section>
    ) : editable !== null && locked !== null ? (
      <Fragment>
        <OutputClassSpecs
          declared={declaredClasses}
          current={specDocument}
          unreadable={specUnreadable}
        />

        <form
          method="POST"
          action="/api/portal/operator/settings/customer-yaml-update"
          class="mt-2"
        >
          <input type="hidden" name="instance" value={instance} />
          <section class="mt-10 border-[3px] border-[color:var(--ss-color-text-primary)] p-6">
            <h2 class="font-mono text-label uppercase tracking-[0.18em] font-bold text-[color:var(--ss-color-text-secondary)]">
              SMD-managed identity
            </h2>
            <dl class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-3 text-sm">
              <div>
                <dt class="font-mono uppercase tracking-[0.14em] text-xs text-[color:var(--ss-color-text-muted)]">
                  Operator ID
                </dt>
                <dd class="font-mono text-[color:var(--ss-color-text-primary)]">
                  {locked.customer_id}
                </dd>
              </div>
              {locked.vertical && (
                <div>
                  <dt class="font-mono uppercase tracking-[0.14em] text-xs text-[color:var(--ss-color-text-muted)]">
                    Vertical
                  </dt>
                  <dd class="text-[color:var(--ss-color-text-primary)]">{locked.vertical}</dd>
                </div>
              )}
            </dl>
            <p class="mt-4 text-xs text-[color:var(--ss-color-text-muted)]">
              SMD-managed fields change only by SMD, through the configuration repository.
            </p>
          </section>

          <PersonaFields personas={editable.personas} errors={[]} />
          <EscalationFields escalation={editable.escalation} errors={[]} />
          <BusinessHoursFields businessHours={editable.businessHours} errors={[]} />
          <ConnectorsFields
            connectors={editable.connectors}
            tokenRefs={locked.connector_token_refs}
            errors={[]}
          />
          <ScopeFields scope={editable.scope} errors={[]} />

          <div class="mt-12 flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-end border-t-[3px] border-[color:var(--ss-color-text-primary)] pt-6">
            <a
              href={SETTINGS_LANDING_URL}
              class="inline-flex h-11 items-center justify-center border-[3px] border-[color:var(--ss-color-text-primary)] px-5 font-body text-body font-bold uppercase tracking-[0.08em] text-[color:var(--ss-color-text-primary)] transition-colors hover:bg-[color:var(--ss-color-text-primary)] hover:text-[color:var(--ss-color-background)]"
            >
              Cancel
            </a>
            <SubmitButton label="Submit change request" />
          </div>
        </form>
      </Fragment>
    ) : null
  }
</PortalShell>

---
import PortalShell from '../../../../../layouts/PortalShell.astro'
import PortalPageHead from '../../../../../components/portal/PortalPageHead.astro'
import SubmitButton from '../../../../../components/portal/form/SubmitButton.astro'
import {
  resolveCouplesAccess,
  COUPLES_LANDING_PATH,
} from '../../../../../lib/portal/couples-access'
import { issueLinkToken } from '../../../../../lib/db/couples-link-tokens'
import { telegramDeepLink, TOKEN_TTL_MS } from '../../../../../lib/hosted-agent/couples/link-token'
import { env } from 'cloudflare:workers'

/**
 * Couples onboarding step 2: the Telegram deep link (ADR 0091 s5, plan R4).
 *
 * GET shows a button; POST mints a single-use, short-lived token bound to the
 * signed-in partner and renders `t.me/<bot>?start=<token>` in the response
 * body. The token is never put in a URL of this site (no redirect carries
 * it), so it does not land in browser history or request logs here. Minting
 * burns the partner's previous unused link.
 *
 * Tapping the link sends `/start <token>` to the seat's bot. The seat asks the
 * console to redeem it, and the binding is recorded. That does not yet let the
 * partner chat with the agent: the Telegram id reaches the seat's allowlist only
 * through a reviewed config change and a restart.
 */

export const prerender = false

const access = await resolveCouplesAccess(env.DB, Astro.locals)
if (access.kind === 'redirect') {
  return Astro.redirect(access.to)
}
const { instance, person } = access
const bot = instance.telegram_bot_username
if (person.consent_at === null || !bot) {
  return Astro.redirect(COUPLES_LANDING_PATH)
}

let link: string | null = null
// The response may carry a live token: never cache it anywhere.
Astro.response.headers.set('Cache-Control', 'no-store')
if (Astro.request.method === 'POST') {
  const issued = await issueLinkToken(env.DB, person.id)
  link = telegramDeepLink(bot, issued.token)
}
const bound = person.telegram_id !== null && person.telegram_id !== ''
const minutes = Math.round(TOKEN_TTL_MS / 60000)
const bodyClass = 'mt-3 font-body text-base text-[color:var(--ss-color-text-secondary)]'
---

<PortalShell
  title="Connect Telegram"
  clientName={access.client.name}
  orgId={access.client.org_id}
  entityId={access.client.id}
  pathname={Astro.url.pathname}
>
  <PortalPageHead
    crumbHref={COUPLES_LANDING_PATH}
    crumbLabel="Shared Agent Setup"
    tag="Setup"
    h1="Connect Telegram"
    meta={null}
  />

  <div class="mt-8 border-[3px] border-[color:var(--ss-color-text-primary)] p-5 md:p-6">
    {
      bound && (
        <p class={bodyClass}>
          Your Telegram is already connected. Create a new link only if you want to link a different
          Telegram account.
        </p>
      )
    }
    {
      link ? (
        <>
          <p class="font-body text-base text-[color:var(--ss-color-text-primary)]">
            Open this link on the phone or computer where you use Telegram, then tap Start.
          </p>
          <a
            href={link}
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center justify-center px-6 py-3 border-[3px] border-[color:var(--ss-color-primary)] bg-[color:var(--ss-color-primary)] text-white font-bold uppercase tracking-[0.08em] font-body"
          >
            Open Telegram
          </a>
          <p class={bodyClass}>
            The link works once and expires in {minutes} minutes. It is yours alone: do not forward
            it. The agent replies in Telegram to say it received the link, and this setup page shows
            your Telegram as connected. You can chat with the agent on Telegram once SMD finishes
            setting it up; email works in the meantime.
          </p>
        </>
      ) : (
        <form method="POST" class="flex flex-col gap-4">
          <p class="font-body text-base text-[color:var(--ss-color-text-primary)]">
            Telegram is optional: email keeps working either way. Create a one-time link that
            connects your Telegram account to you. It expires in {minutes} minutes, and creating a
            new one cancels any earlier link.
          </p>
          <SubmitButton label="Create my link" tone="primary" />
        </form>
      )
    }
  </div>
</PortalShell>

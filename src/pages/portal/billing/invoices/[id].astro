---
import PortalShell from '../../../../layouts/PortalShell.astro'
import { getPortalClient } from '../../../../lib/portal/session'
import { loadPortalInvoiceDetail } from '../../../../lib/portal/invoice-detail'
import { invoiceTypeLabel } from '../../../../lib/db/invoices'
import PortalPageHead from '../../../../components/portal/PortalPageHead.astro'
import PortalDetailTable from '../../../../components/portal/PortalDetailTable.astro'
import PortalDetailRow from '../../../../components/portal/PortalDetailRow.astro'
import PortalActionLink from '../../../../components/portal/PortalActionLink.astro'
import MoneyDisplay from '../../../../components/portal/MoneyDisplay.astro'
import { resolveInvoiceState } from '../../../../lib/portal/states'
import { formatShortDate } from '../../../../lib/portal/formatters'
import { env } from 'cloudflare:workers'

/**
 * Invoice detail: the Billing ledger row, opened up. Same shape as the
 * subscription page (src/pages/portal/billing/subscriptions/[instance].astro):
 * page head with the dates in the meta column, one ink-bordered fact table,
 * one primary action with a mono caption under it. Until 2026-09-09 this
 * page wore the calm card register (rounded light-border rail, sentence-case
 * heading, hairline dividers, icon-led captions) that ADR 0082 retired, and
 * the Captain read it beside the subscription page as two designs made
 * without knowledge of each other. Nothing about the data changed.
 *
 * Route param `id` → invoices.id, scoped to the portal entity via
 * getInvoiceForEntity (which also filters to portal-visible statuses).
 * Invalid / no-access IDs redirect back to /portal.
 *
 * Money rule: all figures render as dollar amounts via MoneyDisplay. The
 * invoices.amount column is REAL (dollars) so we convert to cents for the
 * component. Line items are stored in cents directly.
 */

const { id: invoiceId } = Astro.params

if (!invoiceId) {
  return Astro.redirect('/portal')
}

const portalData = await getPortalClient(env.DB, Astro.locals)
if (!portalData) {
  return Astro.redirect('/auth/sign-in')
}
if (!portalData.client) {
  return Astro.redirect('/auth/sign-in?status=no_subscription')
}

const { client } = portalData

const invoiceDetail = await loadPortalInvoiceDetail(
  env.DB,
  portalData.user.org_id,
  client.id,
  invoiceId
)
if (!invoiceDetail) {
  return Astro.redirect('/portal')
}

const { invoice, lineItems, engagement } = invoiceDetail

// Line items drive the "What's included" table. We never fabricate invoice
// content — no generic placeholder rows, no borrow from scope_summary or
// invoice.description. See CLAUDE.md "No fabricated client-facing content"
// (#398). A sent invoice without line items renders no breakdown; the Total
// row still renders. Admin send-gate should prevent this state reaching a
// client, but the page degrades cleanly if it does.

// Money — invoices.amount is dollars (REAL); convert to cents for display.
// The invoice's own amount is the Total so rounding always matches the CTA.
const totalCents = Math.round(invoice.amount * 100)

// Consultant first name threads into the state resolver's next-step copy.
// Null when the engagement has no consultant.
const consultantFirstEarly = engagement?.consultant_name
  ? engagement.consultant_name.trim().split(/\s+/)[0] || engagement.consultant_name
  : null

// Resolve the surface state once, up front. Everything below branches on it.
const surface = resolveInvoiceState(invoice, Astro.url.searchParams, consultantFirstEarly)
const isPaid = surface.state === 'paid'
const isDeclined = surface.state === 'declined'
const isCardExpired = surface.state === 'card_expired'
const isLinkExpired = surface.state === 'expired'
const isErrorState = isDeclined || isCardExpired || isLinkExpired

// CTA is gated on a real Stripe hosted URL. When it is missing or the
// dev-mode sentinel, we render a non-link "Payment link pending" state
// instead of a link to a nonexistent server route (#419 removed the
// previous `/api/invoices/[id]/pay` fallback, which 404'd). Minting the
// checkout session on demand is a separate server feature.
const stripeUrl =
  invoice.stripe_hosted_url && invoice.stripe_hosted_url !== '#dev-mode'
    ? invoice.stripe_hosted_url
    : null
const isPayable = stripeUrl !== null

// Title + period
const typeLabel = invoiceTypeLabel(invoice.type)
const invoiceTitle = typeLabel ? `${typeLabel} invoice` : 'Invoice'
// Subtitle comes only from the invoice's own authored description. We never
// borrow `engagement.scope_summary` — that is an internal operations field,
// not client-facing authored content. Pattern B per CLAUDE.md (#398).
const periodSubtitle = invoice.description ? `For ${invoice.description}` : null

const actionLabel = isDeclined
  ? 'Try again'
  : isCardExpired
    ? 'Update payment method'
    : 'Pay invoice'
const errorTitle = isDeclined ? 'Payment declined' : isCardExpired ? 'Card expired' : 'Link expired'

// The head meta is the one place the dates live (Rule 2): issued, then due
// or paid. No calendar caption restating it below.
const headMeta =
  [
    invoice.sent_at ? `Issued ${formatShortDate(invoice.sent_at)}` : null,
    isPaid && invoice.paid_at ? `Paid ${formatShortDate(invoice.paid_at)}` : null,
    !isPaid && invoice.due_date ? `Due ${formatShortDate(invoice.due_date)}` : null,
  ]
    .filter(Boolean)
    .join('\n') || null
---

<PortalShell
  title="Invoice"
  clientName={client.name}
  orgId={client.org_id}
  entityId={client.id}
  pathname={Astro.url.pathname}
>
  <PortalPageHead
    crumbHref="/portal/billing"
    crumbLabel="Billing"
    tag={`Invoice № ${invoice.id.slice(0, 2).toUpperCase()}${isPaid ? ' · Paid' : ''}`}
    h1={invoiceTitle}
    meta={headMeta}
  />

  {
    periodSubtitle && (
      <p class="mt-6 font-body text-base text-[color:var(--ss-color-text-secondary)]">
        {periodSubtitle}
      </p>
    )
  }

  {
    isErrorState && (
      <div
        role="status"
        class="mt-6 border-[3px] border-[color:var(--ss-color-error)] px-5 py-3 font-mono text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-error)]"
      >
        {errorTitle}. {surface.next}
      </div>
    )
  }

  <PortalDetailTable eyebrow="What's included" label="Invoice lines">
    {
      lineItems.map((li) => (
        <PortalDetailRow label={li.description} align="end">
          <MoneyDisplay amountCents={li.amount_cents} size="body" emphasize />
        </PortalDetailRow>
      ))
    }
    <PortalDetailRow label="Total" align="end" emphasis>
      <MoneyDisplay amountCents={totalCents} size="row" />
    </PortalDetailRow>
  </PortalDetailTable>

  {
    !isPaid &&
      !isLinkExpired &&
      (isPayable ? (
        <div class="mt-8" aria-label={actionLabel}>
          <PortalActionLink href={stripeUrl} label={actionLabel} tone="primary" />
          <p class="mt-3 font-mono text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-secondary)]">
            Opens secure payment on Stripe.
          </p>
        </div>
      ) : (
        <p
          class="mt-8 font-mono text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-secondary)]"
          aria-label="Payment link pending"
        >
          Payment link pending. We will let you know the moment it is ready.
        </p>
      ))
  }
</PortalShell>

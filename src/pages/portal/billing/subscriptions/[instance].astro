---
import { getPortalClient } from '../../../../lib/portal/session'
import PortalShell from '../../../../layouts/PortalShell.astro'
import PortalPageHead from '../../../../components/portal/PortalPageHead.astro'
import MoneyDisplay from '../../../../components/portal/MoneyDisplay.astro'
import SubmitButton from '../../../../components/portal/form/SubmitButton.astro'
import { resolvePortalOfferings } from '../../../../lib/portal/offerings'
import {
  getOperatorSubscriptionByInstance,
  listProductRoles,
} from '../../../../lib/portal/product-access'
import { getOperatorServiceForEntity } from '../../../../lib/db/services'
import { parseCancelAt } from '../../../../lib/db/subscriptions'
import {
  canStartOperatorSubscription,
  operatorMonthlyPriceCents,
  parseStripeCustomerId,
} from '../../../../lib/portal/billing'
import { formatShortDate } from '../../../../lib/portal/formatters'
import { env } from 'cloudflare:workers'

/**
 * The Operator subscription page: the one place the client starts the
 * monthly plan and, once started, manages it. Billing's ledger row, Home's
 * card and the Operator hero all land here; this page carries the single
 * primary action (UI-PATTERNS Rule 3) and states, before the client commits,
 * exactly what the system will do: the authored price, monthly in advance,
 * the payment method chosen at Stripe Checkout, and cancellation at the end
 * of the paid month (both are what the code does: createOperatorCheckoutSession
 * and the Billing Portal configuration, mirrored by setSubscriptionCancelSchedule).
 *
 * Every figure here is authored data (services.recurring_price) or system
 * behaviour. Nothing about the Operator's work, the agreement, or dates we
 * have not recorded is stated (no fabricated client-facing content).
 */

export const prerender = false

const instance = Astro.params.instance
if (!instance) return Astro.redirect('/portal/billing')

const portalData = await getPortalClient(env.DB, Astro.locals)
if (!portalData) {
  return Astro.redirect('/auth/sign-in')
}
if (!portalData.client) {
  return Astro.redirect('/auth/sign-in?status=no_subscription')
}
const { user, client } = portalData

const offerings = await resolvePortalOfferings(env.DB, user.org_id, client.id)
const subscription = await getOperatorSubscriptionByInstance(env.DB, client.id, instance)
// A slug this client does not own reads as absent, never as someone else's.
if (!subscription) return Astro.redirect('/portal/billing')

const operatorName = offerings.operators.find((o) => o.slug === instance)?.displayName ?? 'Operator'

const service = await getOperatorServiceForEntity(env.DB, user.org_id, client.id)
const priceCents = operatorMonthlyPriceCents(service?.recurring_price)
const startable = canStartOperatorSubscription(subscription, priceCents)
const roles = await listProductRoles(env.DB, user.id, client.id, 'operator')
const isPrincipal = roles.includes('principal')
const cancelAt = parseCancelAt(subscription.settings_json)
const stripeCustomerId = parseStripeCustomerId(subscription.settings_json)
const started = subscription.status === 'active' || !!subscription.stripe_subscription_id

const statusLine = startable
  ? 'Not started'
  : cancelAt
    ? `Cancels ${formatShortDate(cancelAt)}`
    : subscription.status === 'active'
      ? `Active since ${formatShortDate(subscription.started_at)}`
      : subscription.status === 'paused'
        ? 'Paused'
        : started
          ? 'Started, first payment settling'
          : 'Being set up'

const rowClass =
  'grid grid-cols-1 gap-1 border-b-[2px] border-[color:var(--ss-color-text-primary)] px-5 py-4 last:border-b-0 md:grid-cols-[minmax(0,14rem)_1fr] md:gap-6 md:px-6'
const keyClass =
  'font-mono text-label font-bold uppercase tracking-[0.14em] text-[color:var(--ss-color-text-secondary)]'
const valClass = 'font-body text-base text-[color:var(--ss-color-text-primary)]'
---

<PortalShell
  title={`${operatorName} subscription`}
  clientName={client.name}
  orgId={user.org_id}
  entityId={client.id}
  pathname={Astro.url.pathname}
  offerings={offerings}
>
  <PortalPageHead
    crumbHref="/portal/billing"
    crumbLabel="Billing"
    h1={`${operatorName} subscription`}
    meta={statusLine}
  />

  <section class="mt-8" aria-label="Terms">
    <p
      class="mb-4 font-mono text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-secondary)]"
    >
      What you are starting
    </p>
    <div class="border-[3px] border-[color:var(--ss-color-text-primary)]">
      <div class={rowClass}>
        <span class={keyClass}>Monthly fee</span>
        <span class={valClass}>
          {
            priceCents !== null ? (
              <>
                <MoneyDisplay amountCents={priceCents} size="row" /> per month
              </>
            ) : (
              'Not yet priced. Write to team@smd.services and we sort it out.'
            )
          }
        </span>
      </div>
      <div class={rowClass}>
        <span class={keyClass}>Billed</span>
        <span class={valClass}>
          Monthly in advance. The first month is paid when you start; each month after that is
          charged automatically to the same payment method.
        </span>
      </div>
      <div class={rowClass}>
        <span class={keyClass}>Payment method</span>
        <span class={valClass}>Bank account or card, chosen at checkout.</span>
      </div>
      <div class={rowClass}>
        <span class={keyClass}>Cancelling</span>
        <span class={valClass}>
          Any time, from this page. Service continues to the end of the month you have paid for, and
          you are not billed again.
        </span>
      </div>
    </div>
  </section>

  {
    startable && isPrincipal && (
      <form
        method="POST"
        action={`/api/portal/products/operator/${instance}/start-subscription`}
        class="mt-8"
        aria-label="Start the subscription"
      >
        <SubmitButton label="Start monthly subscription" tone="primary" />
        <p class="mt-3 font-mono text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-secondary)]">
          Opens secure checkout. Nothing is charged until you complete it there.
        </p>
      </form>
    )
  }

  {
    startable && !isPrincipal && (
      <p class="mt-8 font-body text-base text-[color:var(--ss-color-text-secondary)]">
        A principal on this account starts the subscription.
      </p>
    )
  }

  {
    !startable && stripeCustomerId && (
      <form
        method="POST"
        action="/api/portal/billing/manage"
        class="mt-8"
        aria-label="Manage billing"
      >
        <input type="hidden" name="product_slug" value="operator" />
        <SubmitButton label="Manage billing" tone="neutral" />
        <p class="mt-3 font-mono text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-secondary)]">
          Payment method, receipts, and cancellation, on Stripe.
        </p>
      </form>
    )
  }
</PortalShell>

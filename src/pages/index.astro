---
// SSR required: middleware needs to intercept portal.smd.services requests to this path
// and rewrite them to /portal. The prerendered static file would bypass the Worker entirely.
export const prerender = false

// Home: the firm's face, flagship-forward. Nine beats — firm wraps flagship:
// hero (orient) -> the gap -> the reframe (category claim) -> the Operator (the
// cradled flagship, condensed) -> in practice (real proof, routed to the case study;
// added 2026-09-14) -> solution-first (the firm reasserts) -> find your trade (proof
// by specificity) -> who runs it (Scott, condensed) -> the assessment.
// The deep Operator pitch is on /operator; the firm's operating model is on /book.
// Structure locked in docs/marketing/positioning-spine.md. One door: the assessment.
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import OperatorHero from '../components/OperatorHero.astro'
import Footer from '../components/Footer.astro'
import CtaButton from '../components/CtaButton.astro'
import { serializeJsonLd } from '../lib/seo/json-ld'

const firmSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'SMD Services',
  description:
    'A software and AI solutions firm for small businesses. Every engagement starts with an assessment that finds the right solution, from a recommendation to a focused project to the Operator, our flagship managed worker that does the recurring work between your people and your software.',
  areaServed: 'United States',
  brand: { '@type': 'Brand', name: 'SMD Services' },
  makesOffer: {
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Product',
      name: 'Operator',
      description:
        'A managed worker, built for your business and run by us. It does the recurring connective work between your people and your software, on your own systems, under authority you set, with a memory that belongs to you.',
    },
  },
}

// Beat 5 proof tiles. Each value must appear in docs/marketing/proof-ledger.md with
// its source (guarded in tests/landing-page.test.ts), so a figure cannot drift or be
// invented here.
const proofTiles = [
  { value: '18', label: 'Medical chronologies delivered' },
  { value: '29,000+', label: 'Pages of medical records read' },
  { value: 'Every entry', label: 'Cited to the page it came from' },
]
---

<Base
  title="SMD Services | Software & AI Solutions For Small Business"
  description="A software and AI solutions firm for small businesses, based in Phoenix. We figure out what is slowing you down and build the right solution. Our flagship, the Operator, is a managed worker that does the recurring work between your people and your software. It starts with an assessment."
>
  <Nav />
  <main id="main" role="main">
    <script is:inline type="application/ld+json" set:html={serializeJsonLd(firmSchema)} />

    <OperatorHero />

    <!-- Beat 2: the gap. The problem in the owner's words, before any pitch. -->
    <section class="bg-white px-6 py-24">
      <div class="mx-auto max-w-5xl">
        <p
          class="mb-5 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ss-color-text-secondary)]"
        >
          The Gap
        </p>
        <h2
          class="mb-10 font-body text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]"
        >
          The Work That Falls Between.
        </h2>
        <div class="space-y-8 text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)]">
          <p>
            Your people are good at their jobs. Your software is good at its job. Between them sits
            a layer of work nobody owns: the handoff from one system to the next, the follow-up that
            slips, the step that is everyone's job and no one's.
          </p>
          <p>
            It gets done late, done twice, or not at all, and it usually comes down to a person
            holding it together by hand. That layer is where time and money quietly leak.
          </p>
        </div>
      </div>
    </section>

    <!-- Beat 3: the reframe. The category claim, stated once. Replaces a comparison page. -->
    <section class="bg-[color:var(--ss-color-background)] px-6 py-24">
      <div class="mx-auto max-w-5xl">
        <p
          class="mb-5 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ss-color-text-secondary)]"
        >
          What Makes Us Different
        </p>
        <h2
          class="mb-10 font-body text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]"
        >
          We Hand You The Work, Done.
        </h2>
        <div class="space-y-8 text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)]">
          <p>
            Everyone selling AI to small business hands you one more tool to run. You do not have
            time to run more tools. You need the work done.
          </p>
          <p>
            That is the difference. A managed worker on your own systems, with a memory that belongs
            to you, run by us, and honest enough to tell you when you do not need it.
          </p>
        </div>
      </div>
    </section>

    <!-- Beat 4: the Operator. The cradled flagship, condensed. The pillars + managed. -->
    <section class="bg-white px-6 py-24">
      <div class="mx-auto max-w-5xl">
        <p
          class="mb-5 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ss-color-text-secondary)]"
        >
          The Flagship
        </p>
        <h2
          class="mb-10 font-body text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]"
        >
          Meet The Operator.
        </h2>
        <p
          class="mb-12 max-w-3xl text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)]"
        >
          A new kind of worker, built for your business and given a real role. It comes in knowing
          that role: it carries the recurring connective work on its own, and takes on what you hand
          it, so nothing falls through. Not a person you hire, not a tool you buy.
        </p>

        <div
          class="grid grid-cols-1 md:grid-cols-3 gap-0 border-t-[3px] border-[color:var(--ss-color-text-primary)]"
        >
          {
            [
              {
                t: 'Your accounts',
                b: 'It runs on your own systems and its own isolated infrastructure. Your data stays yours.',
              },
              {
                t: 'Your authority',
                b: 'You decide what it does on its own and what waits for a person. You can change that line anytime, and it never widens its own authority.',
              },
              {
                t: 'Your memory',
                b: 'What it learns about how you run belongs to the business, and it does not walk out the door.',
              },
            ].map((p, i) => (
              <div
                class:list={[
                  'flex flex-col gap-3 p-8 min-h-[13rem] border-b-[3px] border-[color:var(--ss-color-text-primary)]',
                  i % 3 !== 2 && 'md:border-r-[3px] md:border-[color:var(--ss-color-text-primary)]',
                ]}
              >
                <p class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-[color:var(--ss-color-primary)]">
                  {p.t}
                </p>
                <p class="font-body text-base leading-relaxed text-[color:var(--ss-color-text-secondary)]">
                  {p.b}
                </p>
              </div>
            ))
          }
        </div>

        <div
          class="mt-12 space-y-8 text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)]"
        >
          <p>
            And running it is our job, not yours. We build it for your business, wire it into your
            tools, and stay accountable for how it works. A service, not software you have to
            manage.
          </p>
          <p>
            <a
              href="/operator"
              data-ev="home-operator-learn"
              class="inline-flex items-center gap-2 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-[color:var(--ss-color-primary)] hover:text-[color:var(--ss-color-primary-hover)]"
            >
              <span>See how the Operator works</span>
              <span aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      </div>
    </section>

    <!-- Beat 5: in practice. Real proof from the first Operator, anonymized, routed
         to the case study. Figures come from docs/marketing/proof-ledger.md. -->
    <section class="bg-[color:var(--ss-color-background)] px-6 py-24">
      <div class="mx-auto max-w-5xl">
        <p
          class="mb-5 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ss-color-text-secondary)]"
        >
          In Practice
        </p>
        <h2
          class="mb-10 font-body text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]"
        >
          In Use On Real Work.
        </h2>
        <p
          class="mb-12 max-w-3xl text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)]"
        >
          An Operator works today for a plaintiff personal injury firm. Among its jobs: reading
          medical records into cited chronologies whenever the firm asks, at a small fraction of
          what outsourced chronology services charge per page.
        </p>
        <div
          class="grid grid-cols-1 md:grid-cols-3 gap-0 border-t-[3px] border-[color:var(--ss-color-text-primary)]"
        >
          {
            proofTiles.map((t, i) => (
              <div
                class:list={[
                  'flex flex-col gap-3 p-8 border-b-[3px] border-[color:var(--ss-color-text-primary)]',
                  i % 3 !== 2 && 'md:border-r-[3px] md:border-[color:var(--ss-color-text-primary)]',
                ]}
              >
                <p class="font-body text-3xl md:text-4xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-primary)]">
                  {t.value}
                </p>
                <p class="font-body text-base leading-relaxed text-[color:var(--ss-color-text-secondary)]">
                  {t.label}
                </p>
              </div>
            ))
          }
        </div>
        <p class="mt-12">
          <a
            href="/case-studies/personal-injury-law-firm"
            data-ev="home-case-study"
            class="inline-flex items-center gap-2 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-[color:var(--ss-color-primary)] hover:text-[color:var(--ss-color-primary-hover)]"
          >
            <span>Read the case study</span>
            <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </section>

    <!-- Beat 6: solution-first. The firm reasserts. The AI-tension line. -->
    <section class="bg-[color:var(--ss-color-background)] px-6 py-24">
      <div class="mx-auto max-w-5xl">
        <p
          class="mb-5 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ss-color-text-secondary)]"
        >
          Solution First
        </p>
        <h2
          class="mb-10 font-body text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]"
        >
          Not Every Problem Needs An Operator.
        </h2>
        <div class="space-y-8 text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)]">
          <p>
            We specialize in AI, and part of our job is telling you when it is not the answer.
            Sometimes the right fix is a cleaner process, the right tool chosen well, or a single
            integration that makes two systems finally talk.
          </p>
          <p>
            The assessment is how we find out. We recommend what actually fits, whether that is a
            recommendation you can run yourself, a focused project, or a full Operator.
          </p>
        </div>
      </div>
    </section>

    <!-- Beat 7: find your trade. Proof by specificity, routed to the packs index. -->
    <section class="bg-white px-6 py-24">
      <div class="mx-auto max-w-5xl">
        <p
          class="mb-5 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ss-color-text-secondary)]"
        >
          Built Around Your Work
        </p>
        <h2
          class="mb-8 font-body text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]"
        >
          Find Your Trade.
        </h2>
        <p
          class="mb-10 max-w-2xl text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)]"
        >
          The work that falls through takes a recognizable shape in every business. We have mapped
          the seat the Operator fills for law firms, insurance agencies, accounting and advisory
          firms, med spas, home services, and more. Find yours.
        </p>
        <CtaButton variant="secondary" href="/industries" data-ev="home-industries-router"
          >Find your industry</CtaButton
        >
      </div>
    </section>

    <!-- Beat 8: who runs it. Scott, condensed, firm "we" voice (full bio on /about). -->
    <section class="bg-[color:var(--ss-color-background)] px-6 py-24">
      <div class="mx-auto max-w-5xl">
        <p
          class="mb-5 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ss-color-text-secondary)]"
        >
          Who Runs It
        </p>
        <h2
          class="mb-10 font-body text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]"
        >
          A Guide, Not A Vendor.
        </h2>
        <div class="space-y-8 text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)]">
          <p>
            Behind SMD Services is Scott Durgan, who spent two decades building enterprise software
            for Fortune 500 and Fortune 100 companies. The same operational discipline, now for
            businesses that never had access to it.
          </p>
          <p>
            We do not sell you something and leave. This is new ground, and it keeps shifting, so we
            stay in it with you as it does. A vendor hands you a thing and moves on. A guide stays.
          </p>
          <p>
            <a
              href="/about"
              data-ev="home-about-link"
              class="inline-flex items-center gap-2 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-[color:var(--ss-color-primary)] hover:text-[color:var(--ss-color-primary-hover)]"
            >
              <span>More about us</span>
              <span aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      </div>
    </section>

    <!-- Beat 9: the assessment. The one close. -->
    <section class="bg-[color:var(--ss-color-surface-inverse)] px-6 py-24">
      <div class="mx-auto max-w-5xl text-center">
        <p
          class="mb-6 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ss-color-text-muted)]"
        >
          Start Here
        </p>
        <h2
          class="mb-6 font-body text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-white"
        >
          It Starts With An Assessment.
        </h2>
        <p class="mx-auto mb-10 max-w-2xl text-lg text-[color:var(--ss-color-text-muted)]">
          We learn how your business actually runs, find what is costing you the most time, and
          recommend the right solution. If an Operator is not the fit, we say so. You walk away with
          a clear recommendation either way. We are based in Phoenix and work with businesses in the
          Valley and beyond.
        </p>
        <CtaButton variant="outline-white" data-ev="home-final-cta"
          >Start with an assessment</CtaButton
        >
      </div>
    </section>
  </main>
  <Footer />
</Base>

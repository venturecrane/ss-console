---
export const prerender = false

import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import CtaButton from '../components/CtaButton.astro'
import { CATEGORY_NAME, CATEGORY_ARTICLE } from '../lib/category'
import { serializeJsonLd } from '../lib/seo/json-ld'
import { INDUSTRIES } from '../lib/operator-packs/shared'

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Operator',
  description:
    'A dedicated Operator, built for your business and given a real role. It takes on the recurring work, on its own isolated infrastructure, with the operating memory it builds belonging to you.',
  brand: { '@type': 'Brand', name: 'SMD Services' },
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    seller: { '@type': 'Organization', name: 'SMD Services' },
  },
}

// Comparison Q&A (folded from the retired /why page). Doubles as FAQPage schema
// for answer engines and the "how does this compare" searcher. Answer-shaped:
// a direct answer first, then the expansion.
const faqs = [
  {
    q: 'Is the Operator just a chatbot?',
    a: 'No. A chatbot waits for someone to type a question and answers it. The Operator does not wait. Like any worker, it has standing work it does on its own, on a schedule, whether or not anyone messages it: watching for what is slipping, sending the recurring update, moving the work along. And when you do hand it something, it carries it to done, pulling what matters from your systems, drafting in your voice, booking the next step, and logging it where your team can see. A chatbot is a conversation; the Operator is a worker with a job.',
  },
  {
    q: 'Should we build our own AI agent or have one built and run for us?',
    a: 'You can build your own, and some teams do. The cost is rarely the build. It is keeping it working: wiring it into your tools, watching it, fixing what drifts, and keeping up as the technology changes every month. The Operator is built for your business and run for you. You give feedback to a worker instead of taking on a second job operating one.',
  },
  {
    q: 'How is an Operator different from hiring someone?',
    a: 'The honest comparison is against a hire, not against software, because the Operator takes on work you would otherwise hire a person to do. A new hire is capable and still spends months learning your business and your tools while you pay for the ramp. The Operator learns the systems you run quickly, works across them, and what it learns stays with your business instead of leaving when a person does.',
  },
  {
    q: 'Will it replace our people?',
    a: 'No. It takes the connective busywork off your team, the follow-ups and handoffs that eat the day, so your people spend their time on the work only they can do. The goal is to give them their hours back, not to remove them. You decide what the Operator handles and what stays with a person.',
  },
  {
    q: 'Is it safe to let it work on its own?',
    a: 'You set what it can do on its own and what waits for a person to approve. That decision is in writing and you can change it anytime, and the Operator never widens its own authority. Every action it takes is recorded where you can see what it did, when, and why. We build it, run it, and stay accountable for how it works.',
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}

const roleLenses = [
  {
    title: 'Intake and first response',
    body: 'New inquiries, wherever they land. A dispatcher capturing and routing leads for a home services shop, a new-client intake for a professional practice, a front desk taking reservations. It reads the request, pulls the details that matter, drafts the response in your voice, and books the next step.',
  },
  {
    title: 'Keeping work moving',
    body: 'The follow-ups that slip and the handoffs that stall. It watches the work in flight, spots what did not happen, and nudges the right person or drafts the message. Job scheduling for the trades, matter progress for a practice, shift and inventory coordination for a kitchen.',
  },
  {
    title: 'Recurring client communication',
    body: 'The questions you answer the same way every time. Status updates, scheduling, the routine back-and-forth. For each kind of message, you choose whether its draft goes to a reviewer on your team or it goes out on its own.',
  },
]
---

<Base
  title="The Operator: A Managed AI Worker For Small Business | SMD Services"
  description="A dedicated Operator, built for your business and given a real role. It takes on the recurring work, on its own isolated infrastructure, with the operating memory it builds belonging to you. Flat monthly subscription."
>
  <Nav />
  <main id="main" role="main">
    <script is:inline type="application/ld+json" set:html={serializeJsonLd(productSchema)} />
    <script is:inline type="application/ld+json" set:html={serializeJsonLd(faqSchema)} />

    <!-- § 01 Hero -->
    <section
      class="relative overflow-hidden bg-[color:var(--ss-color-background)] px-6 pt-24 pb-32"
    >
      <div class="mx-auto max-w-5xl">
        <p
          class="mb-6 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ss-color-text-secondary)]"
        >
          The Managed Operator
        </p>
        <h1
          class="mb-8 font-body text-5xl md:text-7xl font-black uppercase leading-[1.05] tracking-[-0.03em] text-[color:var(--ss-color-text-primary)]"
        >
          Hire Once.
        </h1>
        <p
          class="mb-12 max-w-2xl text-xl leading-relaxed text-[color:var(--ss-color-text-secondary)]"
        >
          A dedicated worker for your business, in its own office and plugged into your systems. It
          takes on the recurring work, learns how you run, and everything it learns stays yours.
        </p>
        <CtaButton interest="operator" data-ev="operator-hero-cta"
          >Start with an assessment</CtaButton
        >
        <p class="mt-8">
          <a
            href="#compare"
            data-ev="operator-hero-compare"
            class="inline-flex items-center gap-2 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-[color:var(--ss-color-text-secondary)] hover:text-[color:var(--ss-color-text-primary)]"
          >
            <span>New here? See how {CATEGORY_ARTICLE} {CATEGORY_NAME} compares</span>
            <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </section>

    <!-- A worker, in another office. Opens at the concrete picture; the hire comparison lives in #compare below. -->
    <section class="bg-[color:var(--ss-color-background)] px-6 py-24">
      <div class="mx-auto max-w-5xl">
        <p
          class="mb-5 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ss-color-text-secondary)]"
        >
          What It Is
        </p>
        <h2
          class="mb-10 font-body text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]"
        >
          A Worker, In Another Office.
        </h2>
        <div class="space-y-8 text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)]">
          <p>
            There is a gap in most businesses, between your people and your software, where the
            connective work falls through. This is the worker that fills it. Here is how it works.
          </p>
          <p>
            Picture a remote worker from the future, sitting at a desk in your business today. A
            computer, a phone, and access to the systems and processes you already run. Like anyone
            you would hire for the role, it comes in knowing the job. It has standing work it
            carries on its own, on its own schedule, without waiting to be asked, and like anyone on
            your team, you can hand it something new whenever you need to.
          </p>
          <p>
            It works from its own office, the way much of your team already does. The bookkeeper you
            have never met in person. The vendor you email and trade work with every day. This is
            one more of those.
          </p>
          <p>
            What it takes on is the work you would want that role doing, inside the limits you set.
            We get to those limits below.
          </p>
        </div>
      </div>
    </section>

    <!-- § 04 What you actually get -->
    <section class="bg-white px-6 py-24">
      <div class="mx-auto max-w-5xl">
        <p
          class="mb-5 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ss-color-text-secondary)]"
        >
          What You Get
        </p>
        <h2
          class="mb-10 font-body text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]"
        >
          What You Actually Get.
        </h2>
        <div class="space-y-8 text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)]">
          <p>
            You get an Operator, not a tool. We build one for your business, give it a role, and set
            it up in the tools your team already uses.
          </p>
          <p>
            Before it starts, we sit down with you and the people who run the work, and we build it
            around how you operate, so it shows up ready, not green. From there it keeps getting
            sharper, learning from your team's corrections.
          </p>
          <p>
            Say you give it intake. It reads a new inquiry, pulls the details that matter, drafts
            the first reply in your voice, books the call, and logs it where your team can see. The
            work moves the way it always did. The person doing it changed.
          </p>
          <p>
            One dedicated Operator, scoped to a role, picking up the recurring work that fills your
            team's day so they have the room to do the work only they can do.
          </p>
        </div>
      </div>
    </section>

    <!-- In practice: the first Operator's real work, anonymized, routed to the case study.
         Figures come from docs/marketing/proof-ledger.md. -->
    <section class="bg-white px-6 py-24">
      <div class="mx-auto max-w-5xl">
        <p
          class="mb-5 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ss-color-text-secondary)]"
        >
          In Practice
        </p>
        <h2
          class="mb-10 font-body text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]"
        >
          Already Doing The Heavy Reading.
        </h2>
        <div class="space-y-8 text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)]">
          <p>
            For a plaintiff personal injury firm, the Operator reads medical records into cited
            chronologies whenever the firm asks: 18 delivered, from more than 29,000 pages of
            records, each entry tied to the page it came from. An administrator asks by email, and
            the chronology lands back in the case.
          </p>
          <p>
            <a
              href="/case-studies/personal-injury-law-firm"
              data-ev="operator-case-study"
              class="inline-flex items-center gap-2 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-[color:var(--ss-color-primary)] hover:text-[color:var(--ss-color-primary-hover)]"
            >
              <span>Read the case study</span>
              <span aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      </div>
    </section>

    <!-- § 05 One Operator, one memory, all yours -->
    <section class="bg-[color:var(--ss-color-background)] px-6 py-24">
      <div class="mx-auto max-w-5xl">
        <p
          class="mb-5 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ss-color-text-secondary)]"
        >
          Yours To Keep
        </p>
        <h2
          class="mb-10 font-body text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]"
        >
          One Operator, One Memory. All Yours.
        </h2>
        <div
          class="space-y-8 text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)] mb-12"
        >
          <p>
            One Operator for your whole team, not a separate assistant for each person. Everyone
            works with the same Operator, and it gets sharper from everyone's input.
          </p>
          <p>
            The understanding it builds (your voice, your work patterns, the situations it has
            learned to handle) is a record you can read and correct. It belongs to the business, not
            to any one person's account or laptop. When someone moves on, what the Operator knows
            about how you run does not go with them. It stays.
          </p>
          <p>
            The technology underneath keeps improving, and your Operator rides on top of it. You
            hired the Operator, not a version of a tool you have to keep replacing. The memory it
            builds is yours to keep, and it is not locked inside our system.
          </p>
        </div>
        <div>
          <CtaButton variant="secondary" interest="operator" data-ev="operator-section-cta"
            >Start with an assessment</CtaButton
          >
        </div>
      </div>
    </section>

    <!-- § 06 You set the limits, we keep it running -->
    <section class="bg-white px-6 py-24">
      <div class="mx-auto max-w-5xl">
        <p
          class="mb-5 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ss-color-text-secondary)]"
        >
          Control
        </p>
        <h2
          class="mb-10 font-body text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]"
        >
          You Set The Limits. We Keep It Running.
        </h2>
        <div class="space-y-8 text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)]">
          <p>
            Until you authorize them, consequential actions are refused. That includes sending a
            message outside your business, agreeing to something on your behalf, and anything it
            cannot undo, like deleting or removing. What you authorize is in writing, part of the
            service agreement, and yours to change.
          </p>
          <p>
            It starts by watching. We sit it next to the work, let it learn how your team handles
            real situations, and check its judgment against yours. For messages outside your
            business, you choose whether drafts wait for a reviewer on your team or it sends on its
            own, and you can move that line either way. Some lines stay with a person no matter what
            you authorize. Agreeing to something on your behalf, and anything it cannot undo, always
            wait for a person's approval. A message leaving your business that touches money, a
            contract, the scope of work, or a legal matter is held back for a person to review
            instead of sending. The Operator cannot give itself more authority. Only you can. Every
            action it takes is recorded where you can see it: what it did, when, and why.
          </p>
          <p>
            Your data stays yours. The Operator runs on its own isolated infrastructure, on your own
            accounts. We watch that it is healthy and we can see the record of what it did, and we
            do not keep copies of your files and messages. The configuration, the logs, and the off
            switch stay with you.
          </p>
          <p>
            Accountability is built in, not promised. When it works in your mailbox, reading and
            sending run on separate credentials where your mail system supports it. Its record of
            what it did is tamper-evident, and anyone you hand an evidence packet to can check it on
            our <a
              href="/trust"
              class="underline underline-offset-4 hover:text-[color:var(--ss-color-primary)]"
              >trust page</a
            > without asking us. You can pause it from your client portal. And we carry technology errors
            and omissions and cyber coverage, including coverage written for AI. The details are on our
            <a
              href="/security"
              class="underline underline-offset-4 hover:text-[color:var(--ss-color-primary)]"
              >security page</a
            >.
          </p>
          <p>
            And keeping it running is our job, not yours. We wire it into your tools, we watch that
            it stays working, and we stay accountable for it. You are giving feedback to an
            Operator, not taking on a second job managing one.
          </p>
        </div>
      </div>
    </section>

    <!-- § 07 A team, not a tool -->
    <section class="bg-[color:var(--ss-color-background)] px-6 py-24">
      <div class="mx-auto max-w-5xl">
        <p
          class="mb-5 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ss-color-text-secondary)]"
        >
          The Guide
        </p>
        <h2
          class="mb-10 font-body text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]"
        >
          A Team, Not A Tool.
        </h2>
        <div class="space-y-8 text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)]">
          <p>
            We are the team behind the worker. We build it for your business, and we stay
            accountable for how it runs. That work is ours, not yours.
          </p>
          <p>
            The technology moves, and we move with it. No one has ten years of experience with this,
            because it has not been around for ten years. So it is not something you set up once and
            are left to run on your own.
          </p>
          <p>
            This is a service, not a download. We are the team that keeps your business working, and
            nobody should take on something this new alone.
          </p>
        </div>
      </div>
    </section>

    <!-- § 08 Where it fits -->
    <section class="bg-white px-6 py-24">
      <div class="mx-auto max-w-5xl">
        <p
          class="mb-5 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ss-color-text-secondary)]"
        >
          Where It Fits
        </p>
        <h2
          class="mb-6 font-body text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]"
        >
          Where It Fits.
        </h2>
        <p
          class="mb-12 max-w-2xl text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)]"
        >
          A few shapes the role can take. We build it around your operation, so these are starting
          points, not a menu.
        </p>

        <div
          class="grid grid-cols-1 md:grid-cols-3 gap-0 border-t-[3px] border-[color:var(--ss-color-text-primary)]"
        >
          {
            roleLenses.map((lens, i) => (
              <div
                class:list={[
                  'flex flex-col gap-4 p-8 min-h-[16rem] border-b-[3px] border-[color:var(--ss-color-text-primary)]',
                  i % 3 !== 2 && 'md:border-r-[3px] md:border-[color:var(--ss-color-text-primary)]',
                ]}
              >
                <p class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-[color:var(--ss-color-primary)]">
                  {lens.title}
                </p>
                <p class="font-body text-base leading-relaxed text-[color:var(--ss-color-text-secondary)]">
                  {lens.body}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- § 09 Built for your industry -->
    <section id="industries" class="bg-[color:var(--ss-color-background)] px-6 py-24 scroll-mt-20">
      <div class="mx-auto max-w-5xl">
        <p
          class="mb-5 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ss-color-text-secondary)]"
        >
          Industries
        </p>
        <h2
          class="mb-6 font-body text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]"
        >
          Built For Your Industry.
        </h2>
        <p
          class="mb-12 max-w-2xl text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)]"
        >
          The role is built around your operation. For these, we have already mapped where the
          Operator fits: the seat it fills, the work it takes on, and the line it does not cross.
          That is a starting point to react to and shape together, not the only way it can run. Find
          yours.
        </p>

        <div
          class="grid grid-cols-1 md:grid-cols-3 gap-0 border-t-[3px] border-[color:var(--ss-color-text-primary)]"
        >
          {
            INDUSTRIES.map((industry, i) => (
              <a
                href={`/packs/${industry.slug}`}
                data-ev={`operator-industry-${industry.slug}`}
                class:list={[
                  'group flex flex-col gap-2 p-8 min-h-[10rem] border-b-[3px] border-[color:var(--ss-color-text-primary)] transition-colors hover:bg-white',
                  i % 3 !== 2 && 'md:border-r-[3px] md:border-[color:var(--ss-color-text-primary)]',
                ]}
              >
                <p class="font-body text-lg font-black uppercase tracking-[-0.01em] text-[color:var(--ss-color-text-primary)] group-hover:text-[color:var(--ss-color-primary)]">
                  {industry.name}
                </p>
                <p class="font-body text-base leading-relaxed text-[color:var(--ss-color-text-secondary)]">
                  {industry.seat}
                </p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Comparison: how the Operator compares to the alternatives. Folded from the
         retired /why page; mirrors the FAQPage schema above. The answer-engine surface. -->
    <section id="compare" class="bg-white px-6 py-24 scroll-mt-20">
      <div class="mx-auto max-w-5xl">
        <p
          class="mb-5 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ss-color-text-secondary)]"
        >
          Straight Answers
        </p>
        <h2
          class="mb-12 font-body text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]"
        >
          How It Compares.
        </h2>
        <div
          class="divide-y-[3px] divide-[color:var(--ss-color-text-primary)] border-y-[3px] border-[color:var(--ss-color-text-primary)]"
        >
          {
            faqs.map((f) => (
              <div class="py-8">
                <h3 class="mb-4 max-w-3xl font-body text-xl md:text-2xl font-black uppercase tracking-[-0.01em] text-[color:var(--ss-color-text-primary)]">
                  {f.q}
                </h3>
                <p class="max-w-3xl text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)]">
                  {f.a}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- § 10 Start with an assessment -->
    <section class="bg-[color:var(--ss-color-surface-inverse)] px-6 py-24">
      <div class="mx-auto max-w-5xl text-center">
        <p
          class="mb-6 font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ss-color-text-muted)]"
        >
          Start Here
        </p>
        <h2
          class="mb-6 font-body text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-white"
        >
          It Starts With An Assessment.
        </h2>
        <p class="mx-auto mb-6 max-w-2xl text-lg text-[color:var(--ss-color-text-muted)]">
          We learn how your operation runs, find the work that is eating your team's time, and
          figure out where a dedicated Operator fits. If the fit is not right, we say so.
        </p>
        <p class="mx-auto mb-10 max-w-2xl text-lg text-[color:var(--ss-color-text-muted)]">
          Pricing is a flat monthly subscription, scoped to the role we build together, with a clear
          allowance for the heavy work set in your agreement, and we walk through it before any
          setup begins. No hourly billing, and nothing on an invoice you did not agree to first.
        </p>
        <CtaButton variant="outline-white" interest="operator" data-ev="operator-final-cta"
          >Start with an assessment</CtaButton
        >
      </div>
    </section>
  </main>
  <Footer />
</Base>

---
import Base from '../../layouts/Base.astro'
import AuthHeader from '../../components/AuthHeader.astro'
import Footer from '../../components/Footer.astro'
import { SignUp } from '@clerk/astro/components'
import { clerkAppearance } from '../../lib/auth/clerk-appearance'
import { safeRedirectPath } from '../../lib/auth/auth-redirect'

/**
 * Unified account creation. Same Clerk-backed identity used by both
 * admins and clients; role is determined by the local users.role column
 * (default 'client' for JIT-created rows; admins are provisioned by
 * Captain via a one-time SQL update that sets clerk_user_id on the
 * existing admin row).
 *
 * Most portal users arrive here from an Organization-invitation email
 * (Clerk's invite flow pre-populates the email field). Direct discovery
 * of this URL is rare but supported.
 *
 * `?redirect_url=` (ADR 0067): the Hosted Agent checkout entry sends
 * unauthenticated buyers here and needs the checkout intent to survive
 * account creation. Only same-origin absolute paths are honored (must
 * start with a single '/'); anything else falls back to the standard
 * after-sign-in route. An invitation link's `__clerk_ticket` stays on this
 * page's URL, where <SignUp> reads it to accept the invitation
 * (src/lib/auth/auth-redirect.ts carries it here from the auth gate).
 */

const returnPath = safeRedirectPath(Astro.url.searchParams.get('redirect_url'))
const redirectUrl = returnPath ?? '/auth/after-sign-in'
const signInUrl = returnPath
  ? `/auth/sign-in?redirect_url=${encodeURIComponent(returnPath)}`
  : '/auth/sign-in'
---

<Base title="Create Account | SMD Services" disableAnalytics={true}>
  <div class="flex min-h-screen flex-col bg-[color:var(--ss-color-background)]">
    <AuthHeader crossLinkHref="/auth/sign-in" crossLinkLabel="Sign in" />

    <main
      id="main"
      role="main"
      class="flex-1 flex items-start md:items-center justify-center px-4 py-10 md:py-16"
    >
      <div class="w-full max-w-sm">
        <p
          class="mb-6 text-center font-mono text-label uppercase tracking-[0.18em] font-bold text-[color:var(--ss-color-text-secondary)]"
        >
          Create your account
        </p>

        <SignUp
          signInUrl={signInUrl}
          fallbackRedirectUrl={redirectUrl}
          forceRedirectUrl={redirectUrl}
          appearance={clerkAppearance}
        />
      </div>
    </main>

    <Footer />
  </div>
</Base>

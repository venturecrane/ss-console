---
import Base from '../../layouts/Base.astro'
import AuthHeader from '../../components/AuthHeader.astro'
import Footer from '../../components/Footer.astro'
import { SignIn, SignOutButton } from '@clerk/astro/components'
import { clerkAppearance } from '../../lib/auth/clerk-appearance'
import { safeRedirectPath } from '../../lib/auth/auth-redirect'

/**
 * Unified sign-in. Single entry point for both admins and clients.
 *
 * Clerk's SignIn component handles email + password, email verification
 * code (passwordless fallback), and Organization-invitation acceptance
 * natively. After authentication Clerk redirects to /auth/after-sign-in,
 * which inspects the user's role in the local users table and routes
 * to admin.smd.services or portal.smd.services accordingly.
 *
 * `?redirect_url=` (a safe same-origin path only, auth-redirect.ts) is passed
 * THROUGH /auth/after-sign-in rather than to Clerk directly, so the local-user
 * link and login stamp still run; the dispatcher honors it only when it falls
 * under the surface it picked. Clerk's `__clerk_ticket` (invitation) stays on
 * this page's URL, where <SignIn> reads it.
 *
 * Wrapped in the standard site chrome (Base layout + AuthHeader + Footer)
 * so the auth surface matches marketing and admin.
 */

const status = Astro.url.searchParams.get('status')

const statusMessages: Record<string, { text: string; type: 'success' | 'error' }> = {
  no_subscription: {
    text:
      "You're signed in, but your account isn't connected to a customer yet. " +
      'Contact us if you think this is an error.',
    type: 'error',
  },
  signed_out: {
    text: 'You have been signed out.',
    type: 'success',
  },
}

const message = status ? statusMessages[status] : null

const returnPath = safeRedirectPath(Astro.url.searchParams.get('redirect_url'))
const afterSignInUrl = returnPath
  ? `/auth/after-sign-in?redirect_url=${encodeURIComponent(returnPath)}`
  : '/auth/after-sign-in'
const signUpUrl = returnPath
  ? `/auth/sign-up?redirect_url=${encodeURIComponent(returnPath)}`
  : '/auth/sign-up'
---

<Base title="Sign In | SMD Services" disableAnalytics={true}>
  <div class="flex min-h-screen flex-col bg-[color:var(--ss-color-background)]">
    <AuthHeader crossLinkHref="/auth/sign-up" crossLinkLabel="Create account" />

    <main
      id="main"
      role="main"
      class="flex-1 flex items-start md:items-center justify-center px-4 py-10 md:py-16"
    >
      <div class="w-full max-w-sm">
        <p
          class="mb-6 text-center font-mono text-label uppercase tracking-[0.18em] font-bold text-[color:var(--ss-color-text-secondary)]"
        >
          Sign in
        </p>

        {
          message && (
            <div
              class:list={[
                'mb-4 px-3 py-2 border-[3px] text-sm',
                message.type === 'success'
                  ? 'border-[color:var(--ss-color-complete)] bg-[color:var(--ss-color-complete)]/10 text-[color:var(--ss-color-complete)]'
                  : 'border-[color:var(--ss-color-error)] bg-[color:var(--ss-color-error)]/10 text-[color:var(--ss-color-error)]',
              ]}
            >
              {message.text}
            </div>
          )
        }

        {
          status === 'no_subscription' && (
            <div class="mb-6 text-center">
              <SignOutButton asChild redirectUrl="/auth/sign-in">
                <button
                  type="button"
                  class="inline-flex items-center min-h-11 px-3 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-[color:var(--ss-color-text-secondary)] hover:text-[color:var(--ss-color-text-primary)] active:text-[color:var(--ss-color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2 underline underline-offset-4"
                >
                  Sign out and try a different account
                </button>
              </SignOutButton>
            </div>
          )
        }

        <SignIn
          signUpUrl={signUpUrl}
          fallbackRedirectUrl={afterSignInUrl}
          forceRedirectUrl={afterSignInUrl}
          appearance={clerkAppearance}
        />
      </div>
    </main>

    <Footer />
  </div>
</Base>

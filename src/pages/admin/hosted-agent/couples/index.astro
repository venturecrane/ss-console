---
/**
 * Couples instances (ADR 0090 role `couples`): the list and the create form.
 *
 * Creating an instance writes the entity, an SMD-paid subscription at
 * `provisioning` and both partner rows. It sends nothing; each partner is
 * invited by an explicit action on the instance page.
 */
import AdminLayout from '../../../../layouts/AdminLayout.astro'
import { listCouplesInstances } from '../../../../lib/db/couples-onboarding'
import { env } from 'cloudflare:workers'

const instances = await listCouplesInstances(env.DB)
const st = Astro.url.searchParams.get('st')
const banner =
  st === 'invalid'
    ? 'Rejected: every field is required, the two emails must differ, and the agent name is letters only.'
    : st === 'error'
      ? 'Creating the instance failed. Check logs.'
      : null

const input =
  'mt-1 border-[3px] border-[color:var(--ss-color-text-primary)] px-3 py-2 font-body text-base normal-case'
const label = 'flex flex-col font-mono text-label uppercase tracking-[0.14em] font-bold'
---

<AdminLayout
  title="Couples Instances"
  breadcrumbs={[
    { label: 'Home', href: '/admin' },
    { label: 'Hosted Agent', href: '/admin/hosted-agent' },
    { label: 'Couples' },
  ]}
  maxWidth="max-w-6xl"
>
  {
    banner && (
      <div
        role="status"
        class="mb-6 border-[3px] border-[color:var(--ss-color-text-primary)] px-5 py-3 font-mono text-label uppercase tracking-[0.14em] font-bold"
      >
        {banner}
      </div>
    )
  }

  <section class="border-[3px] border-[color:var(--ss-color-text-primary)] p-5 md:p-6">
    <h2 class="font-body text-xl font-black uppercase tracking-[-0.02em]">Instances</h2>
    {
      instances.length === 0 ? (
        <p class="mt-3 text-base text-[color:var(--ss-color-text-secondary)]">None yet.</p>
      ) : (
        <ul class="mt-3 flex flex-col gap-2">
          {instances.map((i) => (
            <li>
              <a class="underline font-bold" href={`/admin/hosted-agent/couples/${i.id}`}>
                {i.entity_name}
              </a>
              <span class="font-mono text-sm">
                {' '}
                · {i.agent_name ?? 'no agent name'} · slug {i.customer_slug ?? 'unassigned'} ·{' '}
                {i.status}
              </span>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section class="mt-6 border-[3px] border-[color:var(--ss-color-text-primary)] p-5 md:p-6">
    <h2 class="font-body text-xl font-black uppercase tracking-[-0.02em]">New instance</h2>
    <p class="mt-2 text-base text-[color:var(--ss-color-text-secondary)]">
      SMD-paid proof of concept: no checkout. Nothing is sent when you create it.
    </p>
    <form
      method="POST"
      action="/api/admin/hosted-agent/couples"
      class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4"
    >
      <label class={label}
        >Couple name<input name="couple_name" required maxlength="120" class={input} /></label
      >
      <label class={label}
        >Agent name<input name="agent_name" required maxlength="40" class={input} /></label
      >
      <label class={label}
        >Partner 1 name<input name="p1_name" required maxlength="80" class={input} /></label
      >
      <label class={label}
        >Partner 1 email<input name="p1_email" type="email" required class={input} /></label
      >
      <label class={label}
        >Partner 2 name<input name="p2_name" required maxlength="80" class={input} /></label
      >
      <label class={label}
        >Partner 2 email<input name="p2_email" type="email" required class={input} /></label
      >
      <div class="md:col-span-2">
        <button
          type="submit"
          class="px-6 py-3 border-[3px] border-[color:var(--ss-color-text-primary)] font-bold uppercase tracking-[0.08em]"
        >
          Create instance
        </button>
      </div>
    </form>
  </section>
</AdminLayout>

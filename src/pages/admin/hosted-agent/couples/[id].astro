---
/**
 * One couples instance: onboarding state per partner and the SMD actions
 * (ADR 0090 decision 4, ADR 0091 s5).
 *
 * Per partner: invited, signed in, consented, Telegram linked. Joint section:
 * current version and who confirmed it. Seat: slug, bot username, shared
 * group. Generator: what still blocks a customer.yaml, and the command that
 * produces the reviewed PR.
 */
import AdminLayout from '../../../../layouts/AdminLayout.astro'
import { getCouplesOnboardingStatus } from '../../../../lib/hosted-agent/couples/status'
import { env } from 'cloudflare:workers'

const id = Astro.params.id ?? ''
const status = await getCouplesOnboardingStatus(env.DB, id)
if (!status) {
  return Astro.redirect('/admin/hosted-agent/couples')
}
const { instance, people, joint, blockers, pending } = status

const st = Astro.url.searchParams.get('st')
const banners: Record<string, string> = {
  created: 'Instance created. Nothing has been sent.',
  invited: 'Invitation sent.',
  already_invited: 'That partner already has a pending invitation.',
  already_member: 'That partner is already a member.',
  invite_failed: 'The invitation failed. Check Sentry.',
  no_clerk_user: 'Your admin account has no Clerk identity to send invitations from.',
  saved: 'Saved.',
  slug_saved: 'Customer slug assigned.',
  activated: 'Seat activated and the go-live email sent to both partners.',
  invalid: 'Rejected: check the field and try again.',
  error: 'The action failed. Check logs.',
}
const banner = st ? (banners[st] ?? null) : null

const yesNo = (v: string | null): string => (v ? `yes, ${v} UTC` : 'no')
const confirmedAt = (personId: string): string =>
  joint && joint.confirmedAt[personId] ? `${joint.confirmedAt[personId]} UTC` : 'no'

const box = 'border-[3px] border-[color:var(--ss-color-text-primary)] p-5 md:p-6'
const h2 = 'font-body text-xl font-black uppercase tracking-[-0.02em]'
const dt = 'font-mono font-bold uppercase text-label tracking-[0.14em]'
const input =
  'mt-1 border-[3px] border-[color:var(--ss-color-text-primary)] px-3 py-2 font-mono text-sm normal-case'
const label = 'flex flex-col font-mono text-label uppercase tracking-[0.14em] font-bold'
const button =
  'px-5 py-2 border-[3px] border-[color:var(--ss-color-text-primary)] font-bold uppercase tracking-[0.08em]'
---

<AdminLayout
  title={instance.entity_name}
  breadcrumbs={[
    { label: 'Home', href: '/admin' },
    { label: 'Hosted Agent', href: '/admin/hosted-agent' },
    { label: 'Couples', href: '/admin/hosted-agent/couples' },
    { label: instance.entity_name },
  ]}
  maxWidth="max-w-6xl"
>
  {
    banner && (
      <div
        role="status"
        class="mb-6 border-[3px] border-[color:var(--ss-color-text-primary)] px-5 py-3 font-mono text-label uppercase tracking-[0.14em] font-bold"
      >
        {banner}
      </div>
    )
  }

  <section class={box}>
    <h2 class={h2}>Partners</h2>
    <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        people.map((p) => (
          <dl class="flex flex-col gap-2">
            <div>
              <dt class={dt}>{p.person_key}</dt>
              <dd>
                {p.name} · <span class="font-mono">{p.email}</span>
              </dd>
            </div>
            <div>
              <dt class={dt}>Invited</dt>
              <dd>{yesNo(p.invited_at)}</dd>
            </div>
            <div>
              <dt class={dt}>Signed in</dt>
              <dd>{p.user_id ? 'yes' : 'no'}</dd>
            </div>
            <div>
              <dt class={dt}>Consent</dt>
              <dd>
                {yesNo(p.consent_at)}
                {p.consent_version ? ` (${p.consent_version})` : ''}
              </dd>
            </div>
            <div>
              <dt class={dt}>Telegram</dt>
              <dd>
                {p.telegram_id ? (
                  <>
                    <span class="font-mono">{p.telegram_id}</span>, linked {p.telegram_bound_at} UTC
                  </>
                ) : (
                  'not connected (optional)'
                )}
              </dd>
            </div>
            <div>
              <dt class={dt}>Confirmed current joint settings</dt>
              <dd>{confirmedAt(p.id)}</dd>
            </div>
            <form method="POST" action={`/api/admin/hosted-agent/couples/${instance.id}/invite`}>
              <input type="hidden" name="person_id" value={p.id} />
              <button type="submit" class={button}>
                {p.invited_at ? 'Resend invitation' : 'Send invitation'}
              </button>
            </form>
          </dl>
        ))
      }
    </div>
  </section>

  <section class={`mt-6 ${box}`}>
    <h2 class={h2}>Joint settings</h2>
    {
      joint ? (
        <>
          <p class="mt-2">
            Version {joint.version}, saved {joint.updatedAt} UTC.{' '}
            {joint.final ? 'Final: confirmed by both.' : 'Not final.'}
          </p>
          <pre class="mt-3 overflow-x-auto font-mono text-sm whitespace-pre-wrap">
            {JSON.stringify(joint.settings, null, 2)}
          </pre>
        </>
      ) : (
        <p class="mt-2">Nothing saved yet.</p>
      )
    }
  </section>

  <section class={`mt-6 ${box}`}>
    <h2 class={h2}>Seat</h2>
    <dl class="mt-3 grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <dt class={dt}>Customer slug</dt>
        <dd class="font-mono">{instance.customer_slug ?? 'unassigned'}</dd>
      </div>
      <div>
        <dt class={dt}>Telegram bot</dt>
        <dd class="font-mono">{instance.telegram_bot_username ?? 'not recorded'}</dd>
      </div>
      <div>
        <dt class={dt}>Shared group chat id</dt>
        <dd class="font-mono">{instance.shared_telegram_chat ?? 'not recorded'}</dd>
      </div>
    </dl>
    {
      !instance.customer_slug && (
        <form
          method="POST"
          action={`/api/admin/hosted-agent/${instance.id}/assign-slug`}
          class="mt-4 flex flex-wrap items-end gap-3"
        >
          <input
            type="hidden"
            name="return_to"
            value={`/admin/hosted-agent/couples/${instance.id}`}
          />
          <label class={label}>
            Assign customer slug
            <input name="customer_slug" required pattern="[a-z0-9][a-z0-9-]{0,31}" class={input} />
          </label>
          <button type="submit" class={button}>
            Assign
          </button>
        </form>
      )
    }
    <form
      method="POST"
      action={`/api/admin/hosted-agent/couples/${instance.id}/telegram`}
      class="mt-4 flex flex-wrap items-end gap-3"
    >
      <label class={label}>
        Bot username (from BotFather)
        <input name="bot_username" placeholder="example_bot" class={input} />
      </label>
      <label class={label}>
        Shared group chat id (negative)
        <input name="shared_telegram_chat" placeholder="-1001234567890" class={input} />
      </label>
      <button type="submit" class={button}>Save</button>
    </form>
  </section>

  {
    instance.customer_slug && instance.status !== 'live' && instance.status !== 'cancelled' && (
      <section class={`mt-6 ${box}`}>
        <h2 class={h2}>Go live</h2>
        <p class="mt-2">
          Run after the seat is provisioned and its boot smoke test passes. Sends the go-live email
          to both partners at their authored addresses.
        </p>
        <form
          method="POST"
          action={`/api/admin/hosted-agent/${instance.id}/activate`}
          class="mt-4 flex flex-col gap-3"
        >
          <input
            type="hidden"
            name="return_to"
            value={`/admin/hosted-agent/couples/${instance.id}`}
          />
          <label class={label}>
            Channel details (authored for this couple, rendered verbatim)
            <textarea name="channel_details" required rows="4" class={input} />
          </label>
          <button type="submit" class={button}>
            Activate
          </button>
        </form>
      </section>
    )
  }

  <section class={`mt-6 ${box}`}>
    <h2 class={h2}>Seat config (customer.yaml)</h2>
    {
      blockers.length === 0 ? (
        <p class="mt-2">Ready to generate.</p>
      ) : (
        <ul class="mt-2 list-disc pl-6">
          {blockers.map((b) => (
            <li>{b}</li>
          ))}
        </ul>
      )
    }
    {
      pending.length > 0 && (
        <>
          <p class="mt-3 font-bold">Optional, not set up (never blocks):</p>
          <ul class="mt-1 list-disc pl-6">
            {pending.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </>
      )
    }
    <p class="mt-3">
      Generate from a checkout of ss-console (opens a PR for review, never merges):
    </p>
    <pre
      class="mt-2 font-mono text-sm whitespace-pre-wrap">npx tsx scripts/couples-seat.ts --intake {instance.id} --open-pr</pre>
    <p class="mt-2 text-sm text-[color:var(--ss-color-text-secondary)]">
      Runbook: docs/runbooks/hosted-agent/couples-onboarding.md
    </p>
  </section>
</AdminLayout>

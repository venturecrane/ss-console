---
/**
 * Hosted Agent — concierge queue (ADR 0067).
 *
 * One card per purchase (HostedAgentQueueCard), copy-paste-ready for
 * customer.yaml authoring from operator/customers/_hosted-template/. The
 * two admin actions live on the card:
 *
 *   assign slug — unlocks the customer's key form (the write needs a
 *                 per-customer vault path) and names the Fly app
 *   activate    — flips subscription active + intake live and sends the
 *                 authored go-live email. Run AFTER reprovision.sh and the
 *                 boot smoke test pass; the button does not provision.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro'
import HostedAgentQueueCard from '../../../components/admin/HostedAgentQueueCard.astro'
import { listHostedAgentQueue } from '../../../lib/db/hosted-agent-intake'
import { env } from 'cloudflare:workers'

const queue = await listHostedAgentQueue(env.DB)

const st = Astro.url.searchParams.get('st')
const banner =
  st === 'slug_saved'
    ? 'Customer slug assigned.'
    : st === 'activated'
      ? 'Seat activated and the go-live email sent.'
      : st === 'invalid'
        ? 'That action was rejected: check the fields and try again.'
        : st === 'error'
          ? 'The action failed. Check logs.'
          : null

const openStatuses = new Set(['awaiting_intake', 'intake_submitted', 'provisioning'])
const openCount = queue.filter((r) => openStatuses.has(r.status)).length
---

<AdminLayout
  title="Hosted Agent Queue"
  breadcrumbs={[{ label: 'Home', href: '/admin' }, { label: 'Hosted Agent' }]}
  maxWidth="max-w-6xl"
>
  {
    banner && (
      <div
        role="status"
        class="mb-6 border-[3px] border-[color:var(--ss-color-text-primary)] px-5 py-3 font-mono text-label uppercase tracking-[0.14em] font-bold"
      >
        {banner}
      </div>
    )
  }

  <p class="text-base text-[color:var(--ss-color-text-secondary)]">
    {queue.length} purchase{queue.length === 1 ? '' : 's'} · {openCount} open work item{
      openCount === 1 ? '' : 's'
    }. Runbook: docs/runbooks/hosted-agent/concierge.md
  </p>

  <div class="mt-6 flex flex-col gap-6">
    {queue.map((row) => <HostedAgentQueueCard row={row} />)}
    {
      queue.length === 0 && (
        <p class="text-base text-[color:var(--ss-color-text-secondary)]">No purchases yet.</p>
      )
    }
  </div>
</AdminLayout>

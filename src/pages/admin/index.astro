---
/**
 * Home — the admin launchpad (ADR 0046).
 *
 * Action-first: "Needs you today" leads, then the two revenue shapes,
 * then the motion cards (Delivery / Fleet) that each
 * summarize a surface and jump to it. A launchpad, not a workspace —
 * every tile composes from the surfaces beneath and deep-links; you
 * orient here and leave. Composes from the same helpers the Services and
 * Billing surfaces use.
 */
import AdminLayout from '../../layouts/AdminLayout.astro'
import { listFollowUps } from '../../lib/db/follow-ups'
import { listEngagements } from '../../lib/db/engagements'
import { listEntities } from '../../lib/db/entities'
import { listInvoices } from '../../lib/db/invoices'
import { listQuotes } from '../../lib/db/quotes'
import type { Quote } from '../../lib/db/quotes'
import { listFleetRoster } from '../../lib/admin/fleet-roster'
import { listRuntimeSummary } from '../../lib/admin/runtime-summary'
import { listOperatorSeatCommercials } from '../../lib/db/services'
import {
  buildServiceList,
  serviceListStats,
  type OperatorInput,
} from '../../lib/admin/services-list'
import { oneTimeTotals, operatorRecurring, seatLines } from '../../lib/admin/billing-view'
import { buildActionQueue } from '../../lib/admin/home-actions'
import { formatMoney } from '../../lib/admin/client-hub'
import { env } from 'cloudflare:workers'

const session = Astro.locals.session!
const now = new Date()

const [overdueFollowUps, invoices, engagements, quotes, entities, roster, runtime, operatorSeats] =
  await Promise.all([
    listFollowUps(env.DB, session.orgId, { overdue: true }),
    listInvoices(env.DB, session.orgId),
    listEngagements(env.DB, session.orgId),
    listQuotes(env.DB, session.orgId),
    listEntities(env.DB, session.orgId),
    listFleetRoster(env.DB),
    listRuntimeSummary(env.DB),
    listOperatorSeatCommercials(env.DB, session.orgId),
  ])

const nameById = new Map(entities.map((e) => [e.id, e.name]))
const quotesById = new Map<string, Quote>(quotes.map((q) => [q.id, q]))
const runtimeByEntity = new Map(runtime.map((r) => [r.entity_id, r]))

// Real MRR: authoritative roster, each SEAT priced from the service it points
// at (ADR 0046 operator arc; migration 0126), each service counted once.
const lineBySeat = seatLines(operatorSeats)
const recurring = operatorRecurring(
  roster.map((r) => r.customer_slug),
  lineBySeat
)

const operators: OperatorInput[] = roster.map((r) => ({
  entityId: r.entity_id,
  clientName: r.entity_name ?? r.customer_slug,
  configError: r.config_error,
  openAlerts: runtimeByEntity.get(r.entity_id)?.open_alerts ?? null,
  hasRuntime: runtimeByEntity.has(r.entity_id),
  recurringPrice: lineBySeat.get(r.customer_slug)?.price ?? null,
}))

const services = buildServiceList({
  engagements,
  entityName: (id) => nameById.get(id) ?? '—',
  quotesById,
  operators,
  now,
})
const deliveryStats = serviceListStats(services)
const atRiskServices = services.filter((s) => s.riskTone !== 'muted')

const totals = oneTimeTotals(invoices)
const overdueInvoices = invoices.filter((i) => i.status === 'overdue')

const actions = buildActionQueue({
  overdueInvoices,
  atRiskServices,
  overdueFollowUpCount: overdueFollowUps.length,
  clientName: (id) => nameById.get(id) ?? '—',
})

const fleetAlerting = operators.filter((o) => (o.openAlerts ?? 0) > 0).length
const fleetHealthy = roster.length - fleetAlerting

const toneDot: Record<string, string> = {
  alert: 'bg-[color:var(--ss-color-error)]',
  warn: 'bg-[color:var(--ss-color-primary)]',
  muted: 'bg-[color:var(--ss-color-text-muted)]',
}
const dateLabel = now.toLocaleDateString('en-US', {
  weekday: 'short',
  month: 'short',
  day: 'numeric',
  year: 'numeric',
})

const LAB =
  'font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-[color:var(--ss-color-text-secondary)]'
const SEC =
  'font-mono text-[12px] font-bold uppercase tracking-[0.16em] text-[color:var(--ss-color-text-primary)]'
const CARD_LINK =
  'font-mono text-[10px] font-bold uppercase tracking-[0.1em] text-[color:var(--ss-color-primary)]'

interface MotionCard {
  label: string
  href: string
  jump: string
  rows: { k: string; n: string | number; tone?: 'alert' | 'good' }[]
}
const motion: MotionCard[] = [
  {
    label: 'Delivery',
    href: '/admin/services',
    jump: 'Services →',
    rows: [
      { k: 'In motion', n: deliveryStats.inMotion },
      { k: 'At risk', n: deliveryStats.atRisk, tone: 'alert' },
      { k: 'Consulting', n: deliveryStats.consulting },
    ],
  },
  {
    label: 'Fleet',
    href: '/admin/operator',
    jump: 'Operator →',
    rows: [
      { k: 'Operators', n: roster.length },
      { k: 'Healthy', n: fleetHealthy, tone: 'good' },
      { k: 'Alerting', n: fleetAlerting, tone: 'alert' },
    ],
  },
]
---

<AdminLayout title="Home | SMD Services" maxWidth="max-w-6xl">
  <div class="mb-6 flex items-baseline justify-between">
    <h1 class="text-2xl font-bold text-[color:var(--ss-color-text-primary)]">Home</h1>
    <span class="font-mono text-[13px] text-[color:var(--ss-color-text-muted)]">{dateLabel}</span>
  </div>

  <!-- needs you today -->
  <div class="mb-7 border border-[color:var(--ss-color-text-primary)]">
    <div
      class="flex items-baseline justify-between border-b border-[color:var(--ss-color-text-primary)] px-[18px] py-3.5"
    >
      <span class={SEC}>Needs you today</span>
      <span class="font-mono text-[12px] text-[color:var(--ss-color-text-muted)]"
        >{actions.length} {actions.length === 1 ? 'item' : 'items'}</span
      >
    </div>
    {
      actions.length === 0 ? (
        <p class="px-[18px] py-6 text-sm text-[color:var(--ss-color-text-muted)]">
          Nothing needs you right now.
        </p>
      ) : (
        actions.map((a) => (
          <a
            href={a.href}
            class="grid grid-cols-[18px_110px_1fr_auto] items-center gap-3.5 border-t border-[color:var(--ss-color-border-subtle)] px-[18px] py-3 transition-colors first:border-t-0 hover:bg-[rgba(26,21,18,0.025)]"
          >
            <span class:list={['h-2 w-2 rounded-full', toneDot[a.tone]]} />
            <span class="font-mono text-[11px] font-bold uppercase tracking-[0.1em] text-[color:var(--ss-color-text-muted)]">
              {a.type}
            </span>
            <span class="text-sm text-[color:var(--ss-color-text-primary)]">{a.text}</span>
            <span class={CARD_LINK}>View →</span>
          </a>
        ))
      )
    }
  </div>

  <!-- money: two revenue shapes -->
  <div class="mb-7 grid grid-cols-2 border border-[color:var(--ss-color-text-primary)]">
    <div class="border-r border-[color:var(--ss-color-text-primary)] px-[22px] py-4">
      <div class="mb-3 flex items-baseline justify-between">
        <span class={SEC}>One-time</span>
        <a href="/admin/billing" class={CARD_LINK}>View billing →</a>
      </div>
      <div class="flex gap-8">
        <div>
          <span class={`${LAB} mb-1 block`}>Invoiced</span>
          <span class="font-mono text-xl font-bold">{formatMoney(totals.invoiced)}</span>
        </div>
        <div>
          <span class={`${LAB} mb-1 block`}>Paid</span>
          <span class="font-mono text-xl font-bold">{formatMoney(totals.paid)}</span>
        </div>
        <div>
          <span class={`${LAB} mb-1 block`}>Outstanding</span>
          <span
            class:list={[
              'font-mono text-xl font-bold',
              totals.outstanding > 0
                ? 'text-[color:var(--ss-color-primary)]'
                : 'text-[color:var(--ss-color-text-muted)]',
            ]}>{formatMoney(totals.outstanding)}</span
          >
        </div>
      </div>
    </div>
    <div class="px-[22px] py-4">
      <div class="mb-3 flex items-baseline justify-between">
        <span class={SEC}>Recurring</span>
        <a href="/admin/billing" class={CARD_LINK}>View billing →</a>
      </div>
      <div class="flex gap-8">
        <div>
          <span class={`${LAB} mb-1 block`}>Active operators</span>
          <span class="font-mono text-xl font-bold">{recurring.activeCount}</span>
        </div>
        <div>
          <span class={`${LAB} mb-1 block`}>MRR</span>
          <span class="font-mono text-xl font-bold">{formatMoney(recurring.mrr)}</span>
          {
            recurring.unpricedCount > 0 && (
              <div class="mt-1 text-[11px] text-[color:var(--ss-color-primary)]">
                {recurring.unpricedCount} unpriced
              </div>
            )
          }
        </div>
      </div>
    </div>
  </div>

  <!-- three motion cards -->
  <div class="grid grid-cols-1 gap-[18px] md:grid-cols-3">
    {
      motion.map((card) => (
        <div class="border border-[color:var(--ss-color-border)] px-[18px] py-4">
          <div class="mb-3 flex items-baseline justify-between border-b border-[color:var(--ss-color-border)] pb-2.5">
            <span class="font-mono text-[12px] font-bold uppercase tracking-[0.14em] text-[color:var(--ss-color-text-primary)]">
              {card.label}
            </span>
            <a href={card.href} class={CARD_LINK}>
              {card.jump}
            </a>
          </div>
          {card.rows.map((r) => (
            <div class="flex items-baseline justify-between py-[5px] text-sm">
              <span class="text-[color:var(--ss-color-text-secondary)]">{r.k}</span>
              <span
                class:list={[
                  'font-mono font-medium',
                  r.tone === 'alert' && Number(r.n) > 0 && 'text-[color:var(--ss-color-error)]',
                  r.tone === 'good' && 'text-[color:var(--ss-color-complete)]',
                ]}
              >
                {r.n}
              </span>
            </div>
          ))}
        </div>
      ))
    }
  </div>
</AdminLayout>

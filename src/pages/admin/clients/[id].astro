---
/**
 * Client hub — the per-business account view (ADR 0046).
 *
 * The post-acceptance counterpart to the lead working view
 * (`entities/[id]`). Composes the client's services view-side from
 * existing tables: consulting engagements + an operator (customer_config)
 * if present, billing from invoices/quotes, activity from the timeline.
 * The `service` spine is deferred — this renders the unified view today.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro'
import AdminFlashNotice from '../../../components/admin/AdminFlashNotice.astro'
import EntityTimelineEntry from '../../../components/admin/EntityTimelineEntry.astro'
import ClientInvoiceRows from '../../../components/admin/ClientInvoiceRows.astro'
import IssueInvoiceForm from '../../../components/admin/IssueInvoiceForm.astro'
import OperatorAgreementDocs from '../../../components/admin/OperatorAgreementDocs.astro'
import OperatorPriceForm from '../../../components/admin/OperatorPriceForm.astro'
import { loadEntityDetailPage, formatDate } from '../../../lib/admin/entity-detail-page'
import { listFleetRoster, personaSummary, posturePill } from '../../../lib/admin/fleet-roster'
import {
  computeBillingRollup,
  engagementToServiceRow,
  formatMoney,
  serviceToneDotClass,
  clientStageBadge,
} from '../../../lib/admin/client-hub'
import { resolveClientHubNotices } from '../../../lib/admin/client-hub-notices'
import { ENTITY_VERTICALS } from '../../../lib/db/entities'
import { getOperatorServiceForEntity, operatorPaymentMethod } from '../../../lib/db/services'
import { getSubscriptionForBilling, parseCancelAt } from '../../../lib/db/subscriptions'
import { listOperatorAgreementDocumentsForEntity } from '../../../lib/db/operator-agreements'
import { statusBadgeClass } from '../../../lib/ui/status-badge'
import { env } from 'cloudflare:workers'

const session = Astro.locals.session!
const entityId = Astro.params.id!

const pageData = await loadEntityDetailPage({
  db: env.DB,
  orgId: session.orgId,
  entityId,
  url: Astro.url,
})
if (!pageData) return Astro.redirect('/admin/clients?error=not_found')

const { entity, engagements, quotes, invoices, contacts, deduplicatedTimeline } = pageData

const roster = await listFleetRoster(env.DB)
const operator = roster.find((r) => r.entity_id === entityId) ?? null
// Operator commercial record from the spine (ADR 0046) — its monthly price.
const operatorService = operator
  ? await getOperatorServiceForEntity(env.DB, session.orgId, entityId)
  : null
const operatorPrice = operatorService?.recurring_price ?? null
const operatorPaymentRail = operatorPaymentMethod(operatorService)
// Retainer billing state (#1679): the (entity,'operator') subscriptions row +
// its Stripe attachment. Billing controls render only when the row exists —
// provisioning owns access grants; billing never creates one.
const operatorSubscription = operator
  ? await getSubscriptionForBilling(env.DB, entityId, 'operator')
  : null
// Executed agreement documents (ss#2641): the signed paper the firm reads on
// its own Compliance page. Instance-scoped, so this needs the roster's slug.
const agreementDocs = operator
  ? await listOperatorAgreementDocumentsForEntity(env.DB, session.orgId, entityId)
  : []

const rollup = computeBillingRollup(invoices)
const serviceRows = engagements.map((eng) => engagementToServiceRow(eng, quotes))

// Vertical is no longer captured on new records (it is not a meaningful
// categorization today), so show it only when a record actually has one.
// area alone, or nothing, renders cleanly instead of a bare placeholder.
const verticalLabel = entity.vertical
  ? (ENTITY_VERTICALS.find((v) => v.value === entity.vertical)?.label ?? entity.vertical)
  : null
const subtitleParts = [verticalLabel, entity.area].filter(Boolean)
const badge = clientStageBadge(entity.stage)
const created = Astro.url.searchParams.get('created')
const primaryContact = contacts[0] ?? null

const { success: noticeSuccess, error: noticeError } = resolveClientHubNotices(
  Astro.url.searchParams
)
const hubUrl = `/admin/clients/${entityId}`

const earliestStart = engagements
  .map((e) => e.start_date)
  .filter((d): d is string => Boolean(d))
  .sort()[0]
const clientSince = formatDate(earliestStart ?? entity.created_at)

const overdueInvoices = invoices.filter((i) => i.status === 'overdue')
const sentInvoices = invoices.filter((i) => i.status === 'sent')

const SECTION_LABEL =
  'font-mono text-[12px] font-bold uppercase tracking-[0.16em] text-[color:var(--ss-color-text-primary)]'
const LINK_ACT =
  'font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-[color:var(--ss-color-primary)] underline underline-offset-4'
---

<AdminLayout
  title={`${entity.name} | Clients | SMD Services`}
  breadcrumbs={[{ label: 'Clients', href: '/admin/clients' }, { label: entity.name }]}
  maxWidth="max-w-6xl"
>
  {created && <AdminFlashNotice message={`${entity.name} added.`} />}
  {noticeSuccess && <AdminFlashNotice message={noticeSuccess} />}
  {noticeError && <AdminFlashNotice kind="error" message={noticeError} />}

  <a
    href="/admin/clients"
    class="mb-5 inline-flex items-center gap-1 text-sm text-[color:var(--ss-color-text-secondary)] transition-colors hover:text-[color:var(--ss-color-primary)]"
  >
    <span>‹ Clients</span>
  </a>

  <!-- identity -->
  <div class="flex items-start justify-between gap-6 pb-5">
    <div>
      <h1 class="text-3xl font-bold text-[color:var(--ss-color-text-primary)]">{entity.name}</h1>
      {
        subtitleParts.length > 0 && (
          <p class="mt-1 text-sm text-[color:var(--ss-color-text-secondary)]">
            {subtitleParts.join(' · ')}
          </p>
        )
      }
    </div>
    <div class="shrink-0 text-right text-sm leading-7 text-[color:var(--ss-color-text-secondary)]">
      <span
        class="inline-flex items-center gap-2 border border-[color:var(--ss-color-border)] px-2 py-1 font-mono text-[11px] font-bold uppercase tracking-[0.1em]"
      >
        <span
          class:list={[
            'h-[7px] w-[7px] rounded-full',
            entity.stage === 'lost'
              ? 'bg-[color:var(--ss-color-text-muted)]'
              : badge.signed
                ? 'bg-[color:var(--ss-color-complete)]'
                : 'bg-[color:var(--ss-color-primary)]',
          ]}></span>
        {badge.label}
      </span>
      {primaryContact && <div class="mt-2">Primary: {primaryContact.name}</div>}
      <div>
        {badge.signed ? `Client since ${clientSince}` : `Added ${formatDate(entity.created_at)}`}
      </div>
    </div>
  </div>

  <!-- at a glance -->
  <div class="mb-7 flex border border-[color:var(--ss-color-text-primary)]">
    <div class="flex-1 border-r border-[color:var(--ss-color-border)] px-[18px] py-[14px]">
      <span
        class="mb-[5px] block font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-[color:var(--ss-color-text-secondary)]"
        >Lifetime billed</span
      >
      <span class="font-mono text-lg font-bold">{formatMoney(rollup.invoiced)}</span>
    </div>
    <div class="flex-1 border-r border-[color:var(--ss-color-border)] px-[18px] py-[14px]">
      <span
        class="mb-[5px] block font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-[color:var(--ss-color-text-secondary)]"
        >Paid</span
      >
      <span class="font-mono text-lg font-bold">{formatMoney(rollup.paid)}</span>
    </div>
    <div class="flex-1 px-[18px] py-[14px]">
      <span
        class="mb-[5px] block font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-[color:var(--ss-color-text-secondary)]"
        >Outstanding</span
      >
      <span
        class:list={[
          'font-mono text-lg font-bold',
          rollup.outstanding > 0
            ? 'text-[color:var(--ss-color-primary)]'
            : 'text-[color:var(--ss-color-text-muted)]',
        ]}>{formatMoney(rollup.outstanding)}</span
      >
    </div>
  </div>

  <div class="lg:grid lg:grid-cols-[1fr_20rem] lg:gap-7 lg:items-start">
    <!-- main column -->
    <div class="min-w-0">
      <!-- services -->
      <section class="border-t border-[color:var(--ss-color-text-primary)] pt-4 pb-6">
        <h2 class={`${SECTION_LABEL} mb-4`}>Services</h2>

        {
          operator && (
            <div class="mb-3.5 border border-[color:var(--ss-color-border)] border-l-[3px] border-l-[color:var(--ss-color-primary)] px-[18px] py-4">
              <div class="mb-3 flex items-center justify-between">
                <span class="font-mono text-[11px] font-bold uppercase tracking-[0.14em] text-[color:var(--ss-color-primary)]">
                  Operator
                </span>
                <span class="inline-flex items-center gap-1.5 border border-[color:var(--ss-color-border)] px-2 py-1 font-mono text-[11px] font-bold uppercase tracking-[0.1em] text-[color:var(--ss-color-text-secondary)]">
                  {posturePill(operator.authority).label}
                </span>
              </div>
              <div class="text-base font-bold text-[color:var(--ss-color-text-primary)]">
                Operator
              </div>
              <div class="mt-2 text-sm text-[color:var(--ss-color-text-secondary)]">
                {personaSummary(operator.personas)}
                {operator.config_error && ' · config needs attention'}
              </div>
              <OperatorPriceForm
                entityId={entityId}
                operatorPrice={operatorPrice}
                operatorPaymentRail={operatorPaymentRail}
              />
              {operatorSubscription && (
                <div class="mt-3 border-t border-[color:var(--ss-color-border-subtle)] pt-3">
                  <div class="flex items-baseline justify-between">
                    <span class="font-mono text-[11px] font-bold uppercase tracking-[0.1em] text-[color:var(--ss-color-text-secondary)]">
                      Retainer billing
                    </span>
                    <span class="font-mono text-sm">
                      {operatorSubscription.stripe_subscription_id
                        ? `Stripe · ${operatorSubscription.status}`
                        : 'Not attached'}
                    </span>
                  </div>
                  {parseCancelAt(operatorSubscription.settings_json) && (
                    <p class="mt-2 text-sm font-bold text-[color:var(--ss-color-error)]">
                      Client cancelled from the portal. Service and billing run through{' '}
                      {parseCancelAt(operatorSubscription.settings_json)?.slice(0, 10)}. Offboarding
                      (Section 9.3) is a Captain act.
                    </p>
                  )}
                  {!operatorSubscription.stripe_subscription_id && operatorPrice != null && (
                    <p class="mt-2 text-sm text-[color:var(--ss-color-text-muted)]">
                      The client starts the subscription from their portal (Billing → Start
                      subscription) and pays the first month on Stripe. Nothing is billed or sent
                      until they do.
                    </p>
                  )}
                  {!operatorSubscription.stripe_subscription_id && operatorPrice == null && (
                    <p class="mt-2 text-sm text-[color:var(--ss-color-text-muted)]">
                      Author the monthly price above; the client cannot start without one.
                    </p>
                  )}
                  {operatorSubscription.stripe_subscription_id && (
                    <div class="mt-2.5 flex items-center gap-2">
                      {operatorSubscription.status === 'active' && (
                        <form
                          method="POST"
                          action={`/api/admin/clients/${entityId}/subscription-billing`}
                        >
                          <input type="hidden" name="action" value="pause" />
                          <button
                            type="submit"
                            class="border border-[color:var(--ss-color-border)] px-3 py-1 font-mono text-[11px] font-bold uppercase tracking-[0.1em] text-[color:var(--ss-color-text-secondary)]"
                          >
                            Pause billing
                          </button>
                        </form>
                      )}
                      {operatorSubscription.status === 'paused' && (
                        <form
                          method="POST"
                          action={`/api/admin/clients/${entityId}/subscription-billing`}
                        >
                          <input type="hidden" name="action" value="resume" />
                          <button
                            type="submit"
                            class="border border-[color:var(--ss-color-primary)] px-3 py-1 font-mono text-[11px] font-bold uppercase tracking-[0.1em] text-[color:var(--ss-color-primary)]"
                          >
                            Resume billing
                          </button>
                        </form>
                      )}
                      {operatorSubscription.status !== 'cancelled' && (
                        <form
                          method="POST"
                          action={`/api/admin/clients/${entityId}/subscription-billing`}
                        >
                          <input type="hidden" name="action" value="cancel" />
                          <button
                            type="submit"
                            class="border border-[color:var(--ss-color-error)] px-3 py-1 font-mono text-[11px] font-bold uppercase tracking-[0.1em] text-[color:var(--ss-color-error)]"
                          >
                            Cancel
                          </button>
                        </form>
                      )}
                    </div>
                  )}
                </div>
              )}
              <OperatorAgreementDocs
                entityId={entityId}
                instanceSlug={operator.customer_slug}
                documents={agreementDocs}
              />
              <div class="mt-3 flex items-center justify-end border-t border-[color:var(--ss-color-border-subtle)] pt-3">
                <a href="/admin/operator" class={LINK_ACT}>
                  Open cockpit →
                </a>
              </div>
            </div>
          )
        }

        {
          serviceRows.map((svc) => (
            <div class="mb-3.5 border border-[color:var(--ss-color-border)] border-l-[3px] border-l-[color:var(--ss-color-text-primary)] px-[18px] py-4">
              <div class="mb-3 flex items-center justify-between">
                <span class="font-mono text-[11px] font-bold uppercase tracking-[0.14em] text-[color:var(--ss-color-text-primary)]">
                  Consulting
                </span>
                <span class="inline-flex items-center gap-1.5 border border-[color:var(--ss-color-border)] px-2 py-1 font-mono text-[11px] font-bold uppercase tracking-[0.1em] text-[color:var(--ss-color-text-secondary)]">
                  <span
                    class:list={['h-[7px] w-[7px] rounded-full', serviceToneDotClass(svc.tone)]}
                  />
                  {svc.statusLabel}
                </span>
              </div>
              <div class="flex items-baseline justify-between gap-4">
                <span class="text-base font-bold text-[color:var(--ss-color-text-primary)]">
                  {svc.title}
                </span>
                {svc.value && (
                  <span class="font-mono text-base font-bold whitespace-nowrap">{svc.value}</span>
                )}
              </div>
              {svc.keyDateIso && (
                <div class="mt-3 border-t border-[color:var(--ss-color-border-subtle)] pt-3 text-xs text-[color:var(--ss-color-text-muted)]">
                  {svc.keyDateKind} {formatDate(svc.keyDateIso)}
                </div>
              )}
            </div>
          ))
        }

        {
          !operator && serviceRows.length === 0 && (
            <p class="text-[15px] italic leading-6 text-[color:var(--ss-color-text-secondary)]">
              No services yet.
            </p>
          )
        }

        <form method="POST" action={`/api/admin/entities/${entity.id}/quotes`}>
          <button
            type="submit"
            class="mt-3.5 block w-full border border-dashed border-[color:var(--ss-color-border)] px-3.5 py-2.5 text-center font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-[color:var(--ss-color-primary)]"
            >+ New quote</button
          >
        </form>
      </section>

      <!-- billing -->
      <section class="border-t border-[color:var(--ss-color-text-primary)] pt-4 pb-6">
        <div class="mb-4 flex items-baseline justify-between">
          <h2 class={SECTION_LABEL}>Billing</h2>
          <a href="/admin/billing" class={LINK_ACT}>View all billing →</a>
        </div>
        {
          quotes.length === 0 && invoices.length === 0 ? (
            <p class="text-[15px] italic leading-6 text-[color:var(--ss-color-text-secondary)]">
              No billing yet.
            </p>
          ) : (
            <div class="space-y-2.5 text-sm">
              {quotes.length > 0 && (
                <div class="flex gap-3">
                  <span class="w-20 shrink-0 font-mono text-[11px] font-bold uppercase tracking-[0.1em] text-[color:var(--ss-color-text-secondary)]">
                    Quotes
                  </span>
                  <span class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
                    {quotes.map((q) => (
                      <span class="inline-flex items-center gap-1.5">
                        <span class={statusBadgeClass(q.status)}>{q.status}</span>
                        {formatMoney(q.total_price)}
                      </span>
                    ))}
                  </span>
                </div>
              )}
              {invoices.length > 0 && <ClientInvoiceRows invoices={invoices} hubUrl={hubUrl} />}
            </div>
          )
        }

        <IssueInvoiceForm entityId={entityId} hubUrl={hubUrl} />
      </section>

      <!-- activity -->
      <section class="border-t border-[color:var(--ss-color-text-primary)] pt-4 pb-6">
        <div class="mb-4 flex items-baseline justify-between">
          <h2 class={SECTION_LABEL}>Activity</h2>
          <span class="font-mono text-[12px] text-[color:var(--ss-color-text-muted)]">
            {deduplicatedTimeline.length}
            {deduplicatedTimeline.length === 1 ? 'event' : 'events'}
          </span>
        </div>
        {
          deduplicatedTimeline.length === 0 ? (
            <p class="text-[15px] italic leading-6 text-[color:var(--ss-color-text-secondary)]">
              No activity yet.
            </p>
          ) : (
            <ul class="list-none">
              {deduplicatedTimeline.slice(0, 8).map((entry, idx) => (
                <EntityTimelineEntry entry={entry} openByDefault={idx < 3} />
              ))}
            </ul>
          )
        }
      </section>
    </div>

    <!-- right rail -->
    <div class="mt-8 lg:mt-0">
      <div class="mb-4 border border-[color:var(--ss-color-border)] p-4">
        <span class={`${SECTION_LABEL} mb-3 block`}>Open items</span>
        {
          overdueInvoices.length === 0 && sentInvoices.length === 0 ? (
            <p class="text-sm text-[color:var(--ss-color-text-muted)]">Nothing outstanding.</p>
          ) : (
            <ul class="list-none text-sm">
              {overdueInvoices.map((inv) => (
                <li class="flex items-center gap-2 border-t border-[color:var(--ss-color-border-subtle)] py-1.5 first:border-t-0 first:pt-0 text-[color:var(--ss-color-text-secondary)]">
                  <span class="h-2 w-2 rounded-full bg-[color:var(--ss-color-error)]" />
                  Invoice overdue · {formatMoney(inv.amount)}
                </li>
              ))}
              {sentInvoices.map((inv) => (
                <li class="flex items-center gap-2 border-t border-[color:var(--ss-color-border-subtle)] py-1.5 first:border-t-0 first:pt-0 text-[color:var(--ss-color-text-secondary)]">
                  <span class="h-2 w-2 rounded-full bg-[color:var(--ss-color-primary)]" />
                  Invoice sent · {formatMoney(inv.amount)}
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div class="border border-[color:var(--ss-color-border)] p-4">
        <span class={`${SECTION_LABEL} mb-3 block`}>Contacts</span>
        {
          contacts.length === 0 ? (
            <p class="text-sm text-[color:var(--ss-color-text-muted)]">No contacts yet.</p>
          ) : (
            <ul class="list-none space-y-2 text-sm">
              {contacts.map((c) => (
                <li>
                  <span class="font-semibold text-[color:var(--ss-color-text-primary)]">
                    {c.name}
                  </span>
                  {c.title && (
                    <span class="text-[color:var(--ss-color-text-secondary)]"> · {c.title}</span>
                  )}
                  {c.email && (
                    <div class="font-mono text-xs text-[color:var(--ss-color-text-muted)]">
                      {c.email}
                    </div>
                  )}
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </div>

  <!-- background (collapsed) -->
  <details class="mt-9 border border-[color:var(--ss-color-border)]">
    <summary class="flex cursor-pointer items-baseline justify-between px-[18px] py-3.5">
      <span class={SECTION_LABEL}>Background</span>
      <span class="text-xs text-[color:var(--ss-color-text-muted)]"
        >What we know about this business</span
      >
    </summary>
    <div class="border-t border-[color:var(--ss-color-border)] px-[18px] py-3.5 text-sm">
      <div class="flex gap-4 py-1.5">
        <span
          class="w-24 shrink-0 font-mono text-[11px] font-bold uppercase tracking-[0.1em] text-[color:var(--ss-color-text-secondary)]"
          >Origin</span
        >
        <span>{entity.source_pipeline ?? 'unknown source'} · {formatDate(entity.created_at)}</span>
      </div>
      <div class="flex gap-4 py-1.5">
        <span
          class="w-24 shrink-0 font-mono text-[11px] font-bold uppercase tracking-[0.1em] text-[color:var(--ss-color-text-secondary)]"
          >Full record</span
        >
        <a href={`/admin/entities/${entity.id}`} class={LINK_ACT}>
          Enrichment, signals & pain observations →
        </a>
      </div>
    </div>
  </details>
</AdminLayout>

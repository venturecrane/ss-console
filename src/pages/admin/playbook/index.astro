---
/**
 * Venture Handbook (the Playbook) — landing.
 *
 * The franchise operations manual (E-Myth): how to run, build, and grow SMD
 * Services from zero context. This index renders the full table of contents
 * grouped by section; each page is a markdown file under docs/handbook/,
 * rendered by [...slug].astro. Source of truth is the markdown, kept current
 * as a byproduct of building the venture (see docs/handbook/README.md).
 *
 * Admin-only; the explicit guard matches every other admin page.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro'
import HandbookSidebar from './_HandbookSidebar.astro'
import { getCollection } from 'astro:content'
import { HANDBOOK_SECTIONS } from '../../../lib/handbook/sections'

const session = Astro.locals.session!
if (session.role !== 'admin') {
  return Astro.redirect('/auth/sign-in')
}

const entries = await getCollection('handbook')
// The first page of the reading path. Start Here once it exists; until then the
// Overview, so the landing page never links to a page that is not there.
const startPage =
  entries.find((e) => e.id === 'start-here') ?? entries.find((e) => e.id === 'overview')
const grouped = HANDBOOK_SECTIONS.map((s) => ({
  ...s,
  items: entries
    .filter((e) => e.data.section === s.key)
    .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999)),
})).filter((g) => g.items.length > 0)

const pageCount = entries.length

const SEC =
  'font-mono text-[12px] font-bold uppercase tracking-[0.16em] text-[color:var(--ss-color-text-primary)]'
const BODY = 'text-sm leading-relaxed text-[color:var(--ss-color-text-secondary)]'
---

<AdminLayout title="Playbook | SMD Services" maxWidth="max-w-6xl">
  <div class="grid grid-cols-1 gap-8 md:grid-cols-[220px_1fr]">
    <aside
      class="md:sticky md:top-20 md:self-start md:max-h-[calc(100vh-6rem)] md:overflow-y-auto md:overscroll-contain md:pr-2"
    >
      <HandbookSidebar />
    </aside>

    <div class="min-w-0">
      <header class="mb-7 border-b border-[color:var(--ss-color-border)] pb-5">
        <h1 class="text-3xl font-bold text-[color:var(--ss-color-text-primary)]">Playbook</h1>
        <p class={`mt-2 max-w-2xl text-base leading-relaxed ${BODY}`}>
          The venture handbook. Written for an administrator who runs SMD Services day to day and
          directs AI agents and contractors for the technical work: what arrives, what we owe, who
          decides, and what the business is. The Engineering Appendix explains how it is built and
          is reached by link.
        </p>
      </header>

      {
        startPage && (
          <a
            href={`/admin/playbook/${startPage.id}`}
            class="mb-7 block border-2 border-[color:var(--ss-color-primary)] px-[18px] py-4 hover:bg-[color:var(--ss-color-border-subtle)]"
          >
            <span class="font-mono text-[12px] font-bold uppercase tracking-[0.16em] text-[color:var(--ss-color-primary)]">
              Start here
            </span>
            <span class="mt-1 block text-base font-bold text-[color:var(--ss-color-text-primary)]">
              {startPage.data.title}
            </span>
            {startPage.data.summary && (
              <span class={`mt-1 block ${BODY}`}>{startPage.data.summary}</span>
            )}
          </a>
        )
      }

      <div class="space-y-7">
        {
          grouped.map((g) => (
            <section class="border border-[color:var(--ss-color-text-primary)]">
              <div class="flex items-baseline justify-between border-b border-[color:var(--ss-color-text-primary)] px-[18px] py-3">
                <span class={SEC}>
                  {g.label}
                  <span class="ml-2 font-normal normal-case tracking-normal text-[color:var(--ss-color-text-muted)]">
                    {g.audience === 'admin' ? 'for the administrator' : 'for engineers'}
                  </span>
                </span>
                <span class="text-[11px] text-[color:var(--ss-color-text-muted)]">{g.blurb}</span>
              </div>
              <ul>
                {g.items.map((it, i) => (
                  <li
                    class:list={[i > 0 && 'border-t border-[color:var(--ss-color-border-subtle)]']}
                  >
                    <a
                      href={`/admin/playbook/${it.id}`}
                      class="grid grid-cols-1 gap-1 px-[18px] py-3 hover:bg-[color:var(--ss-color-border-subtle)] sm:grid-cols-[200px_1fr] sm:gap-4"
                    >
                      <span class="text-sm font-bold text-[color:var(--ss-color-text-primary)]">
                        {it.data.title}
                      </span>
                      <span class={BODY}>{it.data.summary ?? ''}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      {
        pageCount === 0 && (
          <p class={BODY}>
            No handbook pages found. Add markdown under{' '}
            <code class="font-mono text-[color:var(--ss-color-text-primary)]">docs/handbook/</code>.
          </p>
        )
      }
    </div>
  </div>
</AdminLayout>

---
export const prerender = false

import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import IntakeIntroCard from '../components/booking/IntakeIntroCard.astro'
import IntakeSlots from '../components/booking/IntakeSlots.astro'
import IntakeClosed from '../components/booking/IntakeClosed.astro'
import { getEntity } from '../lib/db/entities'
import { getContact } from '../lib/db/contacts'
import { verifyBookingLink } from '../lib/booking/signed-link'
import { ALLOWED_INTERESTS } from '../lib/booking/config'
import { ORG_ID } from '../lib/constants'
import { env } from 'cloudflare:workers'

// Prefill support for admin-issued links (#467). When `?t=<token>` is present
// and verifies, we prefill the business name (and email if we have the
// contact). The token itself is re-submitted with the reserve request so the
// server can anchor the booking to the admin-chosen entity/assessment rather
// than running slug dedup.
const prefillToken = Astro.url.searchParams.get('t')
let prefillBusinessName: string | null = null
let prefillEmail: string | null = null
let prefillContactName: string | null = null
let prefillTokenValid = false
let prefillTokenError: 'expired' | 'invalid' | null = null

// Productized SKU interest carried from a marketing CTA (e.g.
// /operator → /book?interest=operator). The shared allow-list lives in
// lib/booking/config; the same list is enforced again at the API
// boundary in /api/intake/send.ts.
const interestParam = Astro.url.searchParams.get('interest')
const interest = interestParam && ALLOWED_INTERESTS.has(interestParam) ? interestParam : undefined

if (prefillToken) {
  const verify = await verifyBookingLink(prefillToken)
  if (!verify.ok) {
    prefillTokenError = verify.error === 'expired' ? 'expired' : 'invalid'
  } else {
    prefillTokenValid = true
    try {
      const entity = await getEntity(env.DB, ORG_ID, verify.payload.entity_id)
      if (entity) prefillBusinessName = entity.name
    } catch (err) {
      console.error('[book.astro] entity prefill lookup failed:', err)
    }
    if (verify.payload.contact_id) {
      const contact = await getContact(env.DB, ORG_ID, verify.payload.contact_id).catch((err) => {
        console.error('[book.astro] contact prefill lookup failed:', err)
        return null
      })
      if (contact) {
        prefillEmail = contact.email
        prefillContactName = contact.name
      }
    }
  }
}
---

<Base
  title="Start With An Assessment | SMD Services"
  description="It starts with an assessment. We learn how your business runs, find what is costing you the most time, and recommend the right solution. If an Operator is not the fit, we say so. Based in Phoenix."
>
  <Nav />
  <main id="main" role="main" class="ss-book-main">
    <section class="ss-book-section">
      <div class="ss-book-frame">
        {
          prefillTokenError && (
            <div class="ss-banner ss-banner-warn" role="status">
              {prefillTokenError === 'expired'
                ? 'This booking link has expired. You can still pick a time below.'
                : 'This booking link is not valid. You can still pick a time below.'}
            </div>
          )
        }

        <!--
          Single root #unified-intake — the event hub. Three state sections
          (intro form → slot picker → closed) live inside. The page
          controller (src/scripts/book.ts) toggles data-state and visibility
          as the prospect moves through the flow.
        -->
        <div id="unified-intake" data-state="intro">
          <IntakeIntroCard
            values={{
              name: prefillContactName ?? undefined,
              email: prefillEmail ?? undefined,
              businessName: prefillBusinessName ?? undefined,
              interest,
            }}
          />

          <IntakeSlots />

          <IntakeClosed />
        </div>

        {
          prefillTokenValid && prefillToken && (
            <input id="prefill-token-store" type="hidden" value={prefillToken} />
          )
        }
      </div>
    </section>
  </main>
  <Footer />

  <script>
    import '../scripts/book.ts'
    import '../scripts/unified-intake.ts'
  </script>
</Base>

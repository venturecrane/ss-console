---
import { GOOGLE_FONTS_URL } from '../lib/fonts'
import '../styles/global.css'
import JsonLd from '../components/JsonLd.astro'
import SkipToMain from '../components/SkipToMain.astro'
import EventsTracker from '../components/EventsTracker.astro'
import Analytics from '../components/Analytics.astro'
import MetaPixel from '../components/MetaPixel.astro'

interface Props {
  title: string
  description?: string
  // Set on routes that must not leak the URL to GA4 (token-bearing paths,
  // unmatched 404s where pathname can echo a token from a bad URL).
  disableAnalytics?: boolean
}

const {
  title,
  description = 'SMD Services builds and runs the Operator, a new kind of worker that fills the gap between your people and your software, as a managed service for growing businesses.',
  disableAnalytics = false,
} = Astro.props

const canonicalUrl = new URL(Astro.url.pathname, 'https://smd.services')
const ogImageUrl = new URL('/og-image.png', 'https://smd.services')
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link href={GOOGLE_FONTS_URL} rel="stylesheet" />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
      rel="stylesheet"
    />
    <link rel="canonical" href={canonicalUrl.href} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={ogImageUrl.href} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.href} />

    <title>{title}</title>
    <JsonLd />
    {!disableAnalytics && <Analytics />}
    {!disableAnalytics && <MetaPixel />}
  </head>
  <body>
    <SkipToMain />
    <slot />
    {
      /* Respects disableAnalytics for the same reason Analytics and MetaPixel do
        above. It did not, and that was the whole defect: /book/manage/[token]
        already passed disableAnalytics, but this tracker ignored it and posted
        location.pathname — which on that route CONTAINS the manage token, and
        that token IS the auth (no session required). The path landed in the
        events table, contradicting tokens.ts, which states the raw token is
        never written to the DB or logged. */
    }
    {!disableAnalytics && <EventsTracker />}
  </body>
</html>

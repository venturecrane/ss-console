#!/bin/bash
#
# memory-trigger-test -- run a memory's triggers over every past transcript
# before they go live, and run its own self-check.
#
#   .claude/bin/memory-trigger-test feedback_x.md                    # last 60 days
#   .claude/bin/memory-trigger-test feedback_x.md --since 2026-09-01 --show 30
#
# Exit 1 when the memory's self-check fails (an example that does not fire, a
# counter that does, a refused trigger, or no example at all). The logic lives
# in the .mjs; this only marshals arguments.
set -u
DIR=$(cd "$(dirname "$0")/.." && pwd)   # .claude/
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "memory-trigger-test: not in a git tree" >&2; exit 1; }
HOOK="$DIR/hooks/memory-trigger-test.mjs"
[ -f "$HOOK" ] || HOOK="$ROOT/.claude/hooks/memory-trigger-test.mjs"

node "$HOOK" "$@"

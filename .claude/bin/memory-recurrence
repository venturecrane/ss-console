#!/bin/bash
#
# memory-recurrence -- is a saved lesson still being stumbled into, and is the
# Captain still having to correct it?
#
#   .claude/bin/memory-recurrence                    # each memory since its trigger_since
#   .claude/bin/memory-recurrence --since 2026-09-23 # one floor for every memory
#   .claude/bin/memory-recurrence --json
#   .claude/bin/memory-recurrence --self-test        # prove the counter can fail
#
# Exit 0 when no triggered memory's sentence escaped the hooks and the Captain
# did not re-correct one; 1 otherwise (or when nothing can be read). The logic
# and the definitions live in the .mjs; this only marshals arguments.
set -u
DIR=$(cd "$(dirname "$0")/.." && pwd)   # .claude/
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "memory-recurrence: not in a git tree" >&2; exit 1; }
HOOK="$DIR/hooks/memory-recurrence.mjs"
[ -f "$HOOK" ] || HOOK="$ROOT/.claude/hooks/memory-recurrence.mjs"

node "$HOOK" "$@"

{
  "name": "smd-services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:staging": "CLOUDFLARE_ENV=staging astro build",
    "deploy:staging": "npm run build:staging && wrangler deploy",
    "preview": "wrangler dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 13",
    "lint:fix": "eslint --fix .",
    "deadcode": "knip --production",
    "typecheck": "astro check",
    "typecheck:workers": "for dir in workers/*/; do [ -f \"${dir}package.json\" ] || continue; echo \"Typechecking $dir\" && npm run typecheck --prefix \"$dir\" || exit 1; done",
    "test:workers": "for dir in workers/*/; do [ -f \"${dir}package.json\" ] || continue; echo \"Testing $dir\" && npm run test --prefix \"$dir\" || exit 1; done",
    "verify": "npm run typecheck && npm run typecheck:workers && npm run format:check && npm run lint && npm run deadcode && npm run build && npm run test && npm run test:workers",
    "handbook:drift": "node scripts/handbook-drift.mjs",
    "db:migrate:local": "wrangler d1 migrations apply ss-console-db --local",
    "prepare": "node -e \"if(process.env.CI)process.exit(0)\" && husky"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.6",
    "@astrojs/sitemap": "^3.7.4",
    "@clerk/astro": "^4.1.0",
    "@elevenlabs/client": "^1.23.0",
    "@formepdf/core": "^0.16.0",
    "@formepdf/react": "^0.16.0",
    "@sentry/cloudflare": "^10.73.0",
    "@venturecrane/tokens": "0.0.2-alpha.0",
    "astro": "^7.1.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "ics": "^3.12.0",
    "jose": "^6.2.10",
    "react": "^19.2.8",
    "wrangler": "^4.128.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@venturecrane/crane-test-harness": "^0.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^2.1.1",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.12.0",
    "husky": "^9.1.0",
    "knip": "6.34.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "@cloudflare/workers-types": "$@cloudflare/workers-types",
    "@cloudflare/vite-plugin": "1.47.0",
    "fast-uri": "3.1.6",
    "svgo": "4.0.2",
    "defu": "^6.1.7",
    "undici": "^7.29.0",
    "js-cookie": "^3.0.7",
    "esbuild": "0.28.1",
    "ws": "8.21.0",
    "yaml": "$yaml",
    "brace-expansion": "^5.0.9",
    "js-yaml": "^4.3.1",
    "postcss": "8.5.23",
    "nanoid@^3": "^3.3.18",
    "nanoid@^5": "^5.1.16"
  }
}
